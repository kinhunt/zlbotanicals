          {
            "index": 0,
            "label": "厂家强调的区别",
            "value": "高分散性菊粉，标注为instant。 [1]"
          },
          {
            "index": 1,
            "label": "应用评估重点",
            "value": "重点说明投粉与混合顺序；“速分散”不等于成品饮料必然清澈。"
          },
          {
            "index": 2,
            "label": "厂家强调的区别",
            "value": "高溶解性菊粉。 [1]"
          },
          {
            "index": 3,
            "label": "应用评估重点",
            "value": "写明实际浓度、配制温度和储存状态，而非只问“能不能溶于水”。"
          },
          {
            "index": 4,
            "label": "厂家强调的区别",
            "value": "同属用于脂肪替代的长链菊粉，分别面向较低与较高加工温度。 [1]"
          },
          {
            "index": 5,
            "label": "应用评估重点",
            "value": "先交代热加工路线，再讨论看似相近的长链牌号。"
          },
          {
            "index": 6,
            "label": "厂家强调的区别",
            "value": "较长链、具有质地构建作用的菊苣纤维，强调高水分体系中的类脂肪口感。 [7]"
          },
          {
            "index": 7,
            "label": "应用评估重点",
            "value": "评估实际甜品或涂抹食品的质地，而不只做清水杯中的溶解观察。"
          },
          {
            "index": 8,
            "label": "厂家强调的区别",
            "value": "液体低聚果糖，强调黏结作用及低水分体系应用。 [7]"
          },
          {
            "index": 9,
            "label": "应用评估重点",
            "value": "将液体原料带入的水分与固形物一起计入配方；不能按相同重量直接替换粉体。"
          }
        ]
