---
import {createMarkdownProcessor} from '@astrojs/markdown-remark';
import en from '../../docs/evidence/quillaja/quillaja-selection.en.md?raw';
import chinese from '../../docs/evidence/quillaja/quillaja-selection.zh.md?raw';
const {lang} = Astro.props as {lang:'en'|'zh'};
const zh=lang==='zh';
const [body,sources]=(zh?chinese:en).trim().split('\n## Sources\n');
const [title,...lines]=body.split('\n');
const processor=await createMarkdownProcessor({smartypants:false});
const markdown=lines.join('\n').replace(/^## /gm,'### ').replace(/\[([12])\]/g,'<a href="#quillaja-ref-$1">[$1]</a>');
let html=(await processor.render(markdown)).code;
// Keep the comparison as a table on desktop and labelled row records on mobile.
// Labels come from the approved table headings, not a second editorial source.
const labels=[...html.matchAll(/<th>(.*?)<\/th>/g)].map(match=>match[1]);
let cell=0;
html=html.replace(/<td>/g,()=>`<td role="cell" data-label="${labels[cell++%labels.length]}">`)
 .replace('<table>','<table role="table">').replaceAll('<tr>','<tr role="row">')
 .replaceAll('<th>','<th role="columnheader" scope="col">');
const references=sources.trim().split('\n').map(line=>{
 const [,id,url,label]=line.match(/^\[(\d+)\] (\S+) — (.+)$/)!;
 return {id,url,label};
});
const href=`${zh?'/zh':''}/request-quote?request=application&source=beverages&application=${encodeURIComponent(zh?'皂树提取物饮料寻源项目':'Quillaja beverage sourcing project')}`;
---
<section id="quillaja-grade-selection" class="section-padding quillaja" aria-labelledby="quillaja-title">
 <div class="container-wide quillaja-reader">
  <h2 id="quillaja-title">{title.replace(/^# /,'')}</h2>
  <div class="quillaja-body"><Fragment set:html={html}/></div>
  <a class="quillaja-cta" href={href}>{zh?'咨询皂树提取物寻源项目':'Discuss a quillaja sourcing project'} →</a>
  <aside class="quillaja-references" aria-labelledby="quillaja-sources-title">
   <h3 id="quillaja-sources-title">{zh?'来源':'Sources'}</h3>
   <ul>{references.map(ref=><li id={`quillaja-ref-${ref.id}`}><span>[{ref.id}] </span><a href={ref.url}>{ref.label}</a></li>)}</ul>
  </aside>
 </div>
</section>
<style>
 .quillaja{background:#fafbf8;border-block:1px solid #e1e7db;scroll-margin-top:7rem}
 .quillaja-reader{max-width:868px}
 h2{font-size:clamp(1.6rem,3vw,2rem);font-weight:700;line-height:1.3;color:#243c2b}
 .quillaja-body :global(p){margin:1.2rem 0;line-height:1.8;color:#374151}
 .quillaja-body :global(h3){font-size:1.3rem;font-weight:650;line-height:1.4;margin:2rem 0 1rem;color:#243c2b}
 .quillaja :global(a){color:#365b36;text-decoration:underline;text-underline-offset:3px}
 .quillaja-body :global(table){width:100%;table-layout:fixed;border-collapse:collapse;margin:1.5rem 0;font-size:.95rem;line-height:1.65}
 .quillaja-body :global(th),.quillaja-body :global(td){padding:1rem;vertical-align:top;text-align:left;border:1px solid #d7e0cf;overflow-wrap:anywhere}
 .quillaja-body :global(th){background:#eaf0e4;font-weight:650}
 .quillaja-body :global(th:first-child){width:23%}
 .quillaja-body :global(td:first-child){font-weight:650}
 .quillaja-cta{display:inline-block;font-weight:650;margin:1rem 0}
 .quillaja-references{border-top:1px solid #d7e0cf;padding-top:1.5rem;margin-top:1.5rem;font-size:.9rem;line-height:1.65}
 .quillaja-references h3{font-size:1.1rem;font-weight:650}
 .quillaja-references li{margin-top:.7rem;overflow-wrap:anywhere;scroll-margin-top:7rem}
 @media(max-width:639px){
  .quillaja-body :global(table),.quillaja-body :global(tbody),.quillaja-body :global(tr),.quillaja-body :global(td){display:block;width:100%}
  .quillaja-body :global(thead){position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .quillaja-body :global(tbody tr){border:1px solid #d7e0cf;border-radius:.5rem;margin:1rem 0;overflow:hidden;background:white}
  .quillaja-body :global(td){border:0;border-top:1px solid #e3e9dd;padding:.8rem 1rem;font-weight:400}
  .quillaja-body :global(td:first-child){border:0;background:#eaf0e4;font-weight:650}
  .quillaja-body :global(td::before){content:attr(data-label);display:block;font-size:.8rem;color:#52614a;font-weight:650;margin-bottom:.3rem}
 }
</style>
