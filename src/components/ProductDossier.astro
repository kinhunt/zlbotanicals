---
import profiles from '../data/science-profiles.json';
import concepts from '../data/odm.json';
import dossiers from '../data/product-dossiers.json';
import ResearchCards from './ResearchCards.astro';
import NewsCards from './NewsCards.astro';
import { getLocalizedPath, type Language } from '../i18n/config';
interface Props {lang:Language; slug:string}
const {lang,slug}=Astro.props;
const d=dossiers.find(d=>d.slug===slug);
const zh=lang==='zh';
const local=(p:string)=>getLocalizedPath(p,lang);
const industries={beverages:{en:'Beverage development',zh:'饮料开发'},food:{en:'Food applications',zh:'食品应用'},nutraceuticals:{en:'Supplement evaluation',zh:'营养补充剂评估'},cosmetics:{en:'Cosmetic development',zh:'化妆品开发'}};
---
{d && <section id="processing-dossier" class="mt-12 border-t pt-10">
 <p class="text-primary text-sm tracking-widest">{zh?'从原料名称走向可审查规格':'FROM INGREDIENT NAME TO REVIEWABLE SPECIFICATION'}</p>
 <h2 class="text-2xl font-bold mt-2">{d.heading[lang]}</h2>
 <div class="grid md:grid-cols-2 gap-6 mt-6">
  <div class="rounded-xl bg-primary/5 p-6"><h3 class="font-semibold text-lg">{zh?'工艺与成分核查':'Process & composition questions'}</h3><p class="mt-3 leading-relaxed text-gray-700">{d.process[lang]}</p><p class="text-sm mt-3 text-gray-600">{zh?'此处为供应商核查问题，不描述已核实的自有生产线或实际放行规格。':'These are supplier-review questions, not verified descriptions of an owned production line or released specification.'}</p></div>
  <div class="rounded-xl bg-gray-50 p-6"><h3 class="font-semibold text-lg">{zh?'应用与试验决策':'Application & trial decisions'}</h3><p class="mt-3 leading-relaxed text-gray-700">{d.application[lang]}</p></div>
 </div>
 <nav aria-label={zh?'相关技术与应用':'Related technical and application reading'} class="flex flex-wrap gap-3 mt-6 text-sm">
  {profiles.some(p=>p.id===slug)&&<a class="border rounded-lg p-3 text-primary underline" href={local(`/plant-extracts/ingredients/${slug}`)}>{zh?'原料科学档案：身份与证据边界':'Ingredient science: identity & evidence boundaries'}</a>}
  <a class="border rounded-lg p-3 text-primary underline" href={local(`/plant-extracts/${d.topic}`)}>{zh?'对应技术知识':'Topic-specific technical guide'}</a>
  <a class="border rounded-lg p-3 text-primary underline" href={local('/plant-extracts/standards/coa-vs-specification')}>{zh?'规格与批次 COA':'Specification vs batch COA'}</a>
  <a class="border rounded-lg p-3 text-primary underline" href={local(`/solutions/${d.industry}`)}>{industries[d.industry][lang]}</a>
  <a class="border rounded-lg p-3 text-primary underline" href={local('/odm')}>{zh?'ODM 项目路径':'ODM project pathway'}</a>
 </nav>
 {concepts.some(c=>c.products.includes(slug)) && <section class="mt-8"><h3 class="font-semibold text-lg">{zh?'相关 ODM 概念 · 尚未验证':'Related ODM concepts · not validated'}</h3><div class="flex flex-wrap gap-3 mt-3">{concepts.filter(c=>c.products.includes(slug)).map(c=><a class="p-3 border rounded-lg underline text-primary" href={local(`/odm/${c.slug}`)}>{c.title[lang]}</a>)}</div></section>}
 <ResearchCards lang={lang} products={[slug]} />
 <NewsCards lang={lang} products={[slug]} />
</section>}
