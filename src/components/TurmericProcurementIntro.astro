---
import {getLocalizedPath, type Language} from '../i18n/config';
const {lang}=Astro.props as {lang:Language};
const zh=lang==='zh';
const name=zh?'姜黄提取物':'Turmeric Extract';
const quote=(request:string)=>getLocalizedPath('/request-quote',lang)+'?'+new URLSearchParams({product:name,request}).toString();
const sections=[['material-selection',zh?'原料选型':'Material selection'],['specifications',zh?'规格比较':'Specifications'],['cost-comparison',zh?'配方成本':'Formulation cost'],['samples',zh?'样品评价':'Sample evaluation'],['qualification',zh?'质量文件':'Quality documents'],['supply-terms',zh?'交付条件':'Delivery terms'],['quote',zh?'提交询价':'Send a brief']];
---
<section id="procurement-summary" class="mb-8 border-b border-gray-200 pb-8">
 <p class="text-lg leading-relaxed">{zh?'饮料、冲调粉与胶囊对姜黄原料的要求不同。采购前，先确定需要香辛风味、黄色着色，还是明确的姜黄素类含量，再比较原料形态、载体和检测结果。本页帮助你整理可比规格、安排样品评价，并提交询价所需的信息。':'Drinks, instant powders and capsules need different turmeric materials. Decide whether your product needs spice character, yellow colour or a specified curcuminoid content, then compare format, carriers and assay results. Use this guide to build comparable specifications, plan sample evaluation and prepare a bulk sourcing inquiry.'}</p>
 <p class="text-sm text-gray-600 mt-3">{zh?'可供形态、规格文件、样品及交付条件待书面确认。':'Available forms, specification documents, samples and delivery terms: Requires written confirmation.'}</p>
 <div class="flex flex-wrap gap-3 mt-5">{[['quote',zh?'提交采购需求':'Send a sourcing brief'],['sample',zh?'咨询样品':'Discuss samples'],['TDS',zh?'咨询规格与资料':'Discuss specifications']].map(([request,label])=><a data-procurement-action={request} href={quote(request)} class="px-4 py-3 bg-primary text-white rounded-lg font-medium">{label}</a>)}</div>
 <a data-buyer-brief href={getLocalizedPath('/resources/downloads',lang)+'#sourcing-checklist'} class="block underline text-primary mt-4">{zh?'采购简报与供应商审核清单':'Sourcing brief and supplier review checklist'}</a>
 <nav aria-label={zh?'采购页目录':'Procurement contents'} class="flex flex-wrap gap-x-5 gap-y-2 mt-6 text-sm">{sections.map(([id,label])=><a href={`#${id}`} class="underline text-primary">{label}</a>)}</nav>
</section>
<style is:global>
[data-turmeric-procurement]{max-width:820px;margin-inline:auto;overflow-wrap:anywhere;line-height:1.85}
[data-turmeric-procurement] section,[data-turmeric-procurement] span[id]{scroll-margin-top:7rem}
[data-turmeric-procurement] section{margin-top:2rem}
[data-turmeric-procurement] table{width:100%;table-layout:fixed;border-collapse:collapse}
[data-turmeric-procurement] th,[data-turmeric-procurement] td{padding:.65rem;border:1px solid #d8e1d0;vertical-align:top;overflow-wrap:anywhere}
[data-turmeric-procurement] th{background:#f3f6ef}
[data-turmeric-procurement] #samples th:first-child{width:30%}
[data-turmeric-procurement] h2{text-wrap:balance}
[data-turmeric-procurement] a:focus-visible{outline:3px solid #345a27;outline-offset:3px}
@media(max-width:600px){[data-turmeric-procurement] table{font-size:.85rem;line-height:1.6}[data-turmeric-procurement] th,[data-turmeric-procurement] td{padding:.4rem}}
</style>
