---
interface Props { lang: 'en'|'zh'; headings: {depth:number; slug:string; text:string}[] }
const {lang, headings}=Astro.props;
const zh=lang==='zh';
---
<div class="centella-stability-reader">
 <nav id="centella-stability-toc" aria-label={zh?'文章目录':'On this page'}>
  <h2>{zh?'阅读目录':'On this page'}</h2>
  <ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
 </nav>
 <slot />
</div>
<style>
 .centella-stability-reader {max-width:820px;margin-inline:auto;text-align:left;overflow-wrap:anywhere;line-height:1.85}
 nav {padding:1.25rem;background:#f8f7f4;border-radius:12px;margin-bottom:2rem}
 nav h2 {font-size:1.15rem;margin:0 0 .7rem}
 nav ol {margin:0;padding-left:1.3rem;font-size:1rem}
 .centella-stability-reader :global([id]) {scroll-margin-top:100px}
 .centella-stability-reader :global(.centella-stability-table) {max-width:100%;overflow-x:auto;margin:1rem 0 2rem;border:1px solid #cad8ce;border-radius:8px;overscroll-behavior-x:contain;isolation:isolate}
 .centella-stability-reader :global(.centella-stability-table:focus-visible) {outline:3px solid #1b4d3e;outline-offset:3px}
 .centella-stability-reader :global(table) {width:100%;min-width:780px;margin:0;font-size:1rem;line-height:1.65;border-collapse:separate;border-spacing:0;table-layout:fixed}
 .centella-stability-reader :global(caption) {text-align:left;padding:1rem;font-weight:600;color:#1b4d3e;background:#f5f8f5}
 .centella-stability-reader :global(th), .centella-stability-reader :global(td) {padding:1rem;vertical-align:top;border-bottom:1px solid #dbe4dc}
 .centella-stability-reader :global(thead th) {background:#edf2ed}
 .centella-stability-reader :global(th:first-child) {width:180px;position:sticky;left:0;z-index:1;background:#edf2ed;border-right:1px solid #cad8ce}
 .centella-stability-reader :global(.centella-stability-hint) {font-size:.9rem;color:#4b5563;margin-bottom:.25rem}
 .centella-stability-reader :global([id^="centella-stability-ref-"]) {font-size:1rem;line-height:1.7}
 @media(max-width:600px) {
  .centella-stability-reader :global(table) {min-width:0;width:calc(200vw - 208px)}
  .centella-stability-reader :global(table:has(thead th:nth-child(4))) {width:calc(300vw - 382px)}
  .centella-stability-reader :global(caption) {position:sticky;left:0;width:calc(100vw - 34px);box-sizing:border-box}
  .centella-stability-reader :global(th:first-child) {width:140px}
  .centella-stability-reader :global(th), .centella-stability-reader :global(td) {padding:.75rem}
 }
</style>
