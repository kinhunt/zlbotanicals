---
interface Props { lang: 'en'|'zh'; headings: {depth:number; slug:string; text:string}[] }
const {lang, headings}=Astro.props;
const zh=lang==='zh';
const waters=zh?['低矿物质对照水','当前生产水']:['Low-mineral reference','Production water'];
const routes=zh?['当前复溶路线','允许的替代路线']:['Current reconstitution','Permitted alternative'];
---
<div class="tea-haze-reader">
  <nav id="tea-haze-toc" aria-label={zh?'文章目录':'On this page'}>
    <h2>{zh?'阅读目录':'On this page'}</h2>
    <ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </nav>
  <figure id="tea-haze-design" aria-labelledby="tea-haze-design-title">
    <figcaption id="tea-haze-design-title">{zh?'八条件筛选：建议研发设计，非实测结果':'Eight-condition screen: proposed development design, not trial results'}</figcaption>
    <p>{zh?'同批茶原料 → 四组独立配制 → 每组分成两种储存配对样':'One tea lot → four preparations → two paired storage samples from each'}</p>
    <div class="design-grid">{waters.flatMap(w=>routes.map(route=><div class="design-pair"><strong>{w}</strong><span>{route}</span><div class="storage-pair"><span>{zh?'受控非冷藏':'Controlled non-refrigerated'}</span><span>{zh?'冷藏挑战':'Refrigerated challenge'}</span></div></div>))}</div>
    <p>{zh?'重复试验需重新独立配制；回温使用专用样品，不改变主留样储存历史。':'Repeat runs require fresh independent preparations. Use a separate sample for warming without changing the main retain’s storage history.'}</p>
  </figure>
  <slot />
</div>
<style>
 .tea-haze-reader {max-width:820px;margin-inline:auto;overflow-wrap:anywhere;line-height:1.85}
 nav {padding:1.25rem;background:#f8f7f4;border-radius:12px;margin-bottom:2rem}
 nav h2 {font-size:1.15rem;margin:0 0 .7rem}
 nav ol {margin:0;padding-left:1.3rem;font-size:1rem}
 figure {margin:2rem 0;padding:1.25rem;border:1px solid #cad8ce;border-radius:12px;background:#f5f8f5;font-size:1rem}
 figcaption {font-weight:700;color:#1b4d3e}
 .design-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1rem 0}
 .design-pair {background:white;border:1px solid #cad8ce;border-radius:8px;padding:1rem;display:flex;flex-direction:column;gap:.5rem}
 .storage-pair {display:grid;grid-template-columns:1fr 1fr;gap:.5rem;font-size:.875rem}
 .storage-pair span {padding:.5rem;background:#edf2ed;border-radius:5px}
 .tea-haze-reader :global(h2), .tea-haze-reader :global([id^="tea-haze-ref-"]) {scroll-margin-top:100px}
 .tea-haze-reader :global(.tea-haze-table) {max-width:100%;overflow-x:auto;margin:1rem 0 2rem;border:1px solid #cad8ce;border-radius:8px;overscroll-behavior-x:contain}
 .tea-haze-reader :global(.tea-haze-table:focus-visible) {outline:3px solid #1b4d3e;outline-offset:3px}
 .tea-haze-reader :global(table) {min-width:720px;margin:0;font-size:1rem;line-height:1.65}
 .tea-haze-reader :global(th), .tea-haze-reader :global(td) {padding:1rem;vertical-align:top;min-width:210px}
 .tea-haze-reader :global(th) {background:#edf2ed}
 .tea-haze-reader :global(.tea-haze-hint) {font-size:.875rem;color:#4b5563;margin-bottom:.25rem}
 .tea-haze-reader :global([id^="tea-haze-ref-"]) {font-size:.95rem;line-height:1.7}
 @media(max-width:600px) {.design-grid {grid-template-columns:1fr} figure {padding:1rem}}
</style>
