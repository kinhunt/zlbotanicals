---
import {createMarkdownProcessor} from '@astrojs/markdown-remark';
import en from '../../docs/evidence/tea-family/revision/tea-family-sales.en.md?raw';
import zhCopy from '../../docs/evidence/tea-family/revision/tea-family-sales.zh.md?raw';
import PageLayout from '../layouts/PageLayout.astro';
const {lang} = Astro.props as {lang:'en'|'zh'};
const zh=lang==='zh';
const draft=zh?zhCopy:en;
const title=draft.match(/^seo_title: (.+)$/m)![1];
const description=draft.match(/^seo_description: (.+)$/m)![1];
const [approvedBody,sources]=draft.split('---\n')[2].trim().split('\n## Sources\n');
const quote=(request:'quote'|'sample')=>(zh?'/zh':'')+'/request-quote?'+new URLSearchParams({
 product:zh?'茶提取物：绿茶、红茶与乌龙茶':'Tea extracts: green, black and oolong',
 form:zh?'速溶提取粉、茶浓缩液项目或儿茶素型干粉；形态待讨论':'Soluble extract powder, liquid concentrate project or catechin-oriented dry powder; format to discuss',
 request,source:'catalog',
}).toString();
let ctaIndex=0;
const body=approvedBody.replace(/\]\(\/(?:zh\/)?request-quote\)/g,()=>`](${quote(ctaIndex++===1?'sample':'quote')})`);
const processor=await createMarkdownProcessor({smartypants:false});
const render=async (md:string)=>(await processor.render(md.replace(/\[(\d+)\]/g,'<a class="tea-citation" href="#tea-family-ref-$1">[$1]</a>'))).code;
const [hero,...sections]=body.split('\n## ');
const heroHtml=await render(hero);
const sectionHtml=await Promise.all(sections.map(async (section)=>{
 const table=section.match(/\| Ingredient[^\n]*\n(?:\|[^\n]*\n?)+|\| 原料方向[^\n]*\n(?:\|[^\n]*\n?)+/);
 if(!table) return render('## '+section);
 const rows=table[0].trim().split('\n').map(row=>row.split('|').slice(1,-1).map(c=>c.trim()));
 const cards=rows.slice(2).map(row=>`<article class="tea-material"><p class="eyebrow">${rows[0][0]}</p><h3>${row[0]}</h3><dl>${row.slice(1).map((cell,i)=>`<div><dt>${rows[0][i+1]}</dt><dd>${cell}</dd></div>`).join('')}</dl></article>`).join('');
 return render('## '+section.replace(table[0],`<div class="tea-matrix">${cards}</div>\n`));
}));
const references=sources.trim().split('\n').map(line=>{
 const [,id,url,label]=line.match(/^\[(\d+)\] (\S+) — (.+)$/)!;
 return {id,url,label};
});
---
<PageLayout title={title} description={description} lang={lang}>
 <article class="tea-family" data-tea-family>
  <nav class="breadcrumbs" aria-label={zh?'面包屑导航':'Breadcrumb'}><a href={zh?'/zh/products':'/products'}>{zh?'产品':'Products'}</a> / {zh?'茶提取物':'Tea extracts'}</nav>
  <header class="tea-hero"><p class="eyebrow">ZL BOTANICALS</p><Fragment set:html={heroHtml}/></header>
  <div class="tea-sections">{sectionHtml.map(html=><section><Fragment set:html={html}/></section>)}</div>
  <section class="tea-sources"><h2 id="tea-family-sources">{zh?'来源':'Sources'}</h2><ul>{references.map(ref=><li id={`tea-family-ref-${ref.id}`}><span>[{ref.id}] </span><a href={ref.url}>{ref.label}</a></li>)}</ul></section>
 </article>
</PageLayout>
<style is:global>
.tea-family{max-width:1120px;margin:auto;padding:1.5rem 24px 4rem;color:#293a2c;line-height:1.8;overflow-wrap:anywhere}.tea-family .breadcrumbs{font-size:.875rem;margin-bottom:1.5rem}.tea-family a{color:#345a27;text-decoration:underline;text-underline-offset:4px}.tea-family .tea-hero{background:#f3f6ee;border-top:4px solid #47613c;padding:2.5rem;border-radius:0 0 1rem 1rem}.tea-family .eyebrow{letter-spacing:.16em;font-size:.8rem;font-weight:700}.tea-family h1{font-size:clamp(2rem,4vw,3.3rem);font-weight:700;line-height:1.15;max-width:900px;margin:1rem 0 1.5rem;letter-spacing:-.025em}.tea-family p{margin:1rem 0;max-width:820px}.tea-family h2{font-size:clamp(1.5rem,2.5vw,2rem);font-weight:700;line-height:1.3;margin-bottom:1.3rem}.tea-family h3{font-size:1.15rem;font-weight:700;line-height:1.5;margin:1.5rem 0 .7rem}.tea-family .tea-sections>section{padding:2.5rem 0;border-bottom:1px solid #dfe5d7}.tea-family :is(h2,h3,li[id]){scroll-margin-top:7rem}.tea-family .tea-matrix{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin:1.5rem 0}.tea-family .tea-material{border:1px solid #d8e1cf;border-radius:.7rem;padding:1.5rem;background:#fafbf8}.tea-family .tea-material h3{margin:0 0 1rem;color:#26492a}.tea-family dt{font-size:.8rem;font-weight:700;color:#58634e;margin-top:1rem}.tea-family dd{margin:.2rem 0 0}.tea-family li{margin:.7rem 0}.tea-family .tea-sections ul{list-style:disc;padding-left:1.4rem;max-width:820px}.tea-family .tea-sources{padding-top:2.5rem;font-size:.9rem}.tea-family .tea-sources li{padding:.65rem 0}.tea-family .tea-citation{font-size:.85em;padding:0 .12em}.tea-family a[href*="request-quote"]{display:inline-block;padding:.8rem 1.1rem;background:#345a27;color:white;border-radius:.4rem;text-decoration:none;margin:.4rem .25rem .4rem 0}.tea-family a:focus-visible{outline:3px solid #b07b20;outline-offset:4px}@media(max-width:700px){.tea-family{padding-inline:18px}.tea-family .tea-hero{padding:1.4rem}.tea-family .tea-matrix{grid-template-columns:1fr}.tea-family .tea-material{padding:1.2rem}.tea-family h1{font-size:2rem}}
</style>
