---
import concepts from '../data/odm.json';
import {getExtractSale,salesTitle} from '../data/extract-sales';
import {getIngredientReaderPack} from '../data/ingredient-reader-packs';
import {dimensions,dimensionLabels} from '../data/ingredient-knowledge';
import {getLocalizedPath,type Language} from '../i18n/config';
const {id,lang}=Astro.props as {id:string;lang:Language};
const sale=getExtractSale(id)!; const pack=getIngredientReaderPack(id)!;const zh=lang==='zh';
const local=(path:string)=>getLocalizedPath(path,lang);
const science=local(`/plant-extracts/ingredients/${id}`);
const quote=(request:string)=>local('/request-quote')+'?'+new URLSearchParams({product:sale.name[lang],request}).toString();
const sections=[['material-selection',zh?'产品形态':'Product forms'],['specifications',zh?'规格与检测':'Specifications'],['why-choose-us',zh?'振隆优势':'Why ZL'],['qualification',zh?'质量与资料':'Quality & documents'],['samples',zh?'应用与样品':'Applications & samples'],['supply-terms',zh?'价格与交付':'Price & delivery'],['procurement-faq',zh?'采购问答':'Buyer FAQ']];
const benefitTitles=zh?['有竞争力的采购价格','稳定品质，便于持续采购','认证资料支持','可靠交付协同']:['Competitive bulk pricing','Quality for repeat purchasing','Certification-document support','Reliable delivery coordination'];
const benefits=sale.benefits.map((body,i)=>[benefitTitles[i],body[lang]]);
---
<div class="extract-sales" data-extract-sales={id}>
 <section class="sales-hero" id="procurement-summary" data-procurement-hero>
  <div><p class="eyebrow">ZL BOTANICALS · {zh?'植物原料供应商':'BOTANICAL INGREDIENT SUPPLIER'}</p>
   <h1>{salesTitle(sale,lang)}</h1><p class="identity">{sale.identity[lang]}</p><p class="offer">{sale.offer[lang]}</p>
   <p>{zh?'有竞争力的价格、稳定品质承诺、认证资料支持与可靠交付协同，服务品牌商及配方制造企业的批量采购。':'Competitive pricing, consistent-quality commitments, certification support and reliable delivery coordination for brands and formulation manufacturers buying in bulk.'}</p>
   <div class="actions"><a data-procurement-action="quote" class="button" href={quote('quote')}>{zh?'索取采购报价':'Request a bulk quote'} ↗</a><a data-procurement-action="sample" class="button secondary" href={quote('sample')}>{zh?'咨询样品':'Request a sample'} ↗</a></div>
   <a data-procurement-action="TDS" href={quote('TDS')}>{zh?'索取 TDS、COA 与技术资料':'Request TDS, COA & technical documents'} →</a>
  </div>
  <figure class="product-art"><img src={`/images/products/${id}.webp`} width="1024" height="1024" fetchpriority="high" alt={`${sale.name[lang]}${zh?'概念插画，非批次样品':' concept illustration, not a batch sample'}`} /><figcaption>{zh?'概念插画，非批次样品。图中标签不代表已确认的纯度、等级或认证，规格以现行 TDS 与批次 COA 为准。':'Concept illustration, not a batch sample. Printed labels do not establish purity, grade or certification. Use the current TDS and batch COA for specifications.'}</figcaption></figure>
 </section>
 <dl class="facts"><div><dt>{zh?'采购对象':'For buyers'}</dt><dd>{zh?'品牌商 · 配方制造企业':'Brands · Formulation manufacturers'}</dd></div><div><dt>{zh?'产品选型':'Grade selection'}</dt><dd>{zh?'成分 · 形态 · 用途':'Composition · Form · Intended use'}</dd></div><div><dt>{zh?'质量资料':'Quality documents'}</dt><dd>COA · TDS · SDS</dd></div><div><dt>{zh?'订单条件':'Order terms'}</dt><dd>MOQ · {zh?'包装 · 交付':'Packing · Delivery'}</dd></div></dl>
 <nav class="sales-nav" aria-label={zh?'采购页目录':'Procurement contents'}>{sections.map(([anchor,label])=><a href={`#${anchor}`}>{label}</a>)}</nav>
 <section id="material-selection"><span id={zh?'原料身份与选型':'material-identity-and-selection'} /><h2>{zh?'按产品用途匹配原料形态':'Product forms for your application'}</h2><p>{zh?'我们可按以下原料形态提供选型报价，具体可供规格、浓度及样品条件随报价确认。':'Our quotation range covers the material forms below. We confirm the available grade, concentration and sample terms in your quotation.'}</p>
  <p class="scroll-hint">{zh?'窄屏可在表格内横向滚动。':'On small screens, scroll within the table.'}</p>
  <div class="sales-table" tabindex="0" role="region" aria-label={zh?'原料形态对照表':'Material forms comparison'}><table><thead><tr><th scope="col">{zh?'形态':'Form'}</th><th scope="col">{zh?'组成重点':'Composition'}</th><th scope="col">{zh?'应用方向':'Application fit'}</th></tr></thead><tbody>{sale.forms.map(row=><tr><td>{row.form[lang]}</td><td>{row.composition[lang]}</td><td>{row.use[lang]}</td></tr>)}</tbody></table></div>
  <a href={`${science}#components`}>{zh?'查看本原料的成分与形态研究':'Read this ingredient’s material and composition research'} →</a>
 </section>
 <section id="specifications"><span id={zh?'参考规格与询价要点':'indicative-specification-brief'}/><h2>{zh?'规格、检测方法与报价依据':'Specifications, assay methods & quotation basis'}</h2>
  <div class="sales-table" tabindex="0" role="region" aria-label={zh?'采购规格表':'Purchasing specification table'}><table><thead><tr><th scope="col">{zh?'项目':'Item'}</th><th scope="col">{zh?'报价及验收依据':'Quotation & acceptance basis'}</th></tr></thead><tbody>
   <tr><td>{zh?'身份与成分':'Identity & composition'}</td><td>{sale.identity[lang]} · {zh?'列明原料组成、来源路线、载体及相关加工助剂。':'State ingredient composition, source route, carriers and relevant processing aids.'}</td></tr>
   <tr><td>{zh?'标志物与方法':'Markers & methods'}</td><td>{sale.assay[lang]}</td></tr>
   <tr><td>{zh?'粉体及使用表现':'Physical & handling properties'}</td><td>{zh?'色泽、气味、水分、粒度、溶解或分散表现按所选形态约定；不是所有形态共用一个指标。':'Agree colour, odour, moisture, particle size and dissolution or dispersion requirements for the selected form, rather than one limit for every grade.'}</td></tr>
   <tr><td>{zh?'污染物与放行':'Contaminants & release'}</td><td>{zh?'按来源、工艺及目标市场约定微生物、农残、元素杂质和溶剂残留项目及限值，批次 COA 对应实际检验结果。':'Agree microbiological, pesticide, elemental-impurity and residual-solvent scope and limits by source, process and market. Batch COA values must correspond to actual results.'}</td></tr>
  </tbody></table></div><a href={quote('TDS')}>{zh?'索取所需规格的 TDS':'Request the TDS for your target grade'} →</a>
 </section>
 <section id="why-choose-us"><h2>{zh?`为什么选择振隆采购${sale.name[lang]}`:`Why buy ${sale.name[lang].toLowerCase()} from ZL Botanicals?`}</h2><div class="benefits">{benefits.map(([title,body])=><div class="benefit"><h3>{title}</h3><p>{body}</p></div>)}</div><a data-why-choose-brief href={quote('quote')}>{zh?'获取适合项目的报价':'Get a quote for your project'} →</a></section>
 <section id="qualification"><span id={zh?'批准样品前应索取的文件':'documents-to-request-before-approval'}/><h2>{zh?'质量控制、COA 与认证资料':'Quality control, COA & certification documents'}</h2><p>{sale.quality[lang]}</p><p>{zh?'TDS 用于确认规格，COA 用于对应具体批次结果，SDS 用于原料安全操作。我们按项目协调资料，认证需求按原料、持证主体、场所、范围及有效期核对。GMP、ISO、Halal、Kosher 或有机要求可写入询价，不代表所有产品均持有这些认证。':'TDS defines the specification, COA records the identified batch, and SDS supports safe handling. We coordinate documents for the project and review certification needs against material, holder, site, scope and validity. Include GMP, ISO, Halal, Kosher or organic requirements in the enquiry; these are not blanket certifications for every product.'}</p><div class="document-links"><a href={quote('COA')}>{zh?'咨询批次 COA':'Enquire about batch COA'}</a><a href={quote('certification')}>{zh?'咨询对应认证资料':'Enquire about scoped certification'}</a><a href={local('/plant-extracts/standards/coa-vs-specification')}>{zh?'规格与 COA 的区别':'Specification vs COA'}</a></div></section>
 <section id="samples"><span id={zh?'应用开发检查':'application-development-checks'}/><h2>{zh?'应用方向与样品评估':'Application formats & sample evaluation'}</h2><p>{sale.application[lang]}</p><p class="scope">{zh?'下图为开发概念，不是客户案例、已验证配方或成品制造承诺；实际用途按原料及目标市场确认。':'These are development concepts, not customer cases, validated formulas or finished-goods manufacturing offers. Confirm intended use for the material and target market.'}</p><div class="applications">{pack.plans.map(plan=><article class="application"><img src={plan.image!.src} width={plan.image!.width} height={plan.image!.height} loading="lazy" alt={plan.image!.alt[lang]} /><div><h3>{plan.title[lang]}</h3><p>{plan.image!.caption[lang]}</p><a href={`${science}#formulation-${plan.id}`}>{zh?'查看配方组合与试验要点':'Read formulation combinations & trial criteria'} →</a></div></article>)}</div><a data-procurement-action="sample" class="button" href={quote('sample')}>{zh?'为您的配方咨询样品':'Request a sample for your formulation'} ↗</a></section>
 <section id="supply-terms"><span id="cost-comparison"/><span id={zh?'如何提交采购需求':'send-a-useful-sourcing-brief'}/><h2>{zh?'批量价格、MOQ、包装与交付':'Bulk price, MOQ, packaging & delivery'}</h2><p>{zh?'我们按选定形态、含量及方法、订单量和目的地报价。书面报价确认样品数量与费用、MOQ、包装单位、储存条件、保质或复验期限、交期、Incoterms 及付款条件。':'We quote against selected form, assay and method, volume and destination. Your written quotation includes sample quantity and cost, MOQ, pack size, storage conditions, shelf-life or retest basis, lead time, Incoterms and payment terms.'}</p><p>{zh?'确认样品与订单规格后，把验收要求、批次文件及变更通知约定写入订单，便于后续复购。':'Once the sample and order specification are agreed, record acceptance criteria, batch documents and change-notification terms for repeat purchasing.'}</p><a href={quote('quote')}>{zh?'按数量和目的地索取价格':'Request pricing by volume & destination'} →</a></section>
 <section id="procurement-faq"><h2>{zh?`${sale.name[lang]}采购问答`:`${sale.name[lang]} purchasing FAQ`}</h2>
  <details open><summary>{sale.faq[lang]}</summary><p>{sale.answer[lang]}</p></details>
  <details><summary>{zh?'样品、价格和最小订量如何确认？':'How are samples, prices and minimum orders confirmed?'}</summary><p>{zh?'发送目标规格、用途、首单数量和目的地。我们按所选原料回复可供样品与报价，数量、费用、文件及交付条件以书面确认。':'Send the target specification, application, first-order quantity and destination. We respond with sample availability and a quotation for the selected material; quantity, cost, documents and delivery terms are confirmed in writing.'}</p></details>
  <details><summary>{zh?'能提供哪些质量或认证文件？':'Which quality and certification documents can I request?'}</summary><p>{zh?'可咨询 TDS、对应批次 COA、SDS 及项目要求的认证资料。实际文件按原料和用途协调，认证有效范围单独核对，网页不是批次检测报告。':'Enquire about TDS, the relevant batch COA, SDS and project-specific certification documents. Actual documents are coordinated by material and use, with certificate scope reviewed separately. This page is not a batch test report.'}</p></details>
 </section>
 <section id="quote" class="quote-box"><h2>{zh?`开始${sale.name[lang]}采购`:`Start your ${sale.name[lang].toLowerCase()} order enquiry`}</h2><p>{zh?'留下目标市场、用途、规格及数量，直接进入报价沟通。产品名称与申请类型会预填，发送前可编辑。':'Send your target market, application, specification and quantity to start quotation. The product and request type are prefilled and remain editable before sending.'}</p><div class="actions"><a class="button" href={quote('quote')}>{zh?'索取采购报价':'Request a bulk quote'} ↗</a><a class="button secondary" href={quote('sample')}>{zh?'咨询样品':'Request a sample'} ↗</a></div><p class="scope">{zh?'填写不会自动发送；提交时表单通过第三方 FormSubmit 处理。也可邮件联系 info@zlbotanicals.com。':'Opening the form does not send an enquiry. Submission uses the third-party FormSubmit service. You can also email info@zlbotanicals.com.'} <a href={local('/privacy')}>{zh?'隐私政策':'Privacy policy'}</a></p></section>
 <section id="processing-dossier"><h2>{zh?`${sale.name[lang]}技术阅读`:`Technical reading for ${sale.name[lang].toLowerCase()}`}</h2><p>{zh?`了解${sale.name[lang]}的形态区别、配方组合，以及工艺与质量选择的研究依据。`:`Explore ${sale.name[lang].toLowerCase()} material forms, formulation combinations and the evidence behind processing and quality choices.`}</p>
 <nav class="document-links" aria-label={zh?'技术阅读主题':'Technical reading topics'}>
  <a href={`${science}#components`}>{zh?'原料形态与检测方法':'Material forms & assay methods'}</a>
  <a href={`${science}#formulations`}>{zh?'配方组合':'Formulation combinations'}</a>
  <a href={`${science}#standards`}>{zh?'质量依据':'Quality evidence'}</a>
  <a href={`${science}#processes`}>{zh?'工艺依据':'Processing evidence'}</a>
 </nav>
 <div class="reading" data-commercial-knowledge-summary>{dimensions.map(dimension=><section id={dimension}>
  <h3>{(id==='stevia'||id==='resveratrol')&&dimension==='processes'?(zh?'生产路线':'Processing routes'):(id==='stevia'||id==='resveratrol')&&dimension==='equipment'?(zh?'加工设备':'Processing equipment'):dimensionLabels[dimension][lang]}</h3>
  <p>{sale.reading[dimension][lang]}</p>
  <a href={`${science}#${dimension}`}>{zh?'阅读本原料研究':'Read ingredient research'} →</a>
 </section>)}</div><p>{zh?'以下研究用于理解原料及应用，不证明振隆设备配置、批次质量或成品功效。':'These studies provide material and application context, not evidence of ZL equipment ownership, batch quality or finished-product efficacy.'}</p><p><a href={science}>{zh?`${sale.name[lang]}百科`:`${sale.name[lang]} encyclopedia`}</a> · <a href={local('/resources/downloads#sourcing-checklist')}>{zh?'下载采购简报':'Download a sourcing brief'}</a></p><nav aria-label={zh?'相关开发概念':'Related development concepts'}>{concepts.filter(c=>c.products.includes(id)).map(c=><p><a href={local(`/odm/${c.slug}`)}>{c.title[lang]} · {zh?'开发概念':'Development concept'}</a></p>)}</nav><ul class="sources">{sale.sources.map(id=>{const source=pack.sources.find(s=>s.id===id)!;return <li><a href={source.url} rel="noopener noreferrer">{source.title}</a></li>;})}</ul></section>
</div>
<style>
.extract-sales{max-width:1120px;margin:auto;color:#293a2c;line-height:1.8;overflow-wrap:anywhere}.sales-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);align-items:center;gap:2.5rem;padding:1rem 0 2.5rem}.eyebrow{font-size:.75rem;letter-spacing:.09em;font-weight:700;color:#526740}.extract-sales h1{font-size:clamp(2.1rem,4vw,3.35rem);line-height:1.15;font-weight:700;letter-spacing:-.03em;margin:1rem 0;color:#233e27}.identity{color:#626a58;font-size:.98rem}.offer{font-size:1.08rem}.extract-sales p{margin:.8rem 0 1.1rem}.extract-sales a{color:#345a27;text-decoration:underline;text-underline-offset:4px}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin:1.4rem 0 1rem}.extract-sales .button{display:inline-block;padding:.8rem 1.15rem;border:1px solid #345a27;border-radius:.4rem;background:#345a27;color:white;font-weight:600;text-decoration:none}.extract-sales .button.secondary{background:white;color:#345a27}.product-art{margin:0;background:#f5f4ed;border:1px solid #e4e5da;border-radius:1rem;padding:1rem}.product-art img{width:100%;height:auto;max-height:330px;object-fit:contain}.product-art figcaption{font-size:.75rem;line-height:1.6;color:#62665a}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:#f4f6ef;border-block:1px solid #d8e1d0}.facts>div{padding:1.1rem}.facts dt{font-size:.75rem;color:#626a58}.facts dd{font-size:.95rem;font-weight:600;margin:.4rem 0 0}.sales-nav,.document-links{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;padding:1.2rem 0;font-size:.9rem}.sales-nav{border-bottom:1px solid #d8e1d0}.extract-sales>section:not(.sales-hero){padding:2.6rem 0;border-bottom:1px solid #e1e5da}.extract-sales section,.extract-sales span[id]{scroll-margin-top:7rem}.extract-sales h2{font-size:clamp(1.5rem,2.4vw,2rem);line-height:1.35;margin:0 0 1.2rem;color:#263f2a;font-weight:700}.extract-sales h3{font-size:1.1rem;font-weight:700;line-height:1.5;margin:.6rem 0}.extract-sales>section>p{max-width:820px}.sales-table{overflow-x:auto;border:1px solid #d8e1d0;border-radius:.5rem;margin:1.2rem 0}.sales-table table{border-collapse:collapse;table-layout:fixed;width:100%;min-width:650px;font-size:.9rem;line-height:1.75}.sales-table th,.sales-table td{padding:1rem;text-align:left;vertical-align:top;border-bottom:1px solid #d8e1d0;overflow-wrap:break-word}.sales-table th{background:#eff3e9}.sales-table tr:nth-child(even){background:#fafbf7}.scroll-hint,.scope{font-size:.85rem;color:#62665a}.benefits,.reading{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin:1.4rem 0}.benefit{border:1px solid #d8e1d0;border-radius:.6rem;padding:1.3rem;background:#fafbf7}.benefit p{margin-bottom:0}.applications{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;margin:1.5rem 0}.application{border:1px solid #d8e1d0;border-radius:.6rem;overflow:hidden;background:#fafbf7}.application img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;display:block}.application>div{padding:1.1rem}.application p,.application a{font-size:.85rem}.quote-box{background:#f1f5eb;border:1px solid #d8e1d0!important;border-radius:.75rem;padding:2rem!important;margin-top:2rem}.reading section{border-top:2px solid #d8e1d0;padding-top:.7rem;font-size:.9rem}.sources{padding-left:1.3rem;font-size:.8rem}.extract-sales details{padding:1rem 0;border-bottom:1px solid #d8e1d0}.extract-sales summary{font-weight:600;cursor:pointer}.extract-sales :focus-visible{outline:3px solid #a77b16;outline-offset:4px}@media(max-width:1000px){.facts{grid-template-columns:repeat(2,minmax(0,1fr))}.sales-hero{gap:1.5rem}.applications{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.sales-hero{grid-template-columns:1fr;padding-top:.5rem}.extract-sales h1{font-size:2.2rem}.product-art{max-width:440px;width:100%;justify-self:center}.product-art img{max-height:280px}.benefits,.applications,.reading{grid-template-columns:1fr}.extract-sales>section:not(.sales-hero){padding:2rem 0}.quote-box{padding:1.3rem!important}.facts>div{padding:.9rem}}
</style>
