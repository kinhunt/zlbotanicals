---
import ExtractionVideo from './ExtractionVideo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/plant-extracts.json';
import {getLocalizedPath} from '../i18n/config';
interface Props {lang:'en'|'zh'; section?:string; topic?:string}
const {lang,section,topic}=Astro.props;
const zh=lang==='zh';
const local=(p:string)=>getLocalizedPath(p,lang);
const root=local('/plant-extracts');
const branch=data.sections.find(s=>s.slug===section);
const entry=(data.topics as any[]).find(t=>t.slug===topic);
const content=entry?.translations[lang] || branch?.translations[lang];
const title=content?.title || (zh?'植物提取物':'Plant Extracts');
const description=content?.description || (zh?'从植物身份、成分和提取工艺，到设备、应用与法规：面向采购和开发的双语知识库。':'A bilingual reference for botanical identity, ingredients, extraction, equipment, applications and regulatory review.');
const references=entry?.references || branch?.references || ['who','review','gea','ndi','eu'];
const children=(data.topics as any[]).filter(t=>t.section===section);
const path=topic?`${root}/${section}/${topic}`:section?`${root}/${section}`:root;
const crumbs=[{name:zh?'首页':'Home',url:local('/')},{name:zh?'植物提取物':'Plant extracts',url:root},...(branch?[{name:branch.translations[lang].title,url:`${root}/${section}`}]:[]),...(entry?[{name:title,url:path}]:[])];
const relatedLabels: Record<string,string[]> = {"/plant-extracts/standards/moisture-vs-loss-on-drying": ["Water content vs loss on drying", "水分与干燥失重"], "/plant-extracts/standards/coa-vs-specification": ["COA vs specification", "检测报告与规格书"],"/products/green-tea": ["Green tea supply guide", "绿茶供货指南"], "/products/stevia": ["Stevia supply guide", "甜菊供货指南"], "/products/monk-fruit": ["Monk fruit supply guide", "罗汉果供货指南"], "/products/centella-asiatica": ["Centella supply guide", "积雪草供货指南"], "/solutions/beverages": ["Beverage concepts", "饮料开发概念"], "/solutions/cosmetics": ["Cosmetic concepts", "化妆品开发概念"], "/resources/blog/green-tea-energy-beverage-2026": ["Green tea beverage buyer guide", "绿茶饮料采购指南"], "/resources/blog/zero-calorie-sweetener-market-2026": ["Botanical sweetener buyer guide", "植物甜味剂采购指南"], "/resources/downloads": ["Document checklist", "文件检查表"], "/quality": ["Quality review", "质量复核"]};
const tasks=zh?['确认物种、部位和起始原料追溯','记录溶剂、载体、形态与检测方法','按实际配方和目的地市场制定验收计划']:['Confirm species, plant part and starting-material traceability','Record solvent, carrier, form and analytical method','Set acceptance criteria for the actual formulation and destination market'];
---
<BaseLayout title={title} description={description} lang={lang}>
 <div class="encyclopedia">
  <section class="knowledge-hero">
   <div class="container-wide">
    <nav aria-label={zh?'面包屑导航':'Breadcrumb'}><ol class="crumbs">{crumbs.map((c,i)=><li>{i>0&&<span aria-hidden="true"> / </span>}{i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<a href={c.url}>{c.name}</a>}</li>)}</ol></nav>
    <p class="eyebrow">{zh?'振隆 · 植物知识库':'ZL BOTANICALS · KNOWLEDGE LIBRARY'}</p>
    <h1>{title}</h1><p class="intro">{description}</p>
    <p class="scope">{zh?'知识教育，不是医疗建议、供货承诺或通用生产规程。':'Educational reference—not medical advice, a supply promise or a universal manufacturing procedure.'}</p>
   </div>
  </section>
  <div class="container-wide knowledge-body">
   <nav class="section-tabs" aria-label={zh?'百科栏目':'Encyclopedia sections'}>{data.sections.map(s=><a href={`${root}/${s.slug}`} aria-current={section===s.slug?'true':undefined}>{s.translations[lang].title}</a>)}</nav>
   {!section&&<>
    <section class="reading"><h2>{zh?'什么是植物提取物？':'What is a plant extract?'}</h2>
     <p>{zh?'植物提取物是利用适宜介质把植物原料中的部分成分转移出来，常经分离、浓缩或干燥形成的制备物。它不是一个具有固定组成的单一类别。物种、植物部位、提取介质和后续加工共同影响最终材料。':'A plant extract is a preparation made by transferring selected constituents from botanical material into a suitable medium, often followed by separation, concentration or drying. It is not one category with a fixed composition. Species, plant part, extraction medium and downstream processing shape the resulting material.'} <a href={`${root}/basics`}>{zh?'阅读基础指南 →':'Read the basics →'}</a></p>
     <h3>{zh?'先分类，再比较':'Classify before comparing'}</h3><p>{zh?'分别记录来源、液体或干燥形态、提取溶剂、标志成分和载体。比例不是纯度；同名植物不等于同一种提取物；粉末也可能只是研磨原料。鉴别与检测结果需结合方法和计量基准。':'Record origin, liquid or dry form, extraction solvent, marker constituents and carriers separately. A ratio is not purity; the same plant name does not mean the same extract; a powder may simply be milled raw material. Identity and assay results need their methods and reporting basis.'}</p>
    </section>
    <section><h2>{zh?'七个栏目，从问题出发':'Seven ways into the subject'}</h2><div class="knowledge-grid">{data.sections.map((s,i)=><a class="knowledge-card" href={`${root}/${s.slug}`}><span class="card-number">0{i+1}</span><h3>{s.translations[lang].title}</h3><p>{s.translations[lang].description}</p><span class="read-link">{zh?'阅读栏目指南 →':'Explore the guide →'}</span></a>)}</div></section>
   </>}
   {content&&<article class="reading">{content.blocks.map((b:any)=><section><h2>{b.heading}</h2><p>{b.text}</p></section>)}</article>}
   {(!section||section==='processes')&&!topic&&<section class="process-panel"><h2>{zh?'典型提取路线：概念示意':'A typical extraction route: conceptual schematic'}</h2><ol class="process-flow">{(zh?['原料身份','前处理','提取','固液分离','浓缩／纯化','干燥／配制','质量复核']:['Material identity','Pretreatment','Extraction','Separation','Concentration / purification','Drying / formulation','Quality review']).map((s,i)=><li><span>{i+1}</span>{s}</li>)}</ol><p>{zh?'原创教学示意，不是真实厂房或经过验证的通用工艺。有些产品省略、重复或重新安排步骤。':'Original educational illustration—not a real facility or a validated universal process. Some products omit, repeat or reorder steps.'}</p></section>}
   {(!section||section==='processes')&&!topic&&<ExtractionVideo lang={lang} />}
   {children.length>0&&<section><h2>{zh?'深入主题':'Explore individual topics'}</h2><div class="knowledge-grid">{children.map(t=><a class="knowledge-card" href={`${root}/${section}/${t.slug}`}><h3>{t.translations[lang].title}</h3><p>{t.translations[lang].description}</p><span class="read-link">{zh?'阅读全文 →':'Read the topic →'}</span></a>)}</div></section>}
   {entry?.relatedLinks?.length>0&&<section class="reading"><h2>{zh?'相关原料、方案与采购指南':'Related ingredients, applications and buyer guides'}</h2><ul>{entry.relatedLinks.map((p:string)=><li><a href={local(p)}>{relatedLabels[p]?.[zh?1:0] || p}</a></li>)}</ul></section>}
   <section class="reading"><h2>{zh?'如何使用这份知识':'Turn reading into a review plan'}</h2><ul>{tasks.map(t=><li>{t}</li>)}</ul><p>{zh?'以书面规格与真实批次证据作决定。本文讨论的检查项目不是振隆已经完成的试验或持有的认证；设备与工艺说明不是本企业制造能力声明。':'Make decisions using written specifications and genuine batch evidence. The checks described here are not claims of tests already performed or certificates held by ZL Botanicals; equipment and process explanations do not assert our manufacturing capabilities.'}</p></section>
   {!section&&<section class="reading"><h2>{zh?'常见问题':'Frequently asked questions'}</h2>{(zh?[
    ['提取物是否一定比原植物更安全？','不是。加工可能改变组成和暴露水平，安全评价须针对实际材料、用途及使用条件。天然来源不是安全保证。'],['比例能说明有效成分含量吗？','不能单独说明。需了解比例定义、起始原料状态、载体以及标志成分检测方法。'],['设备栏目表示振隆出售设备吗？','不表示。设备内容仅解释通用原理，不是设备销售或厂房配置证明。'],['食品用途能直接推广到其他市场吗？','不能。物种、部位、加工与用途都可能影响法律分类，须核对目的地的现行官方要求。']]:[
    ['Is an extract always safer than its starting plant?','No. Processing can change composition and exposure. Assess the actual material, use and conditions; natural origin is not a safety guarantee.'],['Does an extract ratio tell me marker content?','Not on its own. Ask how the ratio is defined, the starting-material basis, carriers and the marker assay method.'],['Does the equipment guide mean ZL sells equipment?','No. It explains generic functions, not equipment sales or evidence of installed machinery.'],['Can a food use be transferred to another market?','Not automatically. Species, plant part, processing and intended use can affect legal classification. Check current destination-market requirements.']]).map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>}
   <section class="references reading"><h2>{zh?'参考来源与适用范围':'References and scope'}</h2><p>{zh?'来源核查日期':'Sources checked'}: <time datetime={data.checked}>{data.checked}</time>. {zh?'英文来源保留原始标题。状态反映本次核查，不代替上市前复核。':'Source titles are retained as published. Status reflects this check, not a substitute for pre-market review.'}</p><ol>{references.map((id:string)=>{const s=(data.sources as any)[id];return <li><a href={s.url} rel="noopener noreferrer">{s.title}</a><p>{s.scope[lang]}</p></li>})}</ol></section>
   <aside class="next-step"><h2>{zh?'从知识到具体采购需求':'From knowledge to a specific sourcing brief'}</h2><p>{zh?'百科帮助建立问题清单；现有产品和方案页面用于进一步讨论。供货、规格和适用性需要书面确认。':'The encyclopedia helps frame the questions; existing product and solution pages support the next discussion. Availability, specifications and suitability require written confirmation.'}</p><div class="section-tabs">{[['/products',zh?'产品目录':'Product catalogue'],['/solutions',zh?'应用方案':'Application concepts'],['/resources/ingredient-guides',zh?'原料采购指南':'Ingredient buyer guides'],['/resources/quality-guides',zh?'质量指南':'Quality guides'],['/resources/downloads',zh?'文件检查表':'Document checklist']].map(([p,label])=><a href={local(p)}>{label} →</a>)}</div></aside>
  </div>
 </div>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:`https://zlbotanicals.com${c.url}`}))}).replace(/</g,'\\u003c')} />
</BaseLayout>
<style>
 .encyclopedia{color:#263a32}.knowledge-hero{background:#edf3ec;border-bottom:1px solid #d5e1d2;padding:2rem 0 3.5rem}.crumbs{display:flex;flex-wrap:wrap;gap:.4rem;font-size:.8rem;margin-bottom:2.5rem}.crumbs a{text-decoration:underline}.eyebrow{letter-spacing:.12em;font-size:.75rem;font-weight:700;color:#47623c;margin-bottom:1rem}h1{font-size:clamp(2rem,4.5vw,3.75rem);line-height:1.12;max-width:950px;font-weight:700;letter-spacing:-.025em}.intro{font-size:1.18rem;line-height:1.7;max-width:800px;margin-top:1.3rem}.scope{font-size:.85rem;max-width:800px;margin-top:1rem;color:#53644e}.knowledge-body{padding-top:2rem;padding-bottom:4rem}.section-tabs{display:flex;flex-wrap:wrap;gap:.65rem;margin:0 0 2.5rem}.section-tabs a{padding:.6rem .85rem;border:1px solid #b8cbb1;border-radius:6px;font-size:.85rem}.section-tabs a[aria-current],.section-tabs a:hover{background:#e6eee2}.reading{max-width:850px}.knowledge-body section{margin-bottom:3rem}h2{font-size:1.65rem;font-weight:700;line-height:1.35;margin-bottom:1rem}h3{font-size:1.18rem;font-weight:700;margin:1.3rem 0 .6rem}p{line-height:1.85;margin-bottom:1rem}.reading a,.references a{color:#345a27;text-decoration:underline;text-underline-offset:3px}.knowledge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.knowledge-card{display:block;padding:1.5rem;border:1px solid #d2ddcd;border-radius:10px;background:#fff;transition:background .15s}.knowledge-card:hover{background:#f2f6ef}.knowledge-card p{font-size:.95rem;color:#53604e}.card-number{font-size:.8rem;color:#607a50}.read-link{font-size:.85rem;font-weight:600;color:#345a27}.process-panel{padding:1.8rem;background:#f0f4ec;border-radius:12px}.process-flow{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.7rem;margin:1.5rem 0}.process-flow li{font-size:.85rem;overflow-wrap:anywhere}.process-flow span{display:block;width:2rem;height:2rem;background:#36582d;color:white;border-radius:50%;text-align:center;line-height:2rem;margin-bottom:.6rem}.reading ul{list-style:disc;padding-left:1.4rem;margin-bottom:1.2rem;line-height:1.9}.references{border-top:1px solid #d5dfd0;padding-top:2rem}.references ol{list-style:decimal;padding-left:1.4rem}.references li{margin:1.3rem 0}.references li p{font-size:.9rem;color:#55634e}.next-step{padding:2rem;border:1px solid #cbd9c5;border-radius:12px}.next-step .section-tabs{margin-bottom:0}details{border-bottom:1px solid #d6dfd2;padding:1rem 0}summary{font-weight:600;cursor:pointer}details p{margin-top:1rem}a:focus-visible,summary:focus-visible{outline:3px solid #587943;outline-offset:4px}@media(max-width:800px){.knowledge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.process-flow{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:520px){.knowledge-grid{grid-template-columns:1fr}.knowledge-hero{padding-bottom:2.2rem}.crumbs{margin-bottom:1.8rem}.process-flow{grid-template-columns:repeat(2,minmax(0,1fr))}.process-panel,.next-step{padding:1.25rem}.knowledge-card{padding:1.25rem}h2{font-size:1.4rem}}
</style>
