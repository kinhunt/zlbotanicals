---
import {getDeepIngredient} from '../data/deep-ingredients';
import {getIngredientOverview} from '../data/ingredient-overviews';
import ResearchInline from './ResearchInline.astro';
import {formulationSources, formulationConcepts, ingredientRoles, patentFamilies} from '../data/turmeric-formulations';
import type {Language} from '../i18n/config';
const {lang}=Astro.props as {lang:Language};
const zh=lang==='zh', k=getDeepIngredient('turmeric'), overview=getIngredientOverview('turmeric');
const namespace='research-b-turmeric-source';
const sections=k.content[lang];
const contents=[['identity',zh?'概览':'Overview'],['effects',zh?'作用与人体研究':'Effects and human research'],['components',zh?'原料形态':'Material forms'],['applications',zh?'终端应用与配方':'End products and formulation'],['formulations',zh?'终端产品配伍方案':'End-product combinations'],['patents',zh?'配方相关专利':'Formulation patents'],['processes',zh?'工艺与设备':'Processing and equipment'],['standards',zh?'质量与采购':'Quality and purchasing'],['faq',zh?'常见问题':'FAQ'],['insights',zh?'研究案例与参考文献':'Studies and references']];
const process=sections.find(s=>s.id==='processes')!;
const equipment=sections.find(s=>s.id==='equipment')!;
const insights=sections.find(s=>s.id==='insights')!;
const ordered=[sections.find(s=>s.id==='applications')!, {...process,heading:zh?'按目标形态选择工艺与设备':'Processing and equipment by target form'}, sections.find(s=>s.id==='standards')!,{id:'faq',heading:zh?'常见问题':'Frequently asked questions',blocks:insights.blocks.slice(0,6)},{...insights,heading:zh?'研究案例：材料与实验条件':'Study cases: materials and conditions',blocks:insights.blocks.slice(6)}];
const formulationNamespace='research-turmeric-formulation-source';
const sourceNamespace=(text:string)=>/\[(4|10)\]/.test(text)?namespace:formulationNamespace;
const clinicalNamespace='research-turmeric-clinical-source';
const clinicalSources=[{id:1,title:'Wang et al. (2020). Curcuma longa extract: knee symptoms and effusion-synovitis. DOI: 10.7326/M20-0990',url:'https://research.monash.edu/en/publications/effectiveness-of-curcuma-longa-extract-for-the-treatment-of-sympt'},{id:2,title:'Feng et al. (2022). Curcuminoids for knee osteoarthritis: systematic review of randomized trials. DOI: 10.1186/s12906-022-03740-9',url:'https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9580113/fullTextXML'}];
const applications=zh?[
 ['澄清饮料','以透明度为目标筛选经过配制的分散体系；不能把结晶色素直接当作水溶性原料。','在实际添加量、pH和热处理条件下测浊度、沉降、油圈及光照后的颜色。小液滴不保证透明。'],
 ['乳饮与植物饮','可从适合食品用途的分散液或分散粉试起，不透明基底能容纳一定浊度。','观察蛋白质、盐和酸度对体系的影响；检测热处理后及储存中的分层、粗粒与风味。'],
 ['胶囊与片剂','按目标姜黄素类量选择标准化提取物或配制粉；载体也占用填充体积。','用最终混合粉的实测含量计算装量，再评价流动性、填充均匀性、崩解或溶出。'],
 ['冲调粉','需要复水的产品可考虑含载体分散粉；香辛风味型冲饮也可使用姜黄粉。','测润湿时间、结团、杯底沉淀及储存后的复水变化；按相同色素量比较。'],
 ['酱料、调味料与烘焙食品','需要姜黄风味时考虑粉或油树脂；主要需要黄色时考虑色素或合适的配制形态。','检查油水分布、色泽均匀性、加工受热、风味和目标食品类别的使用要求。']
]:[
 ['Clear beverages','Screen formulated dispersions against a clarity target; crystalline pigment is not a water-soluble ingredient.','Measure haze, sediment, oil rings and light-exposed colour at the intended addition rate, pH and heat treatment. Small droplets do not guarantee clarity.'],
 ['Dairy and plant beverages','Start trials with a food-suitable dispersion or dispersible powder; an opaque base can accommodate some haze.','Check interactions with protein, salts and acidity, then separation, coarse particles and flavour after heating and storage.'],
 ['Capsules and tablets','Select a standardized extract or formulated powder around the intended curcuminoid amount; carriers also occupy fill volume.','Calculate fill mass from the final-blend assay. Evaluate flow, fill uniformity and disintegration or dissolution.'],
 ['Instant powders','Carrier-containing dispersible powders suit reconstitution trials; ground turmeric can suit a spice-led drink.','Measure wetting time, clumps, cup-bottom sediment and reconstitution after storage. Compare at equal pigment content.'],
 ['Sauces, seasonings and baked foods','Consider ground turmeric or oleoresin for spice character; consider pigment or a suitable formulated form when yellow colour is the main purpose.','Check oil/water distribution, colour uniformity, processing heat, flavour and the use requirements for the target food category.']
];
const forms=zh?[
 ['姜黄粉','根茎直接粉碎而成，仍含植物组织，是香辛料和提取起始物。'],
 ['姜黄油树脂','溶剂提取并除去溶剂后的组分，保留部分挥发油和树脂。'],
 ['结晶色素','通过纯化富集姜黄素类的橙黄色粉末，风味组分与油树脂不同。'],
 ['含载体分散粉','将色素与载体等辅料配制成粉体；含量需按最终混合粉计算。']
]:[
 ['Ground turmeric','Milled rhizomes retain plant tissue and serve as a spice or starting material for extraction.'],
 ['Turmeric oleoresin','A solvent extract after solvent removal, retaining some volatile oils and resins.'],
 ['Crystalline pigment','An orange-yellow powder enriched in curcuminoids by purification, with a different flavour fraction from oleoresin.'],
 ['Carrier-containing dispersible powder','Pigment formulated with carriers or other ingredients; its assay refers to the final blend.']
];
---
<div class="ingredient-knowledge turmeric-knowledge" data-ingredient-content="turmeric" data-deep-research={lang}>
 <section id="identity"><h2>{zh?'姜黄提取物是什么':'What is turmeric extract?'}</h2><p class="overview-value">{zh?'姜黄为食品提供金黄色泽与香辛风味，也用于研究型补充剂开发。饮料关注分散与口感，胶囊关注含量与装量，调味食品则需要平衡颜色和风味；这些用途对应不同原料形态。':'Turmeric brings golden colour and spice character to foods and is also used in research-led supplement development. Drinks depend on dispersion and mouthfeel, capsules on assay and fill mass, and seasoned foods on the balance of colour and flavour. Each calls for a different material form.'} <ResearchInline text="[10][11]" namespace={namespace}/></p><div id="raw-material"><p>{overview.identity[lang]} <ResearchInline text="[10][11]" namespace={namespace}/></p></div></section>
 <nav data-encyclopedia-toc data-research-toc aria-label={zh?'姜黄百科目录':'Turmeric encyclopedia contents'}><h2>{zh?'本页目录':'On this page'}</h2><ol>{contents.map(([id,label])=><li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
 <section id="effects"><h2>{zh?'食品作用与人体研究':'Food functions and human research'}</h2>
 <p><ResearchInline text={zh?'作为食品原料，姜黄粉和油树脂提供香辛风味，姜黄素类提供黄色。着色能力可以在配方中直接评价，它与人体健康终点是不同问题。[10][11]':'As food ingredients, ground turmeric and oleoresin contribute spice character, while curcuminoids provide yellow colour. Colour performance can be measured in a formulation; it is a different question from a health outcome.[10][11]'} namespace={namespace}/></p>
 <p><ResearchInline text={zh?'人体研究中，膝骨关节炎的疼痛与功能是已有随机试验和系统综述评价的方向。部分受试提取物在短期内减轻疼痛，但这不等于修复软骨，也不能把结果移用于姜黄饮料或任意商品原料。[1][2]':'Knee osteoarthritis pain and function are areas evaluated in randomized human trials and systematic reviews. Some tested extracts reduced pain over short periods. That does not establish cartilage repair or transfer the findings to a turmeric drink or an arbitrary commercial ingredient.[1][2]'} namespace={clinicalNamespace}/></p>
 <div class="research-table" role="region" tabindex="0" aria-label={zh?'人体研究结果对照':'Human evidence comparison'}><table data-clinical-evidence><caption>{zh?'人体研究：主要发现':'Human research: main findings'}<span class="table-hint">{zh?'窄屏可左右滚动；完整条件见下方展开框。':'Scroll on narrow screens; expand the study boxes below for conditions.'}</span></caption><thead><tr>{(zh?['材料与人群','时间与终点','主要发现']:['Material and population','Duration and endpoints','Main finding']).map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>
 <tr><th scope="row">{zh?'特定姜黄提取物胶囊；70名伴积液滑膜炎的症状性膝骨关节炎患者':'Specific turmeric-extract capsules; 70 people with symptomatic knee osteoarthritis and effusion-synovitis'}</th><td>{zh?'12周；疼痛视觉模拟量表（VAS）与MRI积液滑膜炎体积':'12 weeks; pain visual analogue scale (VAS) and MRI effusion-synovitis volume'}</td><td><ResearchInline text={zh?'疼痛较安慰剂改善；MRI积液滑膜炎体积和软骨成分未见改善。[1]':'Pain improved versus placebo; effusion-synovitis volume and cartilage composition did not.[1]'} namespace={clinicalNamespace}/></td></tr>
 <tr><th scope="row">{zh?'多种姜黄素类制剂；15项随机试验，1670名膝骨关节炎患者':'Various curcuminoid preparations; 15 randomized trials, 1,670 people with knee osteoarthritis'}</th><td>{zh?'4周至6个月；VAS与WOMAC疼痛、功能等量表':'4 weeks to 6 months; VAS and WOMAC pain, function and related scores'}</td><td><ResearchInline text={zh?'合并结果倾向于较安慰剂改善疼痛与功能；研究质量低、异质性大，部分分量表未达到作者设定的临床重要差异。[2]':'Pooled pain and function scores favoured curcuminoids over placebo. Low study quality and substantial heterogeneity limit certainty; some subscales did not meet the authors’ clinically important difference.[2]'} namespace={clinicalNamespace}/></td></tr>
 </tbody></table></div>
 <details data-study-box><summary>{zh?'展开：2020年随机试验的材料、结果与局限':'Expand: 2020 trial material, results and limitations'}</summary><p><ResearchInline text={zh?'Wang等在澳大利亚塔斯马尼亚开展单中心、双盲、安慰剂对照试验。36人接受姜黄提取物胶囊、34人接受安慰剂，每天2粒，持续12周。2022年综述表2将该制剂列为Turmacin Plus，每粒含500 mg由姜黄素类和姜黄多糖组成的根茎提取物；这是受试材料的描述，不是本页产品规格或服用建议。[1][2]':'Wang and colleagues conducted a single-centre, double-blind, placebo-controlled trial in Tasmania, Australia. Thirty-six participants received turmeric extract and 34 received placebo, two capsules daily for 12 weeks. Table 2 of the 2022 review identifies the preparation as Turmacin Plus, with 500 mg of rhizome extract containing curcuminoids and turmerosaccharides per capsule. This describes the study material, not this product’s specification or a dosing recommendation.[1][2]'} namespace={clinicalNamespace}/></p><p><ResearchInline text={zh?'两个主要终点是VAS膝痛变化和MRI积液滑膜炎体积变化。疼痛组间差为−9.1 mm（95%置信区间−17.8至−0.4）；积液滑膜炎体积组间差为3.2 mL（−0.3至6.8），未显示改善。WOMAC疼痛改善，但外侧股骨软骨T2弛豫时间未改善。不良事件发生率未见统计学差异（39%对53%）。样本量小、时间短，不能据此判断长期安全性；资助方包括塔斯马尼亚大学与Natural Remedies Private Limited。[1]':'The two primary endpoints were change in VAS knee pain and MRI effusion-synovitis volume. The between-group pain difference was −9.1 mm (95% CI −17.8 to −0.4); the effusion-synovitis difference was 3.2 mL (−0.3 to 6.8), with no improvement. WOMAC pain improved, but lateral femoral cartilage T2 relaxation time did not. Adverse-event incidence did not differ statistically (39% versus 53%). The small sample and short duration do not establish long-term safety. Funders included the University of Tasmania and Natural Remedies Private Limited.[1]'} namespace={clinicalNamespace}/></p></details>
 <details data-study-box><summary>{zh?'展开：2022年系统综述的材料与证据范围':'Expand: 2022 review formulations and evidence scope'}</summary><p><ResearchInline text={zh?'Feng等检索至2022年8月，纳入15项随机试验、1670名膝骨关节炎患者，随访4周至6个月。制剂包括普通提取物、含挥发油配方、脂质颗粒和纳米分散体系，不能视为同一种原料；2020年Wang试验也在其中，因此两行证据并非互相独立。对照包括安慰剂及布洛芬、双氯芬酸或对乙酰氨基酚。[2]':'Feng and colleagues searched through August 2022 and included 15 randomized trials with 1,670 knee osteoarthritis participants, followed for 4 weeks to 6 months. Preparations included conventional extracts, volatile-oil formulations, lipid particles and nano-dispersions rather than one interchangeable ingredient. The review includes the Wang 2020 trial, so the two evidence rows are not independent. Comparators included placebo, ibuprofen, diclofenac or paracetamol.[2]'} namespace={clinicalNamespace}/></p><p><ResearchInline text={zh?'安慰剂对照合并分析中，VAS疼痛和WOMAC总分达到作者设定的最小临床重要差异，WOMAC疼痛、功能和僵硬分量表未达到。原始研究质量低，剂量、制剂、基线与随访不同，且存在明显异质性。该综述支持继续研究短期症状改善，不能确定长期效果或哪种商品形态最佳。[2]':'In pooled placebo comparisons, VAS pain and total WOMAC exceeded the authors’ minimum clinically important differences, while WOMAC pain, function and stiffness subscales did not. Original studies had low quality, differing doses, formulations, baselines and follow-up, and substantial heterogeneity. The review supports further study of short-term symptom relief, not a conclusion about long-term benefit or the best commercial form.[2]'} namespace={clinicalNamespace}/></p></details>
 <p>{zh?'生物利用度描述成分进入体内的程度与过程。提高暴露量不自动意味着更好的健康结果；比较产品需要同一人群、对照、时间和临床终点的研究。分散稳定性、吸收数据与症状改善应分别阅读。':'Bioavailability describes how a constituent becomes available in the body. Increased exposure does not automatically mean better health outcomes: product comparisons need studies with comparable populations, controls, durations and clinical endpoints. Dispersion stability, absorption data and symptom improvement answer different questions.'}</p>
 </section>
 <section id="components"><figure class="concept-figure"><img src="/images/ingredients/turmeric-material-forms-concept.webp" alt={zh?'姜黄根茎、姜黄粉、油树脂与色素的概念对照':'Concept comparison of turmeric rhizomes, ground turmeric, oleoresin and pigment'} width="2172" height="724" loading="lazy"/><figcaption>{zh?'姜黄根茎、姜黄粉、油树脂与色素示意（AI绘制）。':'Turmeric rhizomes, ground turmeric, oleoresin and pigment (AI illustration).'}</figcaption></figure><h2>{zh?'主要成分与常见形态':'Principal components and common forms'}</h2><p>{overview.components[lang]} <ResearchInline text="[10][11]" namespace={namespace}/></p><div class="research-table" role="region" tabindex="0" aria-label={zh?'姜黄原料形态对照':'Turmeric material forms comparison'}><table class="forms-table"><caption>{zh?'四种形态的区别':'Four material forms compared'}<span class="table-hint">{zh?'窄屏可左右滚动；键盘聚焦后使用方向键。':'On narrow screens, scroll sideways or focus and use arrow keys.'}</span></caption><thead><tr><th scope="col">{zh?'形态':'Form'}</th><th scope="col">{zh?'组成与加工':'Composition and processing'}</th></tr></thead><tbody>{forms.map(([term,description])=><tr><th scope="row">{term}</th><td>{description}</td></tr>)}</tbody></table></div><p><ResearchInline text={zh?'姜黄粉与经过提取的原料有不同组成。所引JECFA规范中的结晶色素不溶于水；含载体的原料能分散于水，不表示色素分子已经溶解。[10][11]':'Ground turmeric differs in composition from extracted ingredients. The crystalline colour in the cited JECFA specification is insoluble in water; a carrier-containing ingredient can disperse without the pigment molecules dissolving.[10][11]'} namespace={namespace}/></p></section>
 {ordered.map(s=><section id={s.id} data-knowledge-dimension={s.id}>
  {(s.id==='processes'?['process']:s.id==='standards'?['specification']:s.id==='applications'?['application']:s.id==='insights'?['evidence']:[]).map(id=><span id={id} class="legacy-anchor" aria-hidden="true"/>)}
  <h2>{s.heading}</h2>
  {s.id==='processes'&&<><figure data-process-branches aria-labelledby="process-figure-title">
 <figcaption id="process-figure-title">{zh?'按目标形态选择路线':'Choose a route by the target form'} <ResearchInline text="[4][10]" namespace={namespace}/></figcaption>
 <div class="flow-start">{zh?'干燥根茎 → 粉碎':'Dried rhizomes → milling'}</div>
 <div class="flow-split">
  <div class="flow-option"><h3>{zh?'保留植物组织':'Retain plant tissue'}</h3><ol><li>{zh?'筛分':'Sieve'}</li><li><strong>{zh?'姜黄粉':'Ground turmeric'}</strong></li></ol></div>
  <div class="flow-option"><h3>{zh?'提取可溶性组分':'Extract soluble constituents'}</h3><ol><li>{zh?'溶剂提取与固液分离':'Solvent extraction and solid–liquid separation'}</li><li>{zh?'除去溶剂 → 油树脂':'Remove solvent → oleoresin'}</li><li>{zh?'需要富集色素时：选择性分离、结晶与干燥 → 结晶色素':'For enriched pigment: selective separation, crystallization and drying → crystalline pigment'}</li></ol></div>
 </div>
 <div class="flow-formulation"><h3>{zh?'分散型原料：进一步配制':'Dispersible forms: further formulation'}</h3><p>{zh?'选用提取物或色素，配合油相、乳化剂或载体，形成分散液；需要粉体时再选择干燥。':'Combine a selected extract or pigment with an oil phase, emulsifiers or carriers to form a dispersion; choose drying when a powder is needed.'}</p></div>
 <p class="figure-note">{zh?'分支表示不同产品选择；结晶、乳化与干燥按目标形态组合。':'Branches represent product choices; crystallization, emulsification and drying are combined according to the target form.'}</p>
</figure></>}
  {s.id==='applications'&&<><span id="end-products" class="legacy-anchor"/><p>{zh?'以下终端形态用于选择试配方向。先确定产品需要风味、颜色还是特定成分含量，再比较原料在实际配方中的表现。':'These end-product formats guide formulation trials. Decide whether the product needs flavour, colour or a specified constituent amount, then compare ingredients in the actual formulation.'}</p><figure class="concept-figure"><img src="/images/ingredients/turmeric-applications-concept.webp" alt={zh?'澄清饮料、金黄色乳饮、胶囊片剂、冲调粉与食品的概念图':'Concepts of clear drink, golden latte, capsules and tablets, instant powder and foods'} width="1672" height="941" loading="lazy"/><figcaption>{zh?'姜黄在饮料、冲调粉与胶囊中的应用示意（AI绘制）。':'Turmeric in drinks, instant powders and capsules (AI illustration).'}</figcaption></figure><div class="research-table" role="region" tabindex="0" aria-label={zh?'终端产品与原料选择':'End-product and material selection'}><table data-application-matrix><caption>{zh?'终端产品、原料选择与试配重点':'End products, material choices and formulation checks'}<span class="table-hint">{zh?'窄屏可左右滚动。':'Scroll sideways on narrow screens.'}</span></caption><thead><tr>{(zh?['产品形态','原料选择思路','主要配方难点']:['Product format','Material choice','Formulation hurdles']).map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{applications.map(row=><tr>{row.map((cell,j)=>j===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div><p><ResearchInline text={zh?'这些试配重点依据色素溶解性、油树脂组成及乳液研究提出；最终食品需要使用该用途允许的原辅料。[4][10][11]':'These formulation checks draw on pigment solubility, oleoresin composition and emulsion research; finished foods need ingredients permitted for the intended use.[4][10][11]'} namespace={namespace}/></p></>}
  {(s.id==='applications'?s.blocks.slice(0,2):s.blocks).map((b,i)=>b.type==='heading'?<h3 id={`research-turmeric-${s.id==='faq'?'insights':s.id}-${s.id==='insights'?i+6:i}`}>{b.text}</h3>:b.type==='paragraph'?<p><ResearchInline text={b.text} namespace={namespace}/></p>:b.type==='list'?<ul>{b.items.map(item=><li><ResearchInline text={item} namespace={namespace}/></li>)}</ul>:<div class="research-table" role="region" tabindex="0" aria-label={`${s.heading} — ${zh?'对照表':'comparison table'} ${i+1}`}><table><caption>{s.heading}<span class="table-hint">{zh?'左右滑动查看所有列；键盘可聚焦后使用方向键。':'Scroll horizontally to see all columns; focus this region to use arrow keys.'}</span></caption><thead><tr>{b.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{b.rows.map(row=><tr>{row.map((cell,j)=>j===0?<th scope="row"><ResearchInline text={cell} namespace={namespace}/></th>:<td><ResearchInline text={cell} namespace={namespace}/></td>)}</tr>)}</tbody></table></div>)}
 {s.id==='applications'&&<><section id="formulations"><h2>{zh?'终端产品配伍方案':'End-product combinations'}</h2>
 <p>{zh?'以下为依据文献提出的试配组合与检查顺序，尚需在目标产品中验证；调味搭配是开发选择，文献支持的是原料性质与载体加工原理。':'These trial combinations and checkpoints need testing in the target product. Flavour pairings are development choices; the cited sources support material properties and carrier-processing principles.'}</p>
 <div class="research-table" role="region" tabindex="0" aria-label={zh?'配伍成分与作用':'Combination ingredients and roles'}><table data-formulation-roles><caption>{zh?'原料配伍：各组分负责什么':'Ingredient combinations: what each component does'}<span class="table-hint">{zh?'窄屏可左右滚动；聚焦后可用方向键。':'Scroll sideways on narrow screens; focus to use arrow keys.'}</span></caption><thead><tr>{(zh?['组分','作用','相容性与加工限制']:['Component','Role','Compatibility and processing limits']).map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{ingredientRoles[lang].map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td><ResearchInline text={cell} namespace={sourceNamespace(cell)}/></td>)}</tr>)}</tbody></table></div>
 {formulationConcepts[lang].map(c=><article data-formulation-concept={c.id}><h3>{c.title}</h3><p>{c.combination}</p><p><ResearchInline text={c.basis} namespace={sourceNamespace(c.basis)}/></p><h4>{zh?'加入顺序与加工':'Addition order and processing'}</h4><p>{c.process}</p><h4>{zh?'感官与质量检查':'Sensory and quality checks'}</h4><p><ResearchInline text={c.checks} namespace={sourceNamespace(c.checks)}/></p></article>)}
 </section><section id="patents"><h2>{zh?'配方相关专利':'Formulation patents'}</h2>
