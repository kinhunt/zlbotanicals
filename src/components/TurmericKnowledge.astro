---
import {getDeepIngredient} from '../data/deep-ingredients';
import {getIngredientOverview} from '../data/ingredient-overviews';
import ResearchInline from './ResearchInline.astro';
import type {Language} from '../i18n/config';
const {lang}=Astro.props as {lang:Language};
const zh=lang==='zh', k=getDeepIngredient('turmeric'), overview=getIngredientOverview('turmeric');
const namespace='research-b-turmeric-source';
const sections=k.content[lang];
const contents=[['raw-material',zh?'定义与来源':'Definition and source'],['components',zh?'主要成分与形态':'Components and forms'],...sections.slice(0,2).map(s=>[s.id,s.heading]),['applications',zh?'应用与配方':'Applications and formulation'],['end-products',zh?'终端产品类别':'End-product categories'],...sections.slice(3).map(s=>[s.id,s.heading]),['research-turmeric-references',zh?'参考来源':'References']];
const forms=zh?[
 ['姜黄粉','根茎直接粉碎而成，仍含植物组织，是香辛料和提取起始物。'],
 ['姜黄油树脂','溶剂提取并除去溶剂后的组分，保留部分挥发油和树脂。'],
 ['结晶色素','通过纯化富集姜黄素类的橙黄色粉末，风味组分与油树脂不同。'],
 ['含载体分散粉','将色素与载体等辅料配制成粉体；含量需按最终混合粉计算。']
]:[
 ['Ground turmeric','Milled rhizomes retain plant tissue and serve as a spice or starting material for extraction.'],
 ['Turmeric oleoresin','A solvent extract after solvent removal, retaining some volatile oils and resins.'],
 ['Crystalline pigment','An orange-yellow powder enriched in curcuminoids by purification, with a different flavour fraction from oleoresin.'],
 ['Carrier-containing dispersible powder','Pigment formulated with carriers or other ingredients; its assay refers to the final blend.']
];
---
<div class="ingredient-knowledge turmeric-knowledge" data-ingredient-content="turmeric" data-deep-research={lang}>
 <section id="identity"><h2>{zh?'姜黄提取物是什么':'What is turmeric extract?'}</h2><div id="raw-material"><p>{overview.identity[lang]} <ResearchInline text="[10][11]" namespace={namespace}/></p></div></section>
 <nav data-encyclopedia-toc data-research-toc aria-label={zh?'姜黄百科目录':'Turmeric encyclopedia contents'}><h2>{zh?'本页目录':'On this page'}</h2><ol>{contents.map(([id,label])=><li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
 <section id="components"><h2>{zh?'主要成分与常见形态':'Principal components and common forms'}</h2><p>{overview.components[lang]} <ResearchInline text="[10][11]" namespace={namespace}/></p><div class="research-table" role="region" tabindex="0" aria-label={zh?'姜黄原料形态对照':'Turmeric material forms comparison'}><table class="forms-table"><caption>{zh?'四种形态的区别':'Four material forms compared'}<span class="table-hint">{zh?'窄屏可左右滚动；键盘聚焦后使用方向键。':'On narrow screens, scroll sideways or focus and use arrow keys.'}</span></caption><thead><tr><th scope="col">{zh?'形态':'Form'}</th><th scope="col">{zh?'组成与加工':'Composition and processing'}</th></tr></thead><tbody>{forms.map(([term,description])=><tr><th scope="row">{term}</th><td>{description}</td></tr>)}</tbody></table></div><p><ResearchInline text={zh?'姜黄粉与经过提取的原料有不同组成。所引JECFA规范中的结晶色素不溶于水；含载体的原料能分散于水，不表示色素分子已经溶解。[10][11]':'Ground turmeric differs in composition from extracted ingredients. The crystalline colour in the cited JECFA specification is insoluble in water; a carrier-containing ingredient can disperse without the pigment molecules dissolving.[10][11]'} namespace={namespace}/></p></section>
 {sections.map(s=><section id={s.id} data-knowledge-dimension={s.id}>
  {(s.id==='processes'?['process']:s.id==='standards'?['specification']:s.id==='applications'?['application']:s.id==='insights'?['evidence']:[]).map(id=><span id={id} class="legacy-anchor" aria-hidden="true"/>)}
  <h2>{s.heading}</h2>
  {s.id==='processes'&&<><figure data-process-branches aria-labelledby="process-figure-title">
 <figcaption id="process-figure-title">{zh?'按目标形态选择路线':'Choose a route by the target form'} <ResearchInline text="[4][10]" namespace={namespace}/></figcaption>
 <div class="flow-start">{zh?'干燥根茎 → 粉碎':'Dried rhizomes → milling'}</div>
 <div class="flow-split">
  <div class="flow-option"><h3>{zh?'保留植物组织':'Retain plant tissue'}</h3><ol><li>{zh?'筛分':'Sieve'}</li><li><strong>{zh?'姜黄粉':'Ground turmeric'}</strong></li></ol></div>
  <div class="flow-option"><h3>{zh?'提取可溶性组分':'Extract soluble constituents'}</h3><ol><li>{zh?'溶剂提取与固液分离':'Solvent extraction and solid–liquid separation'}</li><li>{zh?'除去溶剂 → 油树脂':'Remove solvent → oleoresin'}</li><li>{zh?'需要富集色素时：选择性分离、结晶与干燥 → 结晶色素':'For enriched pigment: selective separation, crystallization and drying → crystalline pigment'}</li></ol></div>
 </div>
 <div class="flow-formulation"><h3>{zh?'分散型原料：进一步配制':'Dispersible forms: further formulation'}</h3><p>{zh?'选用提取物或色素，配合油相、乳化剂或载体，形成分散液；需要粉体时再选择干燥。':'Combine a selected extract or pigment with an oil phase, emulsifiers or carriers to form a dispersion; choose drying when a powder is needed.'}</p></div>
 <p class="figure-note">{zh?'分支表示不同产品选择；结晶、乳化与干燥按目标形态组合。':'Branches represent product choices; crystallization, emulsification and drying are combined according to the target form.'}</p>
</figure><p>{overview.processChoices[lang]} <ResearchInline text="[4][10]" namespace={namespace}/></p></>}
  {s.id==='applications'&&<><p>{overview.applications[lang]}</p><div id="end-products"><p>{overview.endProducts[lang]}</p></div></>}
  {s.blocks.map((b,i)=>b.type==='heading'?<h3 id={`research-turmeric-${s.id}-${i}`}>{b.text}</h3>:b.type==='paragraph'?<p><ResearchInline text={b.text} namespace={namespace}/></p>:b.type==='list'?<ul>{b.items.map(item=><li><ResearchInline text={item} namespace={namespace}/></li>)}</ul>:<div class="research-table" role="region" tabindex="0" aria-label={`${s.heading} — ${zh?'对照表':'comparison table'} ${i+1}`}><table><caption>{s.heading}<span class="table-hint">{zh?'左右滑动查看所有列；键盘可聚焦后使用方向键。':'Scroll horizontally to see all columns; focus this region to use arrow keys.'}</span></caption><thead><tr>{b.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{b.rows.map(row=><tr>{row.map((cell,j)=>j===0?<th scope="row"><ResearchInline text={cell} namespace={namespace}/></th>:<td><ResearchInline text={cell} namespace={namespace}/></td>)}</tr>)}</tbody></table></div>)}
 </section>)}
 <section class="ingredient-sources" id="research-turmeric-references"><h2>{zh?'参考来源':'References'}</h2><ol>{k.sources.map(s=><li id={`${namespace}-${s.id}`} value={s.id}><span class="source-number">[{s.id}]</span> <a href={s.url} rel="noopener noreferrer">{s.title}</a> <span class="source-date">{zh?'查阅':'Accessed'} <time datetime={s.accessed}>{s.accessed}</time></span></li>)}</ol></section>
</div>
<style>
.turmeric-knowledge{max-width:850px;min-width:0;line-height:1.85;overflow-wrap:anywhere}.turmeric-knowledge section{scroll-margin-top:7rem;margin:2.5rem 0}.turmeric-knowledge h2{font-size:1.45rem;font-weight:700;margin:1.5rem 0 .8rem}.turmeric-knowledge h3{font-size:1.15rem;font-weight:650;margin:1.6rem 0 .65rem;scroll-margin-top:7rem}.turmeric-knowledge p{margin:.9rem 0}.turmeric-knowledge :global(a){color:#345a27;text-decoration:underline;overflow-wrap:anywhere}.turmeric-knowledge ol{list-style:decimal;padding-left:1.5rem}.turmeric-knowledge ul{list-style:disc;padding-left:1.5rem}.turmeric-knowledge li{margin:.6rem 0;scroll-margin-top:7rem}.turmeric-knowledge dt{font-weight:650}.turmeric-knowledge dl>div{margin:1rem 0}.scope{color:#53644e;font-size:.9rem}nav{background:#f3f6ef;border:1px solid #d8e1d0;border-radius:.6rem;padding:1rem 1.3rem}nav h2{margin-top:0!important}.research-table{max-width:100%;overflow-x:auto;margin:1.5rem 0;border:1px solid #d8e1d0;border-radius:.4rem}.research-table:focus-visible{outline:3px solid #345a27;outline-offset:3px}table{border-collapse:collapse;width:100%;min-width:580px;font-size:.92rem;line-height:1.65;overflow-wrap:normal;word-break:normal}caption{text-align:left;padding:.8rem;font-weight:600;background:#f3f6ef}th,td{padding:.75rem;text-align:left;vertical-align:top;border:1px solid #d8e1d0;min-width:120px}.table-hint{width:min(28rem,calc(100vw - 80px));display:block;font-weight:400;font-size:.85rem;margin-top:.35rem;max-width:28rem}.legacy-anchor,#end-products{display:block;scroll-margin-top:7rem}thead th{background:#edf2e6}tbody th{font-weight:600}tbody tr:nth-child(even){background:#f8faf5}.turmeric-knowledge .ingredient-sources ol{list-style:none;padding-left:0}.source-number{font-weight:650}@media(max-width:600px){.turmeric-knowledge h2{font-size:1.25rem}nav{padding:.7rem}th,td{padding:.6rem}}
.turmeric-knowledge{max-width:820px;margin-inline:auto;font-size:1.0625rem;line-height:1.9}.turmeric-knowledge h2{font-size:1.6rem;line-height:1.35}.turmeric-knowledge h3{line-height:1.45}.turmeric-knowledge section{margin:3.5rem 0}.turmeric-knowledge #identity{margin-top:0}.turmeric-knowledge nav ol{display:grid;grid-template-columns:1fr 1fr;column-gap:2rem;font-size:.95rem}.turmeric-knowledge nav li{margin:.25rem 0}.turmeric-knowledge :global(a:focus-visible){outline:3px solid #345a27;outline-offset:3px}.ingredient-sources{font-size:.9rem;line-height:1.65;border-top:1px solid #d8e1d0;padding-top:1.5rem}.source-date{display:block;color:#626d61;font-size:.8rem;margin-top:.3rem}figure{margin:1.5rem 0 2rem;border:1px solid #d8e1d0;border-radius:8px;padding:1.4rem;background:#fafbf8}figcaption{font-weight:650}.flow-start{margin-top:1rem;padding:.8rem;background:#eaf0e4;text-align:center;font-weight:600}.flow-split{display:grid;grid-template-columns:1fr 2fr;gap:1rem;padding-top:1.4rem}.flow-option{border-top:3px solid #809969;padding:.5rem .8rem;background:white}.turmeric-knowledge .flow-option h3,.turmeric-knowledge .flow-formulation h3{font-size:1rem;margin:.5rem 0}.flow-option ol{font-size:.92rem}.flow-formulation{border-left:3px solid #b49043;padding:.5rem 1rem;margin-top:1rem;background:#f7f3e8}.flow-formulation p,.figure-note{font-size:.9rem}.figure-note{color:#626d61}.forms-table{min-width:480px}.forms-table th:first-child{width:30%}@media(max-width:600px){.turmeric-knowledge{font-size:1rem}.turmeric-knowledge h2{font-size:1.35rem}.turmeric-knowledge nav ol,.flow-split{grid-template-columns:1fr}figure{padding:1rem}.turmeric-knowledge section{margin:2.5rem 0}}
</style>
