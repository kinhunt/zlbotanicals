---
import { getCollection } from 'astro:content';
import { type Language, getLocalizedPath } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import SectionHeader from '../common/SectionHeader.astro';
import Button from '../common/Button.astro';
import { Leaf } from '@lucide/astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Get products from Content Collections
const allProducts = await getCollection('products', ({ data }) => {
  return data.lang === lang && !data.draft;
});

// Show up to 6 featured products on homepage
const featuredProducts = allProducts.slice(0, 6);
---

<section class="section-padding bg-off-white">
  <div class="container-wide">
    <SectionHeader
      subtitle={t('products.subtitle')}
      title={t('products.title')}
    />

    <p class="text-sm text-gray-600 mb-6">{lang === 'zh' ? '图片为概念插画，非批次样品或规格。图中标签文字不构成纯度、等级或认证承诺；请以确认的现行 TDS 和批次 COA 为准。' : 'Images are concept illustrations, not batch samples or specifications. Printed label wording does not establish purity, grade or certification; confirm the current TDS and batch COA.'}</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProducts.map((ingredient) => (
        <a
          href={getLocalizedPath(`/products/${ingredient.slug.replace(`${lang}/`, '')}`, lang)}
          class="bg-white rounded-xl shadow-md hover:shadow-lg transition-all overflow-hidden group"
        >
          <div class="aspect-[3/2] relative overflow-hidden">
            {ingredient.data.image ? (
              <img
                src={ingredient.data.image}
                alt={`${ingredient.data.name} — ${lang === 'zh' ? '概念插画，非批次样品' : 'concept illustration, not a batch sample'}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
                <div class="w-16 h-16 text-primary/60 group-hover:scale-110 transition-transform">
                  <Leaf class="w-full h-full" strokeWidth={1.5} />
                </div>
              </div>
            )}
          </div>
          <div class="p-6">
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary transition-colors">
              {ingredient.data.name}
            </h3>
            {ingredient.data.latinName && (
              <p class="text-sm text-gray-500 italic mt-1">{ingredient.data.latinName}</p>
            )}
            {ingredient.data.description && (
              <p class="mt-2 text-gray-600 text-sm line-clamp-2">
                {ingredient.data.description}
              </p>
            )}
            <span class="inline-block mt-3 text-primary text-sm font-medium group-hover:translate-x-1 transition-transform">
              {t('products.viewProducts')} →
            </span>
          </div>
        </a>
      ))}
    </div>

    {allProducts.length > 6 && (
      <div class="mt-10 text-center">
        <Button href={getLocalizedPath('/products', lang)} variant="outline">
          {t('products.viewAll')} ({allProducts.length})
        </Button>
      </div>
    )}
  </div>
</section>
