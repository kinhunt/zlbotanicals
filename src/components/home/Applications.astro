---
import { getCollection } from 'astro:content';
import { type Language, getLocalizedPath } from '../../i18n/config';
import SectionHeader from '../common/SectionHeader.astro';
import { ArrowRight } from '@lucide/astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Get solutions for current language
const allSolutions = await getCollection('solutions', ({ data }) => {
  return data.lang === lang && !data.draft;
});

// Sort and take latest 4
const latestSolutions = allSolutions
  .sort((a, b) => b.slug.localeCompare(a.slug))
  .slice(0, 4);

const industryLabels: Record<string, Record<string, string>> = {
  en: {
    'beverages': 'Beverages',
    'nutraceuticals': 'Nutraceuticals',
    'cosmetics': 'Cosmetics',
    'food': 'Food',
  },
  zh: {
    'beverages': '饮料',
    'nutraceuticals': '保健品',
    'cosmetics': '化妆品',
    'food': '食品',
  },
};

const texts = {
  en: {
    subtitle: 'Solutions',
    title: 'Featured Product Solutions',
    viewDetails: 'View Details',
    viewAll: 'View All Solutions',
  },
  zh: {
    subtitle: '解决方案',
    title: '精选产品方案',
    viewDetails: '查看详情',
    viewAll: '查看全部方案',
  },
};

const t = texts[lang];
const solutionsPath = lang === 'zh' ? '/zh/solutions' : '/solutions';
---

{latestSolutions.length > 0 && (
  <section class="section-padding bg-gray-900">
    <div class="container-wide">
      <div class="flex justify-between items-end mb-10">
        <SectionHeader
          subtitle={t.subtitle}
          title={t.title}
          dark={true}
          align="left"
          class="mb-0"
        />
        <a
          href={solutionsPath}
          class="hidden md:inline-flex items-center gap-2 text-white/80 hover:text-white transition-colors"
        >
          {t.viewAll}
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {latestSolutions.map((solution) => (
          <article class="group bg-gray-800 rounded-xl overflow-hidden hover:bg-gray-700 transition-colors">
            {solution.data.image && (
              <a href={`${solutionsPath}/${solution.slug.replace(`${lang}/`, '')}`}>
                <img
                  src={solution.data.image}
                  alt={solution.data.name}
                  class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>
            )}
            <div class="p-5">
              <span class="px-2 py-1 bg-white/10 text-white/70 text-xs font-medium rounded">
                {industryLabels[lang][solution.data.industry]}
              </span>
              <h4 class="text-white font-semibold mt-3 line-clamp-2 group-hover:text-accent transition-colors">
                <a href={`${solutionsPath}/${solution.slug.replace(`${lang}/`, '')}`}>
                  {solution.data.name}
                </a>
              </h4>
              {solution.data.description && (
                <p class="text-white/60 text-sm mt-2 line-clamp-2">{solution.data.description}</p>
              )}
              <a
                href={`${solutionsPath}/${solution.slug.replace(`${lang}/`, '')}`}
                class="inline-flex items-center gap-1 text-accent text-sm mt-4 hover:gap-2 transition-all"
              >
                {t.viewDetails} <ArrowRight class="w-3 h-3" />
              </a>
            </div>
          </article>
        ))}
      </div>

      <a
        href={solutionsPath}
        class="md:hidden inline-flex items-center gap-2 text-white/80 hover:text-white transition-colors mt-6"
      >
        {t.viewAll}
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </section>
)}
