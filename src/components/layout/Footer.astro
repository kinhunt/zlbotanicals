---
import { getCollection } from 'astro:content';
import { type Language, getLocalizedPath } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import { getSiteNavigation } from '../../data/site-navigation';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Get products from Content Collections for products links
const products = await getCollection('products', ({ data }) => {
  return data.lang === lang && !data.draft;
});

const productLinks = products.map((ingredient) => ({
  label: ingredient.data.name,
  href: getLocalizedPath(`/products/${ingredient.slug.replace(`${lang}/`, '')}`, lang),
}));

const navItems = getSiteNavigation(t, (path) => getLocalizedPath(path, lang), productLinks);
---

<footer class="bg-primary text-white">
  <div class="container-wide py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <!-- Brand Column -->
      <div class="md:col-span-2 lg:col-span-3 xl:col-span-4">
        <a href={getLocalizedPath('/', lang)} class="text-2xl font-display font-bold">
          {t('site.name')}
        </a>
        <p class="mt-4 text-gray-300 text-sm leading-relaxed">
          {t('footer.description')}
        </p>
        <div class="mt-6 flex gap-4">
          <a
            href="https://www.linkedin.com/company/zlbotanicals"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <title>LinkedIn</title>
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <div class="relative group">
            <button
              type="button"
              class="text-gray-300 hover:text-white transition-colors cursor-pointer"
              aria-label="WeChat"
              title={lang === 'zh' ? '微信: zlbotanicals' : 'WeChat: zlbotanicals'}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <title>WeChat</title>
                <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.295.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 01.598.082l1.584.926a.272.272 0 00.14.045c.134 0 .246-.11.246-.245 0-.06-.024-.118-.04-.177l-.324-1.23a.493.493 0 01.177-.554c1.533-1.137 2.51-2.83 2.51-4.67 0-3.368-3.153-5.963-7.076-6.076zm-4.376 3.277c.535 0 .969.44.969.983a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.543.434-.983.969-.983zm4.866 0c.535 0 .969.44.969.983a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.543.434-.983.969-.983z"/>
              </svg>
            </button>
            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1.5 bg-gray-900 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
              {lang === 'zh' ? '微信: zlbotanicals' : 'WeChat: zlbotanicals'}
            </div>
          </div>
          <a
            href="mailto:info@zlbotanicals.com"
            class="text-gray-300 hover:text-white transition-colors"
            aria-label="Email"
            title="info@zlbotanicals.com"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <title>Email</title>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      {navItems.map((item) => (
        <div class="min-w-0">
          <h4 class="font-semibold text-lg mb-4">
            <a href={item.href} class="hover:underline focus-visible:outline-2 focus-visible:outline-white">{item.label}</a>
          </h4>
          {item.children && (
            <ul class="space-y-3">
              {item.children.map((link) => (
                <li>
                  <a href={link.href} class="text-gray-300 hover:text-white text-sm transition-colors break-words focus-visible:outline-2 focus-visible:outline-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {!item.children && (
            <a href={getLocalizedPath('/request-quote', lang)} class="text-gray-300 hover:text-white text-sm break-words focus-visible:outline-2 focus-visible:outline-white">{t('nav.requestQuote')}</a>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="container-wide py-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        {t('footer.copyright')}
      </p>
      <div class="flex gap-6 text-sm">
        <a href={getLocalizedPath('/privacy', lang)} class="text-gray-400 hover:text-white transition-colors">
          {t('footer.privacy')}
        </a>
        <a href={getLocalizedPath('/terms', lang)} class="text-gray-400 hover:text-white transition-colors">
          {t('footer.terms')}
        </a>
      </div>
    </div>
  </div>
</footer>
