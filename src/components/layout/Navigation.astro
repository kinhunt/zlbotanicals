---
import { getCollection } from 'astro:content';
import { type Language, getLocalizedPath } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import { getSiteNavigation } from '../../data/site-navigation';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Get products from Content Collections for products dropdown
const products = await getCollection('products', ({ data }) => {
  return data.lang === lang && !data.draft;
});

const productChildren = products.map((ingredient) => ({
  label: ingredient.data.name,
  href: getLocalizedPath(`/products/${ingredient.slug.replace(`${lang}/`, '')}`, lang),
}));

const navItems = getSiteNavigation(t, (path) => getLocalizedPath(path, lang), productChildren);
---

<nav aria-label={t('nav.mainNavigation')} class="hidden lg:flex items-center gap-2 xl:gap-4 2xl:gap-6 shrink-0">
  {navItems.map((item) => (
    <div class="relative group">
      <a
        href={item.href}
        class="flex items-center gap-0.5 xl:gap-1 whitespace-nowrap text-xs xl:text-sm font-medium text-gray-700 hover:text-primary transition-colors py-2 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4"
      >
        {item.label}
        {item.children && (
          <svg aria-hidden="true" class="w-3 h-3 xl:w-4 xl:h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        )}
      </a>

      {item.children && (
        <div class="absolute left-0 top-full w-64 max-h-[calc(100dvh-6rem)] overflow-y-auto bg-white rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 z-50">
          {item.children.map((child) => (
            <a
              href={child.href}
              class="block break-words px-4 py-2 text-sm focus-visible:outline-2 focus-visible:outline-primary focus-visible:-outline-offset-2 text-gray-700 hover:bg-gray-50 hover:text-primary first:rounded-t-lg last:rounded-b-lg"
            >
              {child.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}
</nav>
