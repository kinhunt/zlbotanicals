---
import data from '../data/market-v4.json';
const {lang,id}=Astro.props as {lang:'en'|'zh';id:string};
const zh=lang==='zh';
const chart=data.charts.find(c=>c.id===id)!;
const title=chart[`title_${lang}`],caption=chart[`caption_${lang}`];
const forms=Object.keys(data.labels.form) as (keyof typeof data.labels.form)[];
const materials=Object.keys(data.labels.material_claim) as (keyof typeof data.labels.material_claim)[];
const productLabel=(asin:string)=>{const p=data.products.find(p=>p.asin===asin)!;return `${p.brand} · ${asin}`;};
const sample=data.charts.find(c=>c.id==='sample-form')!;
const rows=id==='sample-form'? [...sample.rows].sort((a,b)=>b.count-a.count).map(r=>({label:r.form_label[lang],value:r.count,display:String(r.count),yoy:null})) : id==='retail-sales'?chart.rows.map(r=>({label:data.labels.channel[r.channel][lang],value:r.sales_usd,display:`${r.sales_usd.toLocaleString('en-US')} ${zh?'美元':'USD'}`,yoy:r.reported_yoy_percent})): id==='global-forecast'?chart.rows.map(r=>({label:`${r.year} · ${data.labels.status[r.status][lang]}`,value:r.value,display:zh?`${(r.value*10).toFixed(1)}亿美元`:`$${r.value.toFixed(2)} billion`,yoy:null})):[];
const max=id==='sample-form'?6:id==='retail-sales'?30000000:10;
---
<figure id={id} class="v4-exhibit">
 <figcaption><h3>{title}</h3></figcaption>
 {rows.length>0 && <div class="bars" aria-label={title}>{rows.map((r,i)=><div class="bar-row" data-value={r.value}>
  <div class="bar-label"><span>{r.label}</span><strong class="chart-value">{r.display}</strong></div>
  <svg viewBox="0 0 1000 24" aria-hidden="true" focusable="false" preserveAspectRatio="none"><rect x="0" y="0" width={r.value/max*1000} height="24" fill={id==='global-forecast'&&i===1?'#52665e':'#1b4d3e'}/></svg>
  {r.yoy!==null&&<p class="yoy">{zh?'同比':'YoY'} <strong>+{r.yoy}%</strong></p>}
 </div>)}<div class="axis" aria-hidden="true"><span>0</span><span>{id==='sample-form'?(zh?'6 个详情':'6 records'):id==='retail-sales'?(zh?'30,000,000 美元':'30,000,000 USD'):(zh?'100亿美元':'$10 billion')}</span></div></div>}
 {id==='dose-basis'&&<><div class="dose-pair"><div><strong class="chart-value">300 {zh?'毫克':'mg'}</strong><span>{data.labels.dose.extract_mass_mg[lang]}</span></div><div><strong class="chart-value">3,000 {zh?'毫克':'mg'}</strong><span>{data.labels.dose.dry_mushroom_equivalent_mg[lang]}</span></div></div><p class="equivalence">10:1 · {zh?'页面所述当量关系，不是功效倍数':'Listing-equivalence relationship, not a potency multiplier'}</p></>}
 {id==='material-format'&&<>
 <p class="matrix-hint">{zh?'按材料措辞与剂型交叉计数；各格可直达对应商品。':'Counts by material wording and format; each cell links to the observed products.'}</p>
 <div class="matrix-desktop" role="region" tabindex="0" aria-label={title}><table><caption>{zh?'18个详情；数字为观察条数':'18 detail records; numbers are observed counts'}</caption><thead><tr><th scope="col">{zh?'材料措辞':'Material wording'}</th>{forms.map(f=><th scope="col">{data.labels.form[f][lang]}</th>)}</tr></thead><tbody>{materials.map(m=><tr><th scope="row">{data.labels.material_claim[m][lang]}</th>{forms.map(f=>{const cell=chart.rows.find(r=>r.form===f&&r.material_claim===m);return <td data-material={m} data-form={f}>{cell?<details><summary>{cell.count}</summary>{cell.asins.map(a=><a href={`https://www.amazon.com/dp/${a}`}>{productLabel(a)}</a>)}</details>:<span aria-label={zh?'样本中无记录':'No records in this sample'}>—</span>}</td>;})}</tr>)}</tbody></table></div>
 <div class="matrix-mobile">{forms.map(f=><section class="format-card"><h4>{data.labels.form[f][lang]}</h4>{chart.rows.filter(r=>r.form===f).map(r=><div class="material-cell" data-material={r.material_claim} data-form={f}><p>{r.material_label[lang]} <strong class="chart-value">{r.count}</strong></p><ul>{r.asins.map(a=><li><a href={`https://www.amazon.com/dp/${a}`}>{productLabel(a)}</a></li>)}</ul></div>)}</section>)}</div>
 </>}
 <p class="source">{caption} {chart.source_ids.map(n=><a href={`#market-v4-ref-${n}`}>[{n}] </a>)} · {zh?'查阅：':'Accessed: '}<time datetime="2026-09-15">2026-09-15</time></p>
</figure>
<style>
.v4-exhibit{margin:2rem 0;padding:1.25rem;border:1px solid #cbd5e1;background:#fafbf9;color:#1f2937;font-variant-numeric:tabular-nums}.v4-exhibit h3{margin:0 0 1.25rem;font-size:1.35rem;line-height:1.4}.bar-row{margin:1rem 0}.bar-label{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.3rem 1rem;font-size:16px;margin-bottom:.4rem}#sample-form .bar-label{display:grid;grid-template-columns:minmax(0,1fr) auto}.chart-value,time{white-space:nowrap}svg{display:block;width:100%;height:22px}.axis{display:flex;justify-content:space-between;border-top:1px solid #64748b;font-size:14px;padding-top:.4rem}.v4-exhibit .source,.v4-exhibit .yoy,.matrix-hint,.equivalence{font-size:14px;line-height:1.65}.v4-exhibit .yoy{margin:.25rem 0}.v4-exhibit .source{color:#475569;margin:1rem 0 0}.dose-pair{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.dose-pair>div{border:1px solid #b9c9bd;background:#eef4ee;padding:1rem;display:flex;flex-direction:column;gap:.5rem}.dose-pair strong{font-size:1.7rem}.dose-pair span{font-size:15px}.matrix-desktop{overflow-x:auto;max-width:100%;font-size:14px}.matrix-desktop table{width:100%;min-width:740px;border-collapse:collapse}.matrix-desktop th,.matrix-desktop td{padding:8px;border:1px solid #d5dfd7;text-align:left;vertical-align:top;font-size:14px}.matrix-desktop th:first-child{min-width:180px;position:sticky;left:0;background:#f8f7f4;z-index:1}.matrix-desktop th:not(:first-child){min-width:82px;overflow-wrap:normal;word-break:normal}.matrix-desktop a{display:block;min-width:130px}.matrix-desktop summary{cursor:pointer;font-weight:700}.matrix-mobile{display:none}.format-card{border-top:1px solid #b9c9bd;padding:.75rem 0}.format-card h4{margin:0;font-size:1.1rem}.material-cell p{font-size:15px;margin:.75rem 0 .25rem}.material-cell ul{margin:0;padding-left:1.25rem;font-size:14px}.material-cell strong{float:right;margin-left:.5rem}.matrix-desktop:focus-visible,summary:focus-visible{outline:3px solid #1b4d3e;outline-offset:3px}@media(max-width:900px){.matrix-desktop{display:none}.matrix-mobile{display:block}}@media(max-width:600px){.v4-exhibit{padding:1rem}.dose-pair{grid-template-columns:1fr;grid-auto-rows:1fr}.dose-pair>div{min-height:115px}.v4-exhibit h3{font-size:1.2rem}}@media print{.matrix-desktop{display:none}.matrix-mobile{display:block}.v4-exhibit{background:white}}
</style>
