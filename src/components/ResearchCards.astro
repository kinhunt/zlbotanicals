---
import profiles from '../data/science-profiles.json';
import research from '../data/research.json';
import {applications} from '../data/research-facets';
import {getCollection} from 'astro:content';
import { getLocalizedPath, type Language } from '../i18n/config';
interface Props { lang: Language; products?: string[] }
const {lang,products=[]}=Astro.props;
const zh=lang==='zh';
const rows=research.filter(r=>r.status==='reviewed' && (!products.length || r.products.some(p=>products.includes(p))));
const ingredients=await getCollection('products',({data})=>data.lang===lang&&!data.draft);
const name=(slug:string)=>ingredients.find(p=>p.slug===`${lang}/${slug}`)?.data.name || slug;
const ingredientKeys=[...new Set(rows.flatMap(r=>r.products))];
const tags=(r:typeof rows[number])=>r.readingUses as (keyof typeof applications)[];
const applicationKeys=[...new Set(rows.flatMap(tags))];
const evidenceKeys=[...new Set(rows.map(r=>r.evidenceKey))];
const evidenceLabel=(key:string)=>rows.find(r=>r.evidenceKey===key)!.evidenceType[lang];
---
<section id="research" data-research-library data-lang={lang} data-research-total={rows.length} class="mt-12 space-y-6">
 <div><p class="text-sm uppercase tracking-widest text-primary">{zh?'文献 · 材料 · 边界':'Literature · materials · boundaries'}</p><h2 class="text-2xl font-bold mt-2">{zh?'研究阅读卡':'Research reading cards'}</h2><p class="mt-3 text-gray-600">{zh?'精选文献，不是实时检索或系统综述。编辑核查截至 2026-09-08；摘要层级阅读，不批准医疗或监管宣称。':'Selected literature, not a live feed or systematic review. Editorial check: 2026-09-08; abstract-level reading, not medical or regulatory claim approval.'}</p></div>
 {!products.length && <aside class="rounded-xl border p-5" data-clove-discovery><h3 class="text-lg font-semibold">{zh?'载体选型：初始水分活度与吸湿性':'Carrier selection: initial water activity and humidity uptake'}</h3><p class="mt-3">{zh?'丁香冻干包埋研究的六组数据，结合统计分组、丁香酚负载及跨原料比较的边界。':'Six formulations from a freeze-dried clove study, with statistical grouping, eugenol loading and limits on cross-material comparison.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/clove-powder-humidity',lang)}>{zh?'阅读完整研究分析 →':'Read the full research analysis →'}</a></aside>}
 {!products.length && <aside class="rounded-xl border p-5" data-gardenia-discovery><h3 class="text-lg font-semibold">{zh?'栀子蓝：已列用途与扩项申请':'Gardenia blue: listed uses and the expansion petition'}</h3><p class="mt-3">{zh?'有时间边界的美国食品用途分析：材料身份、大豆标签与更正规格。':'A dated US food-use analysis of material identity, soy labeling and corrected specifications.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/gardenia-blue-us-uses',lang)}>{zh?'阅读完整法规分析 →':'Read the full regulatory analysis →'}</a></aside>}
 {!products.length && <aside class="rounded-xl border p-5" data-carob-discovery><h3 class="text-lg font-semibold">{zh?'角豆粉替可可：焙度、配比与质构':'Carob powder for cocoa: roast, recipe basis and texture'}</h3><p class="mt-3">{zh?'区分商品定位与烘焙研究，按目标风味和配方基准选样。':'Distinguish retail positioning from baking evidence before choosing samples.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/carob-powder-cocoa-baking',lang)}>{zh?'阅读选型指南':'Read the selection guide'}</a></aside>}
  {!products.length && <aside class="rounded-xl border p-5" data-psyllium-discovery><h3 class="text-lg font-semibold">{zh?'洋车前子壳与无麸质面包：水量、比容与质构':'Psyllium in gluten-free bread: water, specific volume and texture'}</h3><p class="mt-3">{zh?'结合原料形态与三项面包研究，分开评价直接替换和配方优化。':'Compare material identity and three bread studies to separate replacement from reformulation.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/psyllium-gluten-free-bread-water',lang)}>{zh?'阅读面包研究分析':'Read the bread study analysis'}</a></aside>}
  {!products.length && <aside class="rounded-xl border p-5" data-hops-discovery><h3 class="text-lg font-semibold">{zh?'无醇啤酒酒花原料：补香、调苦与耐光':'Hops for alcohol-free beer: aroma, bitterness and light stability'}</h3><p class="mt-3">{zh?'按香气、苦味和光照异味防护区分原料，结合供应商资料与干投试验条件。':'Separate aroma, bittering and lightstruck-protection materials using supplier documentation and scoped dry-hopping evidence.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/hops-alcohol-free-beer-selection',lang)}>{zh?'阅读选型指南':'Read the selection guide'}</a></aside>}
  {!products.length && <aside class="rounded-xl border p-5" data-pumpkin-discovery><h3 class="text-lg font-semibold">{zh?'南瓜籽蛋白粉：冷压、细磨与冲调':'Pumpkin seed protein: cold pressing, milling and mixing'}</h3><p class="mt-3">{zh?'从三个商品样本与标签用量出发，分清加工描述与溶解性证据。':'Compare three retail examples and their label portions, separating processing descriptions from solubility evidence.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/pumpkin-seed-protein-processing',lang)}>{zh?'阅读样本与工艺分析':'Read the retail and processing analysis'}</a></aside>}
  {!products.length && <aside class="rounded-xl border p-5" data-sunflower-discovery><h3 class="text-lg font-semibold">{zh?'葵花籽蛋白：脱脂、粒度与去酚':'Sunflower protein: defatting, particle size and phenolic removal'}</h3><p class="mt-3">{zh?'区分供应商牌号定位与实验室乳液结果，按实际应用缩小选样范围。':'Separate supplier grade positioning from laboratory emulsion results to shortlist application-relevant samples.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/sunflower-protein-selection',lang)}>{zh?'阅读葵花籽蛋白选料分析':'Read the sunflower protein comparison'}</a></aside>}
  {!products.length && <aside class="rounded-xl border p-5" data-flax-discovery><h3 class="text-lg font-semibold">{zh?'亚麻籽粉与木脂素富集物：加工与生氰指标':'Flaxseed meal and lignan-rich extracts: processing and cyanogenic endpoints'}</h3><p class="mt-3">{zh?'分清糖苷、HCN 当量、浓度与回收率，比较不同物料的加工证据。':'Separate glycosides, HCN equivalents, concentration and recovery when comparing processed materials.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/flax-cyanogenic-material-selection',lang)}>{zh?'阅读亚麻籽选料分析':'Read the flaxseed material comparison'}</a></aside>}
  {!products.length && <aside class="rounded-xl border p-5" data-fenugreek-discovery><h3 class="text-lg font-semibold">{zh?'胡芦巴风味：香气、苦味与加工':'Fenugreek flavour: aroma, bitterness and processing'}</h3><p class="mt-3">{zh?'比较酊剂香气与饼干喜好研究，分清加工条件和感官终点。':'Compare tincture aroma and cookie liking studies without confusing processing conditions with sensory outcomes.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/fenugreek-flavour-processing',lang)}>{zh?'阅读胡芦巴风味分析':'Read the fenugreek flavour analysis'}</a></aside>}
 {!products.length && <aside class="rounded-xl border p-5" data-tamarind-discovery><h3 class="text-lg font-semibold">{zh?'罗望子籽胶：先选水化路线':'Tamarind seed gum: choose the hydration route'}</h3><p class="mt-3">{zh?'比较公开型号、黏度测试条件与实际食品工艺。':'Compare published grades, viscosity test conditions and the intended food process.'}</p><a class="inline-block underline text-primary mt-3" href={getLocalizedPath('/resources/blog/tamarind-grade-selection',lang)}>{zh?'阅读选型指南':'Read the selection guide'}</a></aside>}
 <details id="research-caveats" class="text-sm bg-gray-50 rounded-xl p-4"><summary class="cursor-pointer font-semibold">{zh?'共通阅读边界：非成品功效依据，无用量建议':'Shared reading limits: not finished-product efficacy evidence; no dose advice'}</summary><p class="mt-3">{research[0].limitations[lang]}</p><p class="mt-2">{research[0].doseContext[lang]}</p><p class="mt-2">{zh?'应用筛选表示文献的实际阅读用途，不表示原料适用性或当地法规许可。':'Application filters describe reading relevance, not material suitability or local authorization.'}</p></details>
 <p data-research-corpus class="text-sm text-gray-600">{zh?`本页 ${rows.length} 篇已核查条目`:`${rows.length} reviewed entries on this page`}: {evidenceKeys.map(key=>`${evidenceLabel(key)} (${rows.filter(r=>r.evidenceKey===key).length})`).join('; ')}</p>
 {!products.length && <div data-research-controls hidden class="rounded-xl border p-5">
  <div class="grid sm:grid-cols-3 gap-4">
   <label class="text-sm font-semibold">{zh?'原料':'Ingredient'}<select data-research-filter="ingredient" class="block w-full border rounded-lg p-3 mt-2"><option value="">{zh?'全部原料':'All ingredients'}</option>{ingredientKeys.map(p=><option value={p}>{name(p)}</option>)}</select></label>
   <label class="text-sm font-semibold">{zh?'应用 / 阅读用途':'Application / reading use'}<select data-research-filter="application" class="block w-full border rounded-lg p-3 mt-2"><option value="">{zh?'全部用途':'All reading uses'}</option>{applicationKeys.map(k=><option value={k}>{applications[k][lang]}</option>)}</select></label>
   <label class="text-sm font-semibold">{zh?'证据类型':'Evidence type'}<select data-research-filter="evidence" class="block w-full border rounded-lg p-3 mt-2"><option value="">{zh?'全部类型':'All evidence types'}</option>{evidenceKeys.map(key=><option value={key}>{evidenceLabel(key)}</option>)}</select></label>
  </div><div class="flex flex-wrap items-center gap-4 mt-4"><button type="button" data-research-reset class="border rounded-lg px-4 py-2 underline">{zh?'重置筛选':'Reset filters'}</button><p data-research-count role="status" aria-live="polite"></p></div>
 </div>}
 <p data-research-empty hidden class="p-5 bg-gray-50 rounded-xl">{zh?'没有符合组合条件的文献。请重置筛选或更换条件。':'No papers match these combined filters. Reset filters or change a selection.'}</p>
 <div class="grid md:grid-cols-2 gap-5">{rows.map((r)=><article data-research-card data-ingredient={r.products.join(' ')} data-application={tags(r).join(' ')} data-evidence={r.evidenceKey} class="border border-gray-200 rounded-xl p-5 bg-white min-w-0" id={r.id.replace(':','-')}>
  <p class="text-sm text-primary">{r.evidenceType[lang]} · {r.year}</p>
  <h3 class="text-lg font-semibold mt-2 break-words"><a href={r.sourceUrl} class="underline" rel="noopener noreferrer">{r.title}</a></h3>
  <p class="mt-3 text-sm text-gray-700">{r.scope[lang]}</p>
  <details data-evidence-details class="mt-4 text-sm"><summary class="cursor-pointer font-semibold text-primary">{zh?'展开材料、研究条件与来源':'Study material, context & sources'}</summary>
   <p class="text-gray-600 mt-3">{r.authors}</p><p class="mt-2 break-words">PMID: <a class="underline" href={r.sourceUrl}>{r.pmid}</a> · DOI: <a class="underline" href={`https://doi.org/${r.doi}`}>{r.doi}</a></p>
   <dl class="space-y-3 mt-4 leading-relaxed"><div><dt class="font-semibold">{zh?'物种与研究材料 / 特定边界':'Species & study material / specific limits'}</dt><dd>{r.material[lang]}</dd></div>{r.doseContext[lang]!==research[0].doseContext[lang]&&<div><dt>{zh?'研究条件':'Study context'}</dt><dd>{r.doseContext[lang]}</dd></div>}{r.limitations[lang]!==research[0].limitations[lang]&&<div><dt>{zh?'特定限制':'Specific limitations'}</dt><dd>{r.limitations[lang]}</dd></div>}</dl>
  </details>
  <div class="flex flex-wrap gap-3 mt-4">{r.products.map(p=><a class="underline text-primary text-sm" href={getLocalizedPath(`/products/${p}`,lang)}>{name(p)} →</a>)}</div>
  {r.products.filter(p=>profiles.some(s=>s.id===p)).map(p=><a class="inline-block mt-3 underline text-primary text-sm" href={getLocalizedPath(`/plant-extracts/ingredients/${p}`,lang)}>{zh?'对应原料科学档案':'Related ingredient science profile'} →</a>)}
 </article>)}</div>
 {products.length>0 && <a class="inline-block underline text-primary" href={getLocalizedPath('/resources/research',lang)}>{zh?'浏览全部研究与编辑方法':'All research & editorial method'} →</a>}
</section>
<script>
 for(const library of document.querySelectorAll<HTMLElement>('[data-research-library]')){
  const controls=library.querySelector<HTMLElement>('[data-research-controls]');
  if(!controls)continue;
  const selects=[...controls.querySelectorAll<HTMLSelectElement>('select')];
  const cards=[...library.querySelectorAll<HTMLElement>('[data-research-card]')];
  const count=library.querySelector<HTMLElement>('[data-research-count]');
  const empty=library.querySelector<HTMLElement>('[data-research-empty]');
  const update=()=>{
   let visible=0;
   for(const card of cards){
    card.hidden=!selects.every(select=>!select.value||(card.dataset[select.dataset.researchFilter!]?.split(' ') || []).includes(select.value));
    if(!card.hidden)visible++;
   }
   if(count)count.textContent=library.dataset.lang==='zh'?`显示 ${visible} / ${cards.length} 篇文献`:`Showing ${visible} of ${cards.length} papers`;
   if(empty)empty.hidden=visible>0;
  };
  selects.forEach(select=>select.addEventListener('change',update));
  controls.querySelector('[data-research-reset]')?.addEventListener('click',()=>{selects.forEach(select=>select.value='');update();});
  controls.hidden=false;
  update();
 }
</script>
