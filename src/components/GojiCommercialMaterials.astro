---
import {Content as English} from '../data/goji-commercial-materials/en.md';
import {Content as Chinese} from '../data/goji-commercial-materials/zh.md';
const {lang}=Astro.props;
---
<section id="goji-commercial-materials" data-goji-commercial-materials>
 {lang==='zh'?<Chinese/>:<English/>}
</section>
<!-- /goji-commercial-materials -->
<style>
 section { scroll-margin-top:6rem; overflow-wrap:anywhere; }
 section :global(h3) { font-size:1.45rem; font-weight:700; line-height:1.4; margin:2rem 0 1rem; }
 section :global(h4) { font-size:1.2rem; font-weight:650; line-height:1.5; margin:1.5rem 0 .75rem; }
 section :global(h5) { font-size:1.1rem; font-weight:650; line-height:1.5; margin:0 0 .75rem; }
 section :global([data-goji-reference-card]) { margin:1rem 0; padding:1.25rem; border:1px solid #d9e1d5; border-radius:.75rem; background:#fafbf8; }
 section :global([id]) { scroll-margin-top:6rem; }
 section :global(a) { text-decoration:underline; text-underline-offset:.15em; }
</style>
