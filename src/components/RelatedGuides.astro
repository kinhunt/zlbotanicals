---
import { getCollection } from 'astro:content';
import { getLocalizedPath, type Language } from '../i18n/config';
interface Props { lang: Language; productSlug?: string; industry?: 'beverages'|'food'|'cosmetics'|'nutraceuticals'; }
const {lang, productSlug, industry} = Astro.props;
const zh = lang === 'zh';
const posts = (await getCollection('blog', ({data}) => data.lang === lang && !data.draft))
  .filter(({data}) => productSlug ? data.relatedProducts.includes(productSlug) : industry ? data.relatedIndustries.includes(industry) : false)
  .sort((a,b) => b.data.publishDate.localeCompare(a.data.publishDate) || a.slug.localeCompare(b.slug));
---
<section class="mt-12 pt-8 border-t border-gray-200" aria-label={zh ? '相关技术指南' : 'Related technical guides'}>
  <h2 class="text-2xl font-display font-bold text-gray-900">{zh ? '相关技术与采购指南' : 'Related technical & sourcing guides'}</h2>
  {posts.length > 0 ? <div class="grid md:grid-cols-2 gap-5 mt-6">
    {posts.map(post => <article class="p-6 bg-off-white rounded-xl">
      <h3 class="text-lg font-semibold"><a class="text-primary hover:underline" href={getLocalizedPath(`/resources/blog/${post.slug.replace(`${lang}/`, '')}`,lang)}>{post.data.title}</a></h3>
      <p class="mt-3 text-gray-600">{post.data.description}</p>
    </article>)}
  </div> : <p class="mt-4 text-gray-600">{zh ? '可先从通用的规格、质量与采购资料开始，具体产品问题请提交需求。' : 'Start with general specification, quality and sourcing resources, and send your product-specific questions.'}</p>}
  <a class="inline-flex mt-6 text-primary font-semibold hover:underline" href={getLocalizedPath('/resources',lang)}>{zh ? '浏览全部技术与采购指南 →' : 'Browse all technical & sourcing resources →'}</a>
</section>
