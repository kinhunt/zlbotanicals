---
import { Leaf } from '@lucide/astro';

interface Props {
  name: string;
  latinName?: string;
  category: string;
  specification?: string;
  applications?: string[];
  href: string;
  image?: string;
  lang: 'en' | 'zh';
}

const { name, latinName, category, specification, applications, href, image, lang } = Astro.props;
const viewText = lang === 'zh' ? '查看详情' : 'View Details';
---

<div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-all duration-300 overflow-hidden group">
  <p class="text-xs text-gray-600 p-3">{lang === 'zh' ? '图片为概念插画，非批次样品或规格。图中标签文字不构成纯度、等级或认证承诺；请以确认的现行 TDS 和批次 COA 为准。' : 'Images are concept illustrations, not batch samples or specifications. Printed label wording does not establish purity, grade or certification; confirm the current TDS and batch COA.'}</p>
  <div class="aspect-[4/3] bg-gradient-to-br from-primary/10 via-cream to-primary/5 flex items-center justify-center relative overflow-hidden">
    {image ? (
      <img src={image} alt={`${name} — ${lang === 'zh' ? '概念插画，非批次样品' : 'concept illustration, not a batch sample'}`} class="w-full h-full object-cover" loading="lazy" />
    ) : (
      <div class="flex flex-col items-center justify-center text-primary/40 group-hover:text-primary/60 transition-colors">
        <Leaf class="w-16 h-16 mb-2" strokeWidth={1} />
        <span class="text-xs font-medium tracking-wide uppercase">{category}</span>
      </div>
    )}
    <!-- Decorative elements -->
    <div class="absolute top-3 right-3 w-2 h-2 rounded-full bg-accent/60"></div>
    <div class="absolute bottom-4 left-4 w-3 h-3 rounded-full bg-primary/20"></div>
  </div>
  <div class="p-6">
    <span class="text-xs font-medium text-accent uppercase tracking-wider">
      {category}
    </span>
    <h3 class="text-lg font-semibold text-gray-900 mt-2 group-hover:text-primary transition-colors">
      {name}
    </h3>
    {latinName && (
      <p class="text-sm text-gray-500 italic">{latinName}</p>
    )}
    {specification && (
      <p class="text-sm text-gray-600 mt-2">
        <span class="font-medium">{lang === 'zh' ? '规格：' : 'Spec:'}</span> {specification}
      </p>
    )}
    {applications && applications.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-3">
        {applications.slice(0, 3).map((app) => (
          <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">
            {app}
          </span>
        ))}
      </div>
    )}
    <div class="mt-4">
      <a
        href={href}
        class="text-sm font-medium text-primary hover:text-primary-dark inline-flex items-center gap-1 group-hover:gap-2 transition-all"
      >
        {viewText}
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</div>
