---
import {getDeepIngredient} from '../data/deep-ingredients';
import ResearchInline from './ResearchInline.astro';
import TurmericKnowledge from './TurmericKnowledge.astro';
import {getIngredientOverview} from '../data/ingredient-overviews';
import type {Language} from '../i18n/config';
const {productId,lang}=Astro.props as {productId:string;lang:Language};
const k=getDeepIngredient(productId);const zh=lang==='zh';
const overview=getIngredientOverview(productId);
const contents=[['raw-material',zh?'原料来源与部位':'Raw material & plant part'],['components',zh?'主要成分':'Components'],['applications',zh?'应用领域':'Application fields'],['end-products',zh?'终端产品示例':'Example end products'],['processes',zh?'按目标产品选择工艺':'Process choices by target product'],['equipment',zh?'设备':'Equipment'],['standards',zh?'质量与法规':'Quality & regulation'],['insights',zh?'研究与证据':'Research & evidence']];
const sections=k.content[lang];const namespace=`research-${k.group}-${productId}-source`;
---
{productId==='turmeric'?<TurmericKnowledge lang={lang}/>:<div class="ingredient-knowledge" data-ingredient-content={k.productId} data-deep-research={lang}>
 <section id="identity"><h2>{zh?'这是什么原料？':'What is this ingredient?'}</h2><p><ResearchInline text={overview.identity[lang]} namespace={namespace}/></p><p>{overview.applications[lang]}</p><p>{zh?'下列终端形态和工艺选择是基于所引资料提出的开发示例，不是真实品牌产品、已验证配方或本企业制造规格。':'The formats and process choices below are source-informed development examples, not real branded products, validated formulas or our manufacturing specifications.'} {overview.citations.map(n=><a href={`#${namespace}-${n}`}>[{n}] </a>)}</p></section>
 <nav data-encyclopedia-toc aria-label={zh?'原料百科目录':'Ingredient encyclopedia contents'}><h2>{zh?'本页目录':'On this page'}</h2><ol>{contents.map(([id,label])=><li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
 <section id="raw-material"><h2>{zh?'原料来源与部位':'Raw material & plant part'}</h2><p>{overview.identity[lang]}</p><p>{zh?'起始状态、鉴定依据与材料差异见下方有来源的工艺正文；不得将研究样品的身份直接套用于商品批次。':'Starting state, identification basis and material distinctions are documented in the sourced process discussion below; a study sample cannot establish a commercial batch’s identity.'}</p><a href="#processes">{zh?'查看材料与工艺证据':'Read material and process evidence'} →</a></section>
 <section id="components"><h2>{zh?'主要成分与材料区别':'Components & material distinctions'}</h2><p>{overview.components[lang]}</p><a href="#standards">{zh?'查看检测方法与质量边界':'Read assay methods and quality boundaries'} →</a></section>
 <p class="scope">{zh?'阅读说明：文献工况对应所述材料和尺度；工程建议供试验设计，不是本企业产线或通用生产规程。法规按所引日期、材料和用途理解，实际项目须核对现行要求。':'Reading guide: published conditions belong to the stated material and scale. Engineering proposals support trial design, not claims about our plant or universal operating procedures. Regulatory references are dated and material/use-specific; confirm current requirements for the actual project.'}</p>
 <nav data-research-toc aria-label={zh?'原料深度阅读目录':'Ingredient research contents'}><h2>{zh?'本页深度阅读':'Explore this research'}</h2><ol>{sections.map(s=><li><a href={`#${s.id}`}>{s.heading}</a>{s.blocks.some(b=>b.type==='heading')&&<ul>{s.blocks.map((b,i)=>b.type==='heading'&&<li><a href={`#research-${productId}-${s.id}-${i}`}>{b.text}</a></li>)}</ul>}</li>)}<li><a href={`#research-${productId}-references`}>{zh?'参考来源':'References'}</a></li></ol></nav>
 {[...sections].sort((a,b)=>contents.findIndex(c=>c[0]===a.id)-contents.findIndex(c=>c[0]===b.id)).map(s=><><section id={s.id} data-knowledge-dimension={s.id}>{(s.id==='processes'?['process']:s.id==='standards'?['specification']:s.id==='applications'?['application']:s.id==='insights'?['evidence']:[]).map(id=><span id={id} class="legacy-anchor" aria-hidden="true" />)}<h2>{s.heading}</h2>{s.id==='processes'&&<div class="process-choice-summary"><h3>{zh?'先选目标产品，再选路线':'Choose the target product before the route'}</h3><p>{overview.processChoices[lang]} {overview.citations.map(n=><a href={`#${namespace}-${n}`}>[{n}] </a>)}</p></div>}{s.blocks.map((b,i)=>b.type==='heading'?<h3 id={`research-${productId}-${s.id}-${i}`}>{b.text}</h3>:b.type==='paragraph'?<p><ResearchInline text={b.text} namespace={namespace}/></p>:b.type==='list'?<ul>{b.items.map(item=><li><ResearchInline text={item} namespace={namespace}/></li>)}</ul>:<div class="research-table" role="region" tabindex="0" aria-label={`${s.heading} — ${zh?'对照表':'comparison table'} ${i+1}`}><table><caption>{s.heading} · {zh?'对照表':'Comparison'} {i+1}<span class="table-hint">{zh?'左右滑动查看所有列；键盘可聚焦表格区域后使用方向键。':'Scroll horizontally to see all columns; keyboard users can focus this region and use arrow keys.'}</span></caption><thead><tr>{b.headers.map(h=><th scope="col"><ResearchInline text={h} namespace={namespace}/></th>)}</tr></thead><tbody>{b.rows.map(row=><tr>{row.map((cell,j)=>j===0?<th scope="row"><ResearchInline text={cell} namespace={namespace}/></th>:<td><ResearchInline text={cell} namespace={namespace}/></td>)}</tr>)}</tbody></table></div>)}</section>{s.id==='applications'&&<section id="end-products"><h2>{zh?'终端产品示例 · 开发概念':'Example end products · development concepts'}</h2><p>{overview.endProducts[lang]}</p><p>{overview.applications[lang]}</p><p>{zh?'这些是用于规划测试的类别示例，不是客户案例或获准上市清单；最终市场、配方与声称须单独复核。':'These categories support test planning, not customer cases or a list of authorized products; review the final market, formulation and claims separately.'}</p><a href="#applications">{zh?'查看各类应用的配方问题':'Read formulation questions by application'} →</a></section>}</>)}
 <section class="ingredient-sources" id={`research-${productId}-references`}><h2>{zh?'参考来源':'References'}</h2><ol>{k.sources.map(s=><li id={`${namespace}-${s.id}`} value={s.id}><a href={s.url} rel="noopener noreferrer">{s.title}</a> · {s.accessed}</li>)}</ol></section>
</div>}
<style>
.ingredient-knowledge{width:100%;max-width:850px;min-width:0;line-height:1.85;margin-top:2rem;overflow-wrap:anywhere}
.ingredient-knowledge section{scroll-margin-top:7rem;margin:2.5rem 0}.ingredient-knowledge h2{font-size:1.45rem;font-weight:700;margin:1.5rem 0 .8rem}.ingredient-knowledge h3{font-size:1.15rem;font-weight:650;margin:1.6rem 0 .65rem;scroll-margin-top:7rem}
.ingredient-knowledge p{margin:.9rem 0}.ingredient-knowledge :global(a){color:#345a27;text-decoration:underline;overflow-wrap:anywhere}.ingredient-knowledge ol{list-style:decimal;padding-left:1.5rem}.ingredient-knowledge ul{list-style:disc;padding-left:1.5rem}.ingredient-knowledge li{margin:.6rem 0;scroll-margin-top:7rem}.scope{color:#53644e;font-size:.9rem}
nav{background:#f3f6ef;border:1px solid #d8e1d0;border-radius:.6rem;padding:1rem 1.3rem}nav h2{margin-top:0!important}nav ul{font-size:.9rem}
.research-table{max-width:100%;overflow-x:auto;margin:1.5rem 0;border:1px solid #d8e1d0;border-radius:.4rem}.research-table:focus-visible{outline:3px solid #345a27;outline-offset:3px}table{border-collapse:collapse;width:100%;min-width:580px;font-size:.92rem;line-height:1.65}caption{text-align:left;padding:.8rem;font-weight:600;background:#f3f6ef}th,td{padding:.75rem;text-align:left;vertical-align:top;border:1px solid #d8e1d0;min-width:120px}.table-hint{display:block;font-weight:400;font-size:.85rem;margin-top:.35rem;max-width:28rem}.legacy-anchor{display:block;scroll-margin-top:7rem}table{overflow-wrap:normal;word-break:normal}thead th{background:#edf2e6}tbody th{font-weight:600}tbody tr:nth-child(even){background:#f8faf5}
@media(max-width:600px){.ingredient-knowledge h2{font-size:1.25rem}nav{padding:.7rem}th,td{padding:.6rem}}
</style>
