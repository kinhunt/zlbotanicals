---
import PageLayout from '../layouts/PageLayout.astro';
import { getLocalizedPath } from '../i18n/config';
const lang = 'en';
const cards = [
  {
    "title": "01 / Define material identity",
    "description": "Confirm botanical name, plant part, origin, extraction ratio or marker assay, solvent and carrier where relevant. A product name alone is not a complete specification.",
    "href": ""
  },
  {
    "title": "02 / Set acceptance criteria",
    "description": "Agree identity, assay, physical properties and relevant contaminant limits for your application and market. Confirm analytical methods and reporting units; include microbiology, metals, pesticides or residual solvents where required.",
    "href": ""
  },
  {
    "title": "03 / Review COA & samples",
    "description": "Distinguish a representative COA from a batch-specific COA. Check product code, lot number, dates, methods, limits and results. Evaluate the sample in your formulation; confirm whether it represents the supply batch.",
    "href": ""
  },
  {
    "title": "04 / Check certificates",
    "description": "Request applicable certificates and verify issuer, site, product scope and validity. Certification does not replace batch acceptance testing or market-specific regulatory review.",
    "href": "/about/certifications"
  },
  {
    "title": "05 / Agree release documents",
    "description": "Before ordering, confirm the batch COA, packaging, storage, shelf life, traceability information and any declarations needed for your market. Document which requirements are included in the quotation.",
    "href": ""
  },
  {
    "title": "06 / Resolve questions before release",
    "description": "If a result, method or document does not meet the agreed specification, resolve it before shipment. Buyers should assess suitability and regulatory status for their final product and destination.",
    "href": ""
  }
];
---
<PageLayout title="Quality & Documentation" description="Agree the specification before the purchase. A useful quality review connects the proposed ingredient, its manufacturing site, the test methods and the batch documents. Request a representative COA for initial review, then agree what must accompany the actual shipment." lang={lang} heroTitle="Quality & Documentation" heroSubtitle="Agree the specification before the purchase">
  <section class="section-padding">
    <div class="container-wide">
      <p class="text-lg md:text-xl leading-relaxed text-gray-600 max-w-4xl">A useful quality review connects the proposed ingredient, its manufacturing site, the test methods and the batch documents. Request a representative COA for initial review, then agree what must accompany the actual shipment.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {cards.map((card) => (
          <article class="p-7 rounded-xl bg-off-white border border-primary/10 hover:border-primary/30 transition-colors">
            <h2 class="text-xl font-display font-bold text-gray-900">{card.title}</h2>
            <p class="mt-4 text-gray-600 leading-relaxed">{card.description}</p>
            {card.href && <a href={getLocalizedPath(card.href, lang)} class="inline-flex mt-5 text-primary font-semibold hover:underline">Explore further →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-primary py-16">
    <div class="container-wide text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white">Start your product & document review</h2>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">Share the ingredient, specification, application, destination and expected quantity. Include your sample and document requirements; availability is confirmed per product.</p>
      <a href={getLocalizedPath('/request-quote', lang)} class="inline-flex mt-7 px-7 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent-dark transition-colors">Request Samples & COA</a>
      <a href={getLocalizedPath('/products', lang)} class="inline-flex mt-7 ml-4 px-7 py-3 border border-white/50 text-white rounded-lg font-semibold hover:bg-white/10">Explore Ingredients</a>
    </div>
  </section>
</PageLayout>
