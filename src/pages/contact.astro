---
import PageLayout from '../layouts/PageLayout.astro';
const lang = 'en';
---
<PageLayout title="Contact Us" description="Discuss an ingredient requirement or project brief" lang={lang} heroTitle="Contact Us" heroSubtitle="Discuss an ingredient requirement or project brief">
  <section class="section-padding"><div class="container-wide grid lg:grid-cols-2 gap-12">
    <div><h2 class="text-2xl font-semibold mb-5">Start with your requirements</h2>
      <p class="text-gray-600 mb-6">Include the ingredient, intended use, destination market, quantity and documents you need. Quotes, samples, supply and lead times require separate confirmation.</p>
      <a href="mailto:info@zlbotanicals.com" class="text-primary font-semibold underline break-all">info@zlbotanicals.com</a>
      <p class="mt-6 text-gray-600">You can email directly instead. If the form fails or you do not hear back, follow up using the same mailbox. Do not send sensitive personal information or confidential formulas.</p>
    </div>
    <div class="bg-off-white rounded-xl p-6 md:p-8">
      <h2 class="text-2xl font-semibold mb-5">Inquiry form</h2>
      <p id="form-disclosure" class="text-sm text-gray-600 mb-4">This form sends your information off this website to third-party FormSubmit for processing and forwarding by email. Email delivery and mailbox activation are not verified; do not rely on the form for urgent matters.</p>
      <p class="text-sm mb-6"><a href="/privacy" class="text-primary underline">Website privacy notice</a> · <a href="https://formsubmit.co/privacy.pdf" class="text-primary underline">FormSubmit privacy policy (external)</a></p>
      <form action="https://formsubmit.co/info@zlbotanicals.com" method="POST" aria-describedby="form-disclosure" class="space-y-5">
        <input type="hidden" name="_subject" value="ZL Botanicals — ingredient inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://zlbotanicals.com/thank-you" />
        <div><label for="contact-company" class="block font-medium mb-2">Company (optional)</label><input id="contact-company" name="company" type="text" autocomplete="organization" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus-visible:outline-primary" /></div>
<div><label for="contact-name" class="block font-medium mb-2">Name (required)</label><input id="contact-name" name="name" type="text" autocomplete="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus-visible:outline-primary" /></div>
<div><label for="contact-email" class="block font-medium mb-2">Email (required)</label><input id="contact-email" name="email" type="email" autocomplete="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus-visible:outline-primary" /></div>
<div><label for="contact-market" class="block font-medium mb-2">Destination market (optional)</label><input id="contact-market" name="market" type="text" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus-visible:outline-primary" /></div>
        <div><label for="contact-message" class="block font-medium mb-2">Requirements (required)</label>
          <textarea id="contact-message" name="message" rows="6" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus-visible:outline-primary"></textarea>
        </div>
        <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg">Send inquiry via FormSubmit</button>
      </form>
    </div>
  </div></section>
</PageLayout>
