---
import { getCollection } from 'astro:content';
import TurmericProcurementIntro from '../../../components/TurmericProcurementIntro.astro';
import ExtractSales from '../../../components/ExtractSales.astro';
import {getExtractSale,salesTitle} from '../../../data/extract-sales';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../../i18n/config';

const lang = 'zh';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => {
    return data.lang === 'zh' && !data.draft;
  });

  return products.map((product) => ({
    params: { slug: product.slug.replace('zh/', '') },
    props: { product },
  }));
}

const { product } = Astro.props;
const isTurmeric = product.slug === 'zh/turmeric';
const sale = getExtractSale(product.slug.replace('zh/',''));
const { Content } = await product.render();

---

<PageLayout title={isTurmeric ? '姜黄提取物采购：供应商、批量价格与 HPLC 规格' : sale ? salesTitle(sale,lang)+'：批量供应、价格与规格' : product.data.name} description={sale ? sale.offer[lang] : product.data.description} lang={lang}>
 <article class={sale ? 'sales-shell' : undefined}>
  <div class={isTurmeric ? 'turmeric-shell' : undefined}>
   <nav class="mb-8 text-sm" aria-label="面包屑"><a href={getLocalizedPath('/',lang)}>首页</a> / <a href={getLocalizedPath('/products',lang)}>产品</a> / {product.data.name}</nav>
   {sale ? <ExtractSales id={sale.id} lang={lang}/> : <><TurmericProcurementIntro lang={lang}/><div data-turmeric-procurement class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-gray-900 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-table:text-sm"><Content/></div></>}
  </div>
 </article>
</PageLayout>
<style>.sales-shell{max-width:1168px;margin:auto;padding:1.5rem 24px 4rem}@media(max-width:700px){.sales-shell{padding-inline:18px}}</style>
