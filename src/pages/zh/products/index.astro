---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../../i18n/config';
import { Leaf, ArrowRight } from '@lucide/astro';

const lang = 'zh';

// Get all products from Content Collections
const products = await getCollection('products', ({ data }) => {
  return data.lang === 'zh' && !data.draft;
});
---

<PageLayout
  title="产品中心"
  description="查看绿茶、积雪草、罗汉果、甘草等植物原料采购指南，比较规格与检测要求，申请样品和产品文件。"
  lang={lang}
  heroTitle="产品中心"
  heroSubtitle="为全球行业提供优质植物提取物"
>
  <section class="section-padding">
    <div class="container-wide">
      {products.length > 0 ? (
        <p class="text-sm text-gray-600 mb-6">{lang === 'zh' ? '图片为概念插画，非批次样品或规格。图中标签文字不构成纯度、等级或认证承诺；请以确认的现行 TDS 和批次 COA 为准。' : 'Images are concept illustrations, not batch samples or specifications. Printed label wording does not establish purity, grade or certification; confirm the current TDS and batch COA.'}</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((product) => (
            <a
              href={getLocalizedPath(`/products/${product.slug.replace('zh/', '')}`, lang)}
              class="group block bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow"
            >
              <div class="aspect-[4/3] overflow-hidden">
                {product.data.image ? (
                  <img
                    src={product.data.image}
                    alt={`${product.data.name} — 概念插画，非批次样品`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
                    <Leaf class="w-16 h-16 text-primary/30" strokeWidth={1} />
                  </div>
                )}
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-primary transition-colors">
                  {product.data.name}
                </h3>
                {product.data.latinName && (
                  <p class="text-sm text-gray-500 italic mt-1">{product.data.latinName}</p>
                )}
                {product.data.description && (
                  <p class="text-gray-600 mt-3 line-clamp-2">{product.data.description}</p>
                )}
                <span class="inline-flex items-center gap-1 mt-4 text-primary font-medium">
                  查看产品 <ArrowRight class="w-4 h-4" />
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <Leaf class="w-16 h-16 text-gray-300 mx-auto mb-4" strokeWidth={1} />
          <p class="text-gray-500">产品即将上线...</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-off-white">
    <div class="container-wide text-center">
      <h2 class="text-2xl font-display font-bold text-gray-900">寻找特定的提取物？</h2>
      <p class="text-gray-600 mt-3 max-w-2xl mx-auto">
        我们提供定制提取和配方服务。联系我们讨论您的需求。
      </p>
      <a
        href={getLocalizedPath('/contact', lang)}
        class="inline-block mt-6 px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors"
      >
        联系我们
      </a>
    </div>
  </section>
</PageLayout>
