---
import { getCollection } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import GuideList from '../../../../components/resources/GuideList.astro';
import { getLocalizedPath } from '../../../../i18n/config';
const lang = 'zh';
const posts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const products = await getCollection('products', ({ data }) => data.lang === lang && !data.draft);
---
<PageLayout title="全部指南归档" description="汇总植物原料、应用、质量与采购指南。浏览全部文章，或按原料筛选相关内容。" lang={lang} heroTitle="全部指南归档" heroSubtitle="植物原料、应用、质量与采购文章">
  <section class="section-padding"><div class="container-wide">
    <nav aria-label="面包屑导航" class="mb-8"><a href={getLocalizedPath('/resources', lang)} class="text-primary hover:underline">资源中心</a> / <span aria-current="page">全部指南归档</span></nav>
    <h2 class="text-2xl font-display font-bold mb-6">浏览全部文章</h2>
    <GuideList posts={posts} products={products} lang={lang} filterable />
  </div></section>
</PageLayout>
