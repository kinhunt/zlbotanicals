---
import { getCollection } from 'astro:content';
import TeaCostCalculator from '../../../../components/resources/TeaCostCalculator.astro';
import TeaHazeReader from '../../../../components/resources/TeaHazeReader.astro';
import CentellaStabilityReader from '../../../../components/resources/CentellaStabilityReader.astro';
import { guideCategories } from '../../../../data/resource-guides';
import PageLayout from '../../../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../../../i18n/config';
import { Calendar, Tag, ExternalLink, Leaf, Lightbulb } from '@lucide/astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.lang === 'zh' && !data.draft;
  });

  return posts.map((post) => ({
    params: { slug: post.slug.replace('zh/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const isCentellaStability = post.slug.endsWith('/centella-cold-process-stability');
const isCitrusBitterness = post.slug.endsWith('/citrus-delayed-bitterness');
const isCocoa = post.slug.endsWith('/cocoa-selection');
const isSchisandra = post.slug.endsWith('/schisandra-beverage-materials');
const isOatApple = ['oat-beta-glucan-material-selection', 'apple-extract-phloridzin-fibre-pectin'].some(slug => post.slug.endsWith('/' + slug));
const isOlivePectin = ['olive-leaf-beverage-encapsulation', 'citrus-pectin-gel-selection'].some(slug => post.slug.endsWith('/' + slug));
const isBotanicalComparison = ['butterfly-pea-protein-beverages', 'monk-fruit-specification-numbers'].some(slug => post.slug.endsWith('/' + slug));
const isBeetroot = ['beetroot-product-formats', 'beet-colour-plant-based-meat'].some(slug => post.slug.endsWith('/' + slug));
const isGinger = post.slug.endsWith('/ginger-selection');
const isPomegranate = post.slug.endsWith('/pomegranate-flavour-selection');
const isAcacia = post.slug.endsWith('/acacia-fibre-emulsification');
const isAstaxanthin = post.slug.endsWith('/astaxanthin-beverage-stability');
const isChicory = post.slug.endsWith('/chicory-fibre-selection');
const isVanillaAuthentication = post.slug.endsWith('/vanilla-authentication');
const isVanilla = post.slug.endsWith('/vanilla-material-choice');
const isCranberry = post.slug.endsWith('/cranberry-pac-purchasing');
const isCitrus = post.slug.endsWith('/hesperidin-material-choice');
const isHibiscus = post.slug.endsWith('/hibiscus-color-endpoints');
const isTigerNut = post.slug.endsWith('/tiger-nut-fermented-drinks');
const isCitrusFibre = post.slug.endsWith('/citrus-fibre-grade-process');
const isHops = post.slug.endsWith('/hops-alcohol-free-beer-selection');
const isPumpkin = post.slug.endsWith('/pumpkin-seed-protein-processing');
const isSunflower = post.slug.endsWith('/sunflower-protein-selection');
const isFlax = post.slug.endsWith('/flax-cyanogenic-material-selection');
const isFenugreek = post.slug.endsWith('/fenugreek-flavour-processing');
const isPsyllium = post.slug.endsWith('/psyllium-gluten-free-bread-water');
const isCarob = post.slug.endsWith('/carob-powder-cocoa-baking');
const isTamarind = post.slug.endsWith('/tamarind-grade-selection');
const isGardenia = post.slug.endsWith('/gardenia-blue-us-uses');
const isClove = post.slug.endsWith('/clove-powder-humidity');
const isSaffron = post.slug.endsWith('/saffron-identity');
const isTeaHaze = post.slug.endsWith('/tea-haze-diagnosis');
const isWaterSoluble = post.slug.endsWith('/water-soluble-green-tea-powder-or-liquid');
const lang = 'zh';

// Get related products
const allProducts = await getCollection('products', ({ data }) => {
  return data.lang === 'zh' && !data.draft;
});
const relatedProducts = allProducts.filter((product) =>
  post.data.relatedProducts?.includes(product.slug.replace('zh/', ''))
);

// Get related solutions
const allSolutions = await getCollection('solutions', ({ data }) => {
  return data.lang === 'zh' && !data.draft;
});
const relatedSolutions = allSolutions.filter((solution) =>
  post.data.relatedSolutions?.includes(solution.slug.replace('zh/', ''))
);

const guideCategory = guideCategories.find(category => category.slug === post.data.guideCategory)!;
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  heroTitle={post.data.title}
  heroSubtitle={guideCategory[lang].title}
>
  <article class:list={["section-padding", {"tiger-nut-reader": isTigerNut, "citrus-fibre-reader": isCitrusFibre, "hops-reader": isHops, "pumpkin-reader": isPumpkin, "sunflower-reader": isSunflower, "flax-reader": isFlax, "fenugreek-reader": isFenugreek, "psyllium-reader": isPsyllium, "carob-reader": isCarob, "tamarind-reader": isTamarind, "gardenia-reader": isGardenia, "clove-reader": isClove, "schisandra-reader": isSchisandra, "oat-apple-reader": isOatApple, "olive-pectin-reader": isOlivePectin, "botanical-comparison-reader": isBotanicalComparison, "beetroot-reader": isBeetroot, "ginger-reader": isGinger, "cocoa-reader": isCocoa, "pomegranate-reader": isPomegranate, "acacia-reader": isAcacia, "citrus-delayed-bitterness-reader": isCitrusBitterness, "astaxanthin-reader": isAstaxanthin, "chicory-reader": isChicory, "vanilla-authentication-reader": isVanillaAuthentication, "vanilla-material": isVanilla, "cranberry-pac": isCranberry, "citrus-material": isCitrus, "hibiscus-color": isHibiscus, "saffron-identity": isSaffron, "elderberry-material": post.slug.endsWith("/elderberry-material-selection"), "paprika-format": post.slug.endsWith("/paprika-extract-format-selection"), "sdil": post.slug.endsWith("/uk-sdil-milk-tea-2028"), "ginseng-heat": post.slug.endsWith("/ginseng-heat-bitterness"), "stevia-temporal": post.slug.endsWith("/stevia-temporal-sensory"), "water-soluble-reader": isWaterSoluble}]}>
    <div class="container-wide max-w-4xl">
      <!-- Breadcrumb -->
      <nav aria-label="面包屑导航" class="mb-8 text-sm">
        <ol class:list={["flex items-center gap-2 text-gray-500", {"flex-wrap": isTeaHaze || isCentellaStability}]}>
          <li><a href={getLocalizedPath('/', lang)} class="hover:text-primary">首页</a></li>
          <li>/</li>
          <li><a href={getLocalizedPath('/resources', lang)} class="hover:text-primary">资源中心</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={getLocalizedPath(`/resources/${guideCategory.slug}`, lang)} class="hover:text-primary">{guideCategory[lang].title}</a></li>
          <li>/</li>
          <li class="text-gray-900 truncate max-w-xs">{post.data.title}</li>
        </ol>
      </nav>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 mb-8">
        <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm font-medium">
          {guideCategory[lang].title}
        </span>
        <span class="text-gray-500 text-sm flex items-center gap-1">
          <Calendar class="w-4 h-4" />
          {post.data.publishDate}
        </span>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-8">
        {post.data.tags.map((tag) => (
          <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full flex items-center gap-1">
            <Tag class="w-3 h-3" />
            {tag}
          </span>
        ))}
      </div>

      <!-- Feature Image -->
      {post.data.image && (
        <div class="mb-10 rounded-2xl overflow-hidden shadow-lg">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-64 md:h-96 object-cover"
          />
        </div>
      )}

      {(isTigerNut || isSchisandra || isOatApple || isOlivePectin || isBeetroot || isBotanicalComparison) && <nav aria-label="文章语言" class="mb-8"><a class="text-primary underline" href={'/resources/blog/' + post.slug.replace('zh/', '')} lang="en">Read in English</a></nav>}

      {post.slug.endsWith('/green-tea-energy-beverage-2026') && <TeaCostCalculator lang={lang} />}
      <!-- Main Content -->
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-gray-900 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-table:text-sm">
        {isTeaHaze ? <TeaHazeReader lang={lang} headings={headings}><Content /></TeaHazeReader> : isCentellaStability ? <CentellaStabilityReader lang={lang} headings={headings}><Content /></CentellaStabilityReader> : <Content />}
      </div>

      <!-- Sources -->
      {post.data.sources && post.data.sources.length > 0 && (
        <div class="mt-12 p-6 bg-gray-50 rounded-xl">
          <h3 class="text-lg font-display font-bold text-gray-900 mb-4">数据来源</h3>
          <ul class="space-y-2">
            {post.data.sources.map((source, index) => (
              <li class="flex items-start gap-2">
                <span class="text-gray-400">[{index + 1}]</span>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline flex items-center gap-1"
                >
                  {source.title}
                  <ExternalLink class="w-3 h-3" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Related Products -->
      {relatedProducts.length > 0 && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h3 class="text-xl font-display font-bold text-gray-900 mb-6 flex items-center gap-2">
            <Leaf class="w-6 h-6 text-primary" />
            相关产品
          </h3>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedProducts.map((product) => (
              <a
                href={getLocalizedPath(`/products/${product.slug.replace('zh/', '')}`, lang)}
                class="group p-5 bg-off-white rounded-xl hover:shadow-md transition-shadow"
              >
                <h4 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
                  {product.data.name}
                </h4>
                {product.data.latinName && (
                  <p class="text-xs text-gray-500 italic mt-1">{product.data.latinName}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Solutions -->
      {relatedSolutions.length > 0 && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h3 class="text-xl font-display font-bold text-gray-900 mb-6 flex items-center gap-2">
            <Lightbulb class="w-6 h-6 text-accent" />
            相关解决方案
          </h3>
          <div class="grid md:grid-cols-2 gap-4">
            {relatedSolutions.map((solution) => (
              <a
                href={getLocalizedPath(`/solutions/${solution.slug.replace('zh/', '')}`, lang)}
                class="group p-6 bg-gradient-to-br from-accent/5 to-accent/10 rounded-xl hover:shadow-md transition-all"
              >
                <h4 class="font-semibold text-gray-900 group-hover:text-accent transition-colors">
                  {solution.data.name}
                </h4>
                {solution.data.description && (
                  <p class="text-sm text-gray-600 mt-2 line-clamp-2">{solution.data.description}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}

      {isAcacia && <nav aria-label="相关应用阅读" class="mt-12 border-t pt-8"><h2 class="text-xl font-semibold mb-4">相关应用阅读</h2><ul class="space-y-3"><li><a class="text-primary underline" href="/zh/solutions/food">食品应用</a></li><li><a class="text-primary underline" href="/zh/solutions/beverages">饮料应用</a></li></ul></nav>}

      <!-- CTA -->
      {!isTigerNut && !isCitrusFibre && !isHops && !isPumpkin && !isSunflower && !isFlax && !isFenugreek && !isPsyllium && !isCarob && !isTamarind && !isGardenia && !isClove && !isSchisandra && !isOatApple && !isOlivePectin && !isBotanicalComparison && !isBeetroot && !isGinger && !isCocoa && !isPomegranate && !isCitrusBitterness && !isAcacia && !isAstaxanthin && !isChicory && !isSaffron && !isHibiscus && !isCitrus && !isCranberry && !isVanilla && !isVanillaAuthentication && <div class="mt-12 p-8 bg-primary/5 rounded-2xl text-center">
        <h3 class="text-xl font-display font-bold text-gray-900">对我们的植物提取物感兴趣？</h3>
        <p class="text-gray-600 mt-2">联系我们获取样品、技术资料或定制配方支持。</p>
        <a
          href={getLocalizedPath('/contact', lang)}
          class="inline-block mt-4 px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors"
        >
          联系我们
        </a>
      </div>}
    </div>
  </article>
</PageLayout>

<style>
  .tiger-nut-reader :global(.prose) {max-width:820px;margin-inline:auto;line-height:1.85;overflow-wrap:anywhere}
  .tiger-nut-reader :global([id]) {scroll-margin-top:100px}
  .tiger-nut-reader :global(:focus-visible) {outline:3px solid #a77b16;outline-offset:3px}
  .tiger-nut-reader :global(.tiger-nut-table) {width:100%;table-layout:fixed;border-collapse:collapse}
  .tiger-nut-reader :global(.tiger-nut-table th), .tiger-nut-reader :global(.tiger-nut-table td) {padding:1rem;border:1px solid #d1d5db;vertical-align:top;font-size:16px;line-height:1.7}
  .tiger-nut-reader :global(.cell-value) {font-variant-numeric:tabular-nums}
  .tiger-nut-reader :global(.mobile-label) {display:none}
