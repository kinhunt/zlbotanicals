---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../../i18n/config';
import { Calendar, Tag, ArrowRight } from '@lucide/astro';

const lang = 'zh';

// Get all blog posts
const posts = await getCollection('blog', ({ data }) => {
  return data.lang === 'zh' && !data.draft;
});

// Sort by publish date descending
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const categoryLabels: Record<string, string> = {
  'market-insights': '市场洞察',
  'ingredient-spotlight': '原料聚焦',
  'industry-news': '行业新闻',
  'research': '研究报告',
};
---

<PageLayout title="资源中心" description="振隆药业资源中心：行业博客、产品目录、技术文档和常见问题。下载规格说明书，了解植物提取行业最新动态。" lang={lang} heroTitle="资源中心" heroSubtitle="为合作伙伴提供知识和下载">
  <!-- Resource Categories -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-8">
        <a href={getLocalizedPath('/resources/blog', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">博客</h3>
          <p class="mt-2 text-gray-600">行业洞察、产品聚焦和公司新闻。</p>
        </a>
        <a href={getLocalizedPath('/resources/downloads', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">下载中心</h3>
          <p class="mt-2 text-gray-600">产品目录、规格说明书和技术文档。</p>
        </a>
        <a href={getLocalizedPath('/resources/faq', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">常见问题</h3>
          <p class="mt-2 text-gray-600">关于产品和服务的常见问题解答。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="section-padding bg-off-white">
    <div class="container-wide">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-display font-bold text-gray-900">最新文章</h2>
        <a href={getLocalizedPath('/resources/blog', lang)} class="text-primary font-medium hover:underline">
          查看全部 →
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <article class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow">
            {post.data.image && (
              <a href={`/zh/resources/blog/${post.slug.replace('zh/', '')}`}>
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
            )}
            <div class="p-5">
              <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-accent/10 text-accent text-xs font-medium rounded">
                  {categoryLabels[post.data.category]}
                </span>
                <span class="text-gray-400 text-xs flex items-center gap-1">
                  <Calendar class="w-3 h-3" />
                  {post.data.publishDate}
                </span>
              </div>
              <h3 class="text-lg font-display font-bold text-gray-900 group-hover:text-primary transition-colors line-clamp-2">
                <a href={`/zh/resources/blog/${post.slug.replace('zh/', '')}`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-gray-600 text-sm mt-2 line-clamp-2">{post.data.description}</p>
              <a
                href={`/zh/resources/blog/${post.slug.replace('zh/', '')}`}
                class="inline-flex items-center gap-1 text-primary font-medium text-sm mt-3 hover:gap-2 transition-all"
              >
                阅读更多 <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </article>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <p class="text-gray-500 text-center py-8">暂无文章，敬请期待！</p>
      )}
    </div>
  </section>
</PageLayout>
