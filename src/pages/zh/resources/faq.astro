---
import PageLayout from '../../../layouts/PageLayout.astro';
const faqs = [{"q": "起订量是多少？", "a": "起订量取决于原料、规格、包装及当前供应情况。请告知首单数量和预计年用量，并在下单前取得书面确认。"}, {"q": "可以申请样品吗？", "a": "可提交评估需求。样品可用性、数量、费用、运费及是否抵扣货款均需单独确认，不作统一承诺。"}, {"q": "可以提供哪些认证？", "a": "请说明产品、所需认证和目标市场。文件以实际可提供情况为准，请核对发证主体、生产场地、产品范围及有效期；不可假定全部产品均覆盖某项认证。"}, {"q": "交期如何确定？", "a": "需结合规格、数量、库存或生产安排、检测及目的地评估。请提供期望到货时间，发货与运输时间应在采购前分别书面确认。"}, {"q": "如何索取 COA 和 TDS？", "a": "通过询盘表单选择文件类型，注明产品、规格及批号（如已知）。请核对检测方法与验收限值；文件以实际可提供情况为准。"}, {"q": "是否支持定制及特殊付款条件？", "a": "请提交目标规格、用途、目标市场和商务要求，以便评估可行性。能力、价格、付款方式及贸易条款均须书面确认。"}, {"q": "提交表单后会怎样？", "a": "表单交由第三方 FormSubmit 处理，本站不确认邮件已送达，也不承诺回复时限。如需其他方式，请直接发送邮件至 info@zlbotanicals.com。"}];
---
<PageLayout title="采购常见问题" lang="zh" heroTitle="采购常见问题" heroSubtitle="采购前需要确认的事项">
<section class="section-padding"><div class="container-wide max-w-3xl"><div class="space-y-6">{faqs.map(faq => (<div class="p-6 bg-off-white rounded-xl"><h2 class="font-semibold text-gray-900">{faq.q}</h2><p class="text-gray-600 mt-2">{faq.a}</p></div>))}</div><a href="/zh/request-quote" class="inline-block mt-8 px-6 py-3 bg-primary text-white rounded-lg">提交采购需求</a></div></section>
</PageLayout>
