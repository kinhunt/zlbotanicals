---
import PageLayout from '../../../layouts/PageLayout.astro';

const lang = 'zh';
---

<PageLayout title="博客" lang={lang} heroTitle="博客" heroSubtitle="行业洞察和公司新闻">
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center py-16">
        <p class="text-xl text-gray-600">博客内容即将上线。</p>
        <p class="mt-2 text-gray-500">请稍后查看行业洞察、产品聚焦和公司动态。</p>
      </div>
    </div>
  </section>
</PageLayout>
