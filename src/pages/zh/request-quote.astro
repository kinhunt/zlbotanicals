---
import PageLayout from '../../layouts/PageLayout.astro';

const lang = 'zh';
---

<PageLayout
  title="获取报价"
  lang={lang}
  heroTitle="获取报价"
  heroSubtitle="为您的植物原料需求获取优惠价格"
>
  <section class="section-padding">
    <div class="container-wide max-w-3xl">
      <form class="space-y-8" action="#" method="POST">
        <!-- Company Info -->
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-4">公司信息</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">公司名称 *</label>
              <input type="text" name="company" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">联系人 *</label>
              <input type="text" name="name" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">电子邮箱 *</label>
              <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">电话</label>
              <input type="tel" name="phone" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-2">国家/地区 *</label>
              <select name="country" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent bg-white">
                <option value="">请选择国家/地区</option>
                <option value="CN">中国</option>
                <option value="US">美国</option>
                <option value="JP">日本</option>
                <option value="KR">韩国</option>
                <option value="AU">澳大利亚</option>
                <option value="other">其他</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Product Requirements -->
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-4">产品需求</h3>
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">产品名称/规格 *</label>
              <input type="text" name="product" required placeholder="例如：甘草提取物 20% 甘草酸" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">预计年用量</label>
                <input type="text" name="volume" placeholder="例如：1000公斤/年" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">应用领域</label>
                <select name="application" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent bg-white">
                  <option value="">请选择应用领域</option>
                  <option value="nutraceuticals">保健品</option>
                  <option value="beverages">饮料</option>
                  <option value="food">食品</option>
                  <option value="cosmetics">化妆品</option>
                  <option value="other">其他</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">其他要求</label>
              <textarea name="requirements" rows="4" placeholder="任何特殊要求、所需认证等" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent resize-none"></textarea>
            </div>
          </div>
        </div>

        <button type="submit" class="w-full py-4 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors">
          提交报价请求
        </button>
      </form>
    </div>
  </section>
</PageLayout>
