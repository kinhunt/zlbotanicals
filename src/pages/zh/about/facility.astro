---
import PageLayout from '../../../layouts/PageLayout.astro';

const lang = 'zh';

const facilities = [
  { name: '7条GMP生产线', desc: '制药级生产标准' },
  { name: '24,000平方米', desc: '现代化生产与仓储设施' },
  { name: '20,000+吨产能', desc: '年原料加工能力' },
  { name: '先进实验室', desc: '内部质检与研发中心' },
];
---

<PageLayout
  title="生产设施"
  lang={lang}
  heroTitle="生产设施"
  heroSubtitle="位于中国广州的现代化生产基地"
>
  <section class="section-padding">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
        {facilities.map((facility) => (
          <div class="text-center p-6 bg-off-white rounded-xl">
            <h3 class="text-lg font-semibold text-gray-900">{facility.name}</h3>
            <p class="mt-2 text-gray-600 text-sm">{facility.desc}</p>
          </div>
        ))}
      </div>

      <div class="prose prose-lg max-w-none">
        <h2 class="text-2xl font-display font-bold text-gray-900 mb-4">生产卓越</h2>
        <p class="text-gray-600 leading-relaxed">
          我们的广州生产基地将传统植物提取专业知识与前沿提取技术相结合。每条生产线都经过精心设计，在确保产品质量和纯度的同时，保留植物原料的天然特性。
        </p>

        <h2 class="text-2xl font-display font-bold text-gray-900 mt-8 mb-4">质量控制</h2>
        <p class="text-gray-600 leading-relaxed">
          我们的内部实验室在生产的每个阶段进行严格检测，从原料检验到成品分析。我们采用HPLC、GC等先进分析方法，验证产品的身份、效价和纯度。
        </p>
      </div>
    </div>
  </section>
</PageLayout>
