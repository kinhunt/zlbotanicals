---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';

const lang = 'zh';

const certifications = [
  { name: 'GMP', desc: '药品生产质量管理规范' },
  { name: 'ISO 9001', desc: '质量管理体系' },
  { name: 'ISO 22000', desc: '食品安全管理体系' },
  { name: 'HACCP', desc: '危害分析与关键控制点' },
];

const processes = [
  { step: '01', title: '原料检验', desc: '每批原料均进行身份鉴定、纯度和污染物检测。' },
  { step: '02', title: '过程控制', desc: '提取过程中持续监控，确保质量稳定。' },
  { step: '03', title: '成品检测', desc: '包括HPLC、GC和微生物在内的全面分析。' },
  { step: '04', title: '放行与文档', desc: '每批产品均提供完整追溯性的检测报告。' },
];
---

<PageLayout
  title="品质保证"
  lang={lang}
  heroTitle="品质是我们的基石"
  heroSubtitle="生产每个环节的严格质量控制"
>
  <!-- Certifications -->
  <section class="section-padding bg-off-white">
    <div class="container-wide">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-8 text-center">资质认证</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {certifications.map((cert) => (
          <div class="bg-white p-6 rounded-xl text-center shadow-sm">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900">{cert.name}</h3>
            <p class="text-sm text-gray-600 mt-1">{cert.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Process -->
  <section class="section-padding">
    <div class="container-wide">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-8 text-center">质量控制流程</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {processes.map((process) => (
          <div class="relative">
            <span class="text-5xl font-display font-bold text-primary/10">{process.step}</span>
            <h3 class="text-lg font-semibold text-gray-900 mt-2">{process.title}</h3>
            <p class="text-gray-600 mt-2 text-sm">{process.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary py-16">
    <div class="container-wide text-center">
      <h3 class="text-2xl font-display font-bold text-white">需要质量文档？</h3>
      <p class="mt-4 text-gray-200">索取检测报告、认证文件或预约工厂审核。</p>
      <a href={getLocalizedPath('/contact', lang)} class="inline-block mt-6 px-8 py-3 bg-accent text-white rounded-lg font-medium hover:bg-accent-dark transition-colors">
        联系质量团队
      </a>
    </div>
  </section>
</PageLayout>
