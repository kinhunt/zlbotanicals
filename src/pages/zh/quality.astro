---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
const lang = 'zh';
const cards = [
  {
    "title": "01 / 明确原料身份",
    "description": "确认植物学名称、使用部位、原产地，以及适用的提取比例或指标成分含量、溶剂和载体。产品名称不能替代完整规格。",
    "href": ""
  },
  {
    "title": "02 / 约定验收标准",
    "description": "根据应用与市场要求，约定身份、含量、物理性质及相关污染物限值。确认检测方法与报告单位；按需纳入微生物、重金属、农残或溶剂残留要求。",
    "href": ""
  },
  {
    "title": "03 / 审核 COA 与样品",
    "description": "区分代表性 COA 与对应批次 COA，核对产品代码、批号、日期、方法、限值与结果。在实际配方中评估样品，并确认其是否代表拟供批次。",
    "href": ""
  },
  {
    "title": "04 / 核对证书",
    "description": "索取适用证书，审核签发机构、场地、产品范围与有效期。认证不能替代批次验收检测或特定市场的法规评估。",
    "href": "/about/certifications"
  },
  {
    "title": "05 / 确认放行文件",
    "description": "下单前确认批次 COA、包装、储存条件、保质期、追溯信息及目标市场所需声明，将适用要求写入报价与采购约定。",
    "href": ""
  },
  {
    "title": "06 / 放行前解决差异",
    "description": "若结果、方法或文件与约定规格不符，应在出货前解决。买家需根据终产品及目的地评估原料适用性与法规状态。",
    "href": ""
  }
];
---
<PageLayout title="质量与文件审核" description="采购前，先约定规格. 有效的质量审核应将拟供原料、生产场地、检测方法与批次文件联系起来。初步审核可索取代表性 COA，再约定实际出货批次应提供的文件。" lang={lang} heroTitle="质量与文件审核" heroSubtitle="采购前，先约定规格">
  <section class="section-padding">
    <div class="container-wide">
      <p class="text-lg md:text-xl leading-relaxed text-gray-600 max-w-4xl">有效的质量审核应将拟供原料、生产场地、检测方法与批次文件联系起来。初步审核可索取代表性 COA，再约定实际出货批次应提供的文件。</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {cards.map((card) => (
          <article class="p-7 rounded-xl bg-off-white border border-primary/10 hover:border-primary/30 transition-colors">
            <h2 class="text-xl font-display font-bold text-gray-900">{card.title}</h2>
            <p class="mt-4 text-gray-600 leading-relaxed">{card.description}</p>
            {card.href && <a href={getLocalizedPath(card.href, lang)} class="inline-flex mt-5 text-primary font-semibold hover:underline">查看详情 →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-primary py-16">
    <div class="container-wide text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white">开始产品与文件审核</h2>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">请提供原料、规格、应用、目的地及预计数量，并说明样品与文件要求。可供情况及文件范围按具体产品确认。</p>
      <a href={getLocalizedPath('/request-quote', lang)} class="inline-flex mt-7 px-7 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent-dark transition-colors">申请样品与 COA</a>
      <a href={getLocalizedPath('/products', lang)} class="inline-flex mt-7 ml-4 px-7 py-3 border border-white/50 text-white rounded-lg font-semibold hover:bg-white/10">浏览原料</a>
    </div>
  </section>
</PageLayout>
