---
import { getCollection } from 'astro:content';
import RelatedGuides from '../../components/RelatedGuides.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
import { Lightbulb, ArrowRight } from '@lucide/astro';

const lang = 'en';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => {
    return data.lang === 'en' && !data.draft;
  });

  return products.map((product) => ({
    params: { slug: product.slug.replace('en/', '') },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();

// Get related solutions
const allSolutions = await getCollection('solutions', ({ data }) => {
  return data.lang === 'en' && !data.draft;
});

const relatedSolutions = allSolutions.filter((solution) =>
  product.data.solutions?.includes(solution.slug.replace('en/', ''))
);
---

<PageLayout
  title={product.data.name}
  description={product.data.description}
  lang={lang}
  heroTitle={product.data.name}
  heroSubtitle={product.data.latinName}
>
  <article class="section-padding">
    <div class="container-wide max-w-4xl">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm">
        <ol class="flex items-center gap-2 text-gray-500">
          <li><a href={getLocalizedPath('/', lang)} class="hover:text-primary">Home</a></li>
          <li>/</li>
          <li><a href={getLocalizedPath('/products', lang)} class="hover:text-primary">Products</a></li>
          <li>/</li>
          <li class="text-gray-900">{product.data.name}</li>
        </ol>
      </nav>

      <!-- Feature Image -->
      {product.data.image && (
        <div class="mb-8 rounded-2xl overflow-hidden">
          <img
            src={product.data.image}
            alt={product.data.name}
            class="w-full h-64 md:h-80 object-cover"
          />
        </div>
      )}

      <!-- Meta tags -->
      <div class="flex flex-wrap gap-3 mb-8">
        {product.data.latinName && (
          <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium italic">
            {product.data.latinName}
          </span>
        )}
      </div>

      <!-- Main Content -->
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-gray-900 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-table:text-sm">
        <Content />
      </div>

      <RelatedGuides lang={lang} productSlug={product.slug.replace('en/', '')} />

      <!-- Related Solutions -->
      {relatedSolutions.length > 0 && (
        <div class="mt-16 pt-8 border-t border-gray-200">
          <h3 class="text-xl font-display font-bold text-gray-900 mb-6 flex items-center gap-2">
            <Lightbulb class="w-6 h-6 text-accent" />
            Application Solutions
          </h3>
          <div class="grid md:grid-cols-2 gap-4">
            {relatedSolutions.map((solution) => (
              <a
                href={getLocalizedPath(`/solutions/${solution.slug.replace('en/', '')}`, lang)}
                class="group p-6 bg-gradient-to-br from-accent/5 to-accent/10 rounded-xl hover:shadow-md transition-all"
              >
                <h4 class="font-semibold text-gray-900 group-hover:text-accent transition-colors">
                  {solution.data.name}
                </h4>
                {solution.data.description && (
                  <p class="text-sm text-gray-600 mt-2 line-clamp-2">{solution.data.description}</p>
                )}
                <span class="inline-flex items-center gap-1 mt-3 text-accent text-sm font-medium">
                  Learn more <ArrowRight class="w-4 h-4" />
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-12 p-8 bg-primary/5 rounded-2xl text-center">
        <h2 class="text-xl font-display font-bold text-gray-900">Evaluate this product for your purchase</h2>
        <p class="text-gray-600 mt-2">Specify the grade and target market. Samples and documents are subject to availability; order terms require written confirmation.</p>
        <div class="flex flex-wrap justify-center gap-3 mt-4">
          <a href={`${getLocalizedPath('/request-quote', lang)}?product=${encodeURIComponent(product.data.name)}&request=quote`} class="px-6 py-3 bg-primary text-white rounded-lg font-medium">Request quote</a>
          <a href={`${getLocalizedPath('/request-quote', lang)}?product=${encodeURIComponent(product.data.name)}&request=sample`} class="px-6 py-3 border border-primary text-primary rounded-lg font-medium">Ask about samples</a>
          <a href={`${getLocalizedPath('/request-quote', lang)}?product=${encodeURIComponent(product.data.name)}&request=COA`} class="px-6 py-3 border border-primary text-primary rounded-lg font-medium">Request COA / technical documents</a>
        </div>
      </div>
    </div>
  </article>
</PageLayout>
