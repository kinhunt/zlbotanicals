---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
import { Leaf, ArrowRight } from '@lucide/astro';

const lang = 'en';

// Get all products from Content Collections
const products = await getCollection('products', ({ data }) => {
  return data.lang === 'en' && !data.draft;
});
---

<PageLayout
  title="Products"
  description="Explore botanical ingredient sourcing guides for green tea, centella, monk fruit, licorice and more. Compare specification requirements and request samples and documents."
  lang={lang}
  heroTitle="Our Products"
  heroSubtitle="Premium botanical extracts for global industries"
>
  <section class="section-padding">
    <div class="container-wide">
      {products.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((product) => (
            <a
              href={getLocalizedPath(`/products/${product.slug.replace('en/', '')}`, lang)}
              class="group block bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow"
            >
              <div class="aspect-[4/3] overflow-hidden">
                {product.data.image ? (
                  <img
                    src={product.data.image}
                    alt={`${product.data.name} — ingredient diagram, not a batch sample`}
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
                    <Leaf class="w-16 h-16 text-primary/30" strokeWidth={1} />
                  </div>
                )}
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-primary transition-colors">
                  {product.data.name}
                </h3>
                {product.data.latinName && (
                  <p class="text-sm text-gray-500 italic mt-1">{product.data.latinName}</p>
                )}
                {product.data.description && (
                  <p class="text-gray-600 mt-3 line-clamp-2">{product.data.description}</p>
                )}
                <span class="inline-flex items-center gap-1 mt-4 text-primary font-medium">
                  View Products <ArrowRight class="w-4 h-4" />
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <Leaf class="w-16 h-16 text-gray-300 mx-auto mb-4" strokeWidth={1} />
          <p class="text-gray-500">Products coming soon...</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-off-white">
    <div class="container-wide text-center">
      <h2 class="text-2xl font-display font-bold text-gray-900">Looking for a specific extract?</h2>
      <p class="text-gray-600 mt-3 max-w-2xl mx-auto">
        We offer custom extraction and formulation services. Contact us to discuss your requirements.
      </p>
      <a
        href={getLocalizedPath('/contact', lang)}
        class="inline-block mt-6 px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors"
      >
        Contact Us
      </a>
    </div>
  </section>
</PageLayout>
