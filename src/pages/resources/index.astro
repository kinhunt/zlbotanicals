---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';

const lang = 'en';
---

<PageLayout title="Resources" description="ZL Botanicals resources: industry blog, product catalogs, technical documents, and FAQ. Download specification sheets and stay updated with botanical industry insights." lang={lang} heroTitle="Resources" heroSubtitle="Knowledge and downloads for our partners">
  <section class="section-padding">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-8">
        <a href={getLocalizedPath('/resources/blog', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">Blog</h3>
          <p class="mt-2 text-gray-600">Industry insights, product spotlights, and company news.</p>
        </a>
        <a href={getLocalizedPath('/resources/downloads', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">Downloads</h3>
          <p class="mt-2 text-gray-600">Product catalogs, specification sheets, and technical documents.</p>
        </a>
        <a href={getLocalizedPath('/resources/faq', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">FAQ</h3>
          <p class="mt-2 text-gray-600">Answers to common questions about our products and services.</p>
        </a>
      </div>
    </div>
  </section>
</PageLayout>
