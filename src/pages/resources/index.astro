---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
import { Calendar, Tag, ArrowRight } from '@lucide/astro';

const lang = 'en';

// Get all blog posts
const posts = await getCollection('blog', ({ data }) => {
  return data.lang === 'en' && !data.draft;
});

// Sort by publish date descending
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const categoryLabels: Record<string, string> = {
  'market-insights': 'Market Insights',
  'ingredient-spotlight': 'Ingredient Spotlight',
  'industry-news': 'Industry News',
  'research': 'Research',
};
---

<PageLayout title="Resources" description="ZL Botanicals resources: industry blog, product catalogs, technical documents, and FAQ. Download specification sheets and stay updated with botanical industry insights." lang={lang} heroTitle="Resources" heroSubtitle="Knowledge and downloads for our partners">
  <!-- Resource Categories -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-8">
        <a href={getLocalizedPath('/resources/blog', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">Blog</h3>
          <p class="mt-2 text-gray-600">Industry insights, product spotlights, and company news.</p>
        </a>
        <a href={getLocalizedPath('/resources/downloads', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">Downloads</h3>
          <p class="mt-2 text-gray-600">Product catalogs, specification sheets, and technical documents.</p>
        </a>
        <a href={getLocalizedPath('/resources/faq', lang)} class="p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
          <h3 class="text-xl font-semibold text-gray-900">FAQ</h3>
          <p class="mt-2 text-gray-600">Answers to common questions about our products and services.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="section-padding bg-off-white">
    <div class="container-wide">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-display font-bold text-gray-900">Latest Articles</h2>
        <a href={getLocalizedPath('/resources/blog', lang)} class="text-primary font-medium hover:underline">
          View All →
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <article class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow">
            {post.data.image && (
              <a href={`/resources/blog/${post.slug.replace('en/', '')}`}>
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
            )}
            <div class="p-5">
              <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-1 bg-accent/10 text-accent text-xs font-medium rounded">
                  {categoryLabels[post.data.category]}
                </span>
                <span class="text-gray-400 text-xs flex items-center gap-1">
                  <Calendar class="w-3 h-3" />
                  {post.data.publishDate}
                </span>
              </div>
              <h3 class="text-lg font-display font-bold text-gray-900 group-hover:text-primary transition-colors line-clamp-2">
                <a href={`/resources/blog/${post.slug.replace('en/', '')}`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-gray-600 text-sm mt-2 line-clamp-2">{post.data.description}</p>
              <a
                href={`/resources/blog/${post.slug.replace('en/', '')}`}
                class="inline-flex items-center gap-1 text-primary font-medium text-sm mt-3 hover:gap-2 transition-all"
              >
                Read more <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </article>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <p class="text-gray-500 text-center py-8">No posts yet. Check back soon!</p>
      )}
    </div>
  </section>
</PageLayout>
