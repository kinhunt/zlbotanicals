---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import GuideList from '../../../components/resources/GuideList.astro';
import { getLocalizedPath } from '../../../i18n/config';
const lang = 'en';
const posts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const products = await getCollection('products', ({ data }) => data.lang === lang && !data.draft);
---
<PageLayout title="All Guides Archive" description="All botanical ingredient, application, quality and sourcing guides in one archive. Browse existing articles or filter by ingredient." lang={lang} heroTitle="All Guides Archive" heroSubtitle="All botanical ingredient, application, quality and sourcing guides in one archive. Browse existing articles or filter by ingredient.">
  <section class="section-padding"><div class="container-wide">
    <nav aria-label="Breadcrumb" class="mb-8"><a href={getLocalizedPath('/resources', lang)} class="text-primary hover:underline">Resources</a> / <span aria-current="page">All Guides Archive</span></nav>
    <h2 class="text-2xl font-display font-bold mb-6">Browse all articles</h2>
    <GuideList posts={posts} products={products} lang={lang} filterable />
  </div></section>
</PageLayout>
