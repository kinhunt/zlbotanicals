---
import PageLayout from '../../layouts/PageLayout.astro';

const lang = 'en';
---

<PageLayout title="Blog" lang={lang} heroTitle="Blog" heroSubtitle="Industry insights and company news">
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center py-16">
        <p class="text-xl text-gray-600">Blog content coming soon.</p>
        <p class="mt-2 text-gray-500">Check back for industry insights, product spotlights, and company updates.</p>
      </div>
    </div>
  </section>
</PageLayout>
