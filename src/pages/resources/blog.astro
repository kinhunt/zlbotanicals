---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
import { Calendar, Clock, ArrowRight } from '@lucide/astro';

const lang = 'en';

const posts = [
  {
    title: 'Understanding Licorice Root Extract: Benefits and Applications',
    excerpt: 'Explore the versatile applications of Glycyrrhiza glabra extract in nutraceuticals, beverages, and cosmetics. Learn about standardization and quality considerations.',
    date: '2025-01-15',
    readTime: '5 min read',
    category: 'Product Spotlight',
  },
  {
    title: '2025 Trends in Botanical Ingredients for Functional Beverages',
    excerpt: 'The functional beverage market continues to grow. Discover which botanical extracts are driving innovation in energy drinks, wellness teas, and adaptogenic beverages.',
    date: '2025-01-08',
    readTime: '7 min read',
    category: 'Industry Insights',
  },
  {
    title: 'Quality Control in Botanical Extract Manufacturing',
    excerpt: 'An inside look at how GMP-certified facilities ensure consistency, purity, and safety in botanical extract production. From raw material testing to final product analysis.',
    date: '2024-12-20',
    readTime: '6 min read',
    category: 'Quality',
  },
  {
    title: 'Green Tea Extract: EGCG and Beyond',
    excerpt: 'Green tea extract is one of the most researched botanical ingredients. Learn about polyphenol standardization, catechin profiles, and application considerations.',
    date: '2024-12-10',
    readTime: '8 min read',
    category: 'Product Spotlight',
  },
  {
    title: 'Sustainable Sourcing: Our Commitment to Responsible Botanicals',
    excerpt: 'How ZL Botanicals works with growers to ensure sustainable harvesting practices and maintain the long-term availability of precious botanical resources.',
    date: '2024-11-28',
    readTime: '4 min read',
    category: 'Company News',
  },
  {
    title: 'Turmeric and Curcumin: Optimizing Bioavailability',
    excerpt: 'Curcumin faces bioavailability challenges. Explore different extract formats and delivery technologies that enhance absorption and efficacy.',
    date: '2024-11-15',
    readTime: '6 min read',
    category: 'Product Spotlight',
  },
];

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<PageLayout
  title="Blog"
  description="ZL Botanicals blog: industry insights, product spotlights, and botanical extract news. Learn about licorice, green tea, turmeric extracts and quality manufacturing."
  lang={lang}
  heroTitle="Blog"
  heroSubtitle="Industry insights and company news"
>
  <section class="section-padding">
    <div class="container-wide">
      <!-- Featured Post -->
      <div class="mb-12">
        <article class="bg-off-white rounded-2xl overflow-hidden">
          <div class="grid md:grid-cols-2 gap-0">
            <div class="aspect-[4/3] md:aspect-auto bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center">
              <div class="text-primary/30 text-center p-8">
                <div class="text-6xl font-display font-bold">ZL</div>
                <div class="text-sm mt-2 uppercase tracking-wider">Featured Article</div>
              </div>
            </div>
            <div class="p-8 md:p-10 flex flex-col justify-center">
              <span class="text-accent text-sm font-medium uppercase tracking-wider">{posts[0].category}</span>
              <h2 class="text-2xl md:text-3xl font-display font-bold text-gray-900 mt-3">
                {posts[0].title}
              </h2>
              <p class="text-gray-600 mt-4 leading-relaxed">
                {posts[0].excerpt}
              </p>
              <div class="flex items-center gap-4 mt-6 text-sm text-gray-500">
                <span class="flex items-center gap-1">
                  <Calendar class="w-4 h-4" />
                  {formatDate(posts[0].date)}
                </span>
                <span class="flex items-center gap-1">
                  <Clock class="w-4 h-4" />
                  {posts[0].readTime}
                </span>
              </div>
              <a href="#" class="inline-flex items-center gap-2 mt-6 text-primary font-medium hover:text-primary-dark transition-colors group">
                Read Article
                <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        </article>
      </div>

      <!-- Post Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.slice(1).map((post) => (
          <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden group">
            <div class="aspect-[16/9] bg-gradient-to-br from-primary/10 to-cream flex items-center justify-center">
              <span class="text-primary/20 text-xs font-medium uppercase tracking-wider">{post.category}</span>
            </div>
            <div class="p-6">
              <span class="text-accent text-xs font-medium uppercase tracking-wider">{post.category}</span>
              <h3 class="text-lg font-semibold text-gray-900 mt-2 group-hover:text-primary transition-colors line-clamp-2">
                {post.title}
              </h3>
              <p class="text-gray-600 text-sm mt-3 line-clamp-3">
                {post.excerpt}
              </p>
              <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
                <span class="text-xs text-gray-500">{formatDate(post.date)}</span>
                <span class="text-xs text-gray-500">{post.readTime}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Newsletter CTA -->
      <div class="mt-16 p-8 md:p-12 bg-primary rounded-2xl text-center">
        <h3 class="text-2xl font-display font-bold text-white">Stay Updated</h3>
        <p class="text-gray-200 mt-3 max-w-xl mx-auto">
          Subscribe to our newsletter for the latest botanical industry insights, product updates, and exclusive content.
        </p>
        <form class="mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 px-4 py-3 rounded-lg text-gray-900 focus:ring-2 focus:ring-accent focus:outline-none"
          />
          <button type="submit" class="px-6 py-3 bg-accent text-white rounded-lg font-medium hover:bg-accent-dark transition-colors whitespace-nowrap">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </section>
</PageLayout>
