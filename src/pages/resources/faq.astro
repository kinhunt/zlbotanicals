---
import PageLayout from '../../layouts/PageLayout.astro';
const faqs = [{"q": "What is the minimum order quantity?", "a": "MOQ depends on the ingredient, grade, packaging and current supply. Share your first order quantity and annual estimate; obtain written confirmation before ordering."}, {"q": "Can I request a sample?", "a": "Submit your evaluation requirements. Sample availability, quantity, fees, freight and any credit against a later order must be agreed individually."}, {"q": "Which certifications are available?", "a": "Specify the product, required standard and market. Copies are subject to availability. Verify the entity, production site, scope and validity; do not assume a certification covers every product."}, {"q": "How is delivery timing established?", "a": "Timing depends on grade, quantity, stock or production scheduling, testing and destination. Share your desired arrival date; confirm dispatch and transit assumptions separately in writing."}, {"q": "How do I request a COA or TDS?", "a": "Choose the document request type in the inquiry form and provide product, grade and batch if known. Review methods and acceptance limits; documents are subject to availability."}, {"q": "Can I request custom specifications or payment terms?", "a": "Send the target specification, application, market and commercial requirements for feasibility review. Capability, pricing, payment methods and trade terms require written agreement."}, {"q": "What happens after I submit?", "a": "The form is processed by third-party FormSubmit. This site does not verify email receipt or promise a response time. You can instead email info@zlbotanicals.com directly."}];
---
<PageLayout title="Purchasing FAQ" lang="en" heroTitle="Purchasing FAQ" heroSubtitle="What to confirm before purchase">
<section class="section-padding"><div class="container-wide max-w-3xl"><div class="space-y-6">{faqs.map(faq => (<div class="p-6 bg-off-white rounded-xl"><h2 class="font-semibold text-gray-900">{faq.q}</h2><p class="text-gray-600 mt-2">{faq.a}</p></div>))}</div><a href="/request-quote" class="inline-block mt-8 px-6 py-3 bg-primary text-white rounded-lg">Send purchasing requirements</a></div></section>
</PageLayout>
