---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';

const lang = 'en';

const faqs = [
  { q: 'What is your minimum order quantity (MOQ)?', a: 'MOQ varies by product. For samples, we can provide 100g-1kg. For production orders, typical MOQ is 25-100kg depending on the product.' },
  { q: 'Do you provide samples?', a: 'Yes, we provide samples for evaluation. Sample fees may apply and are typically credited toward your first order.' },
  { q: 'What certifications do you have?', a: 'We hold GMP, ISO 9001, ISO 22000, and HACCP certifications. Select products also have Halal and Kosher certification.' },
  { q: 'What is your lead time?', a: 'Standard products typically ship within 2-3 weeks. Custom formulations may require 4-6 weeks depending on specifications.' },
  { q: 'Do you offer custom formulations?', a: 'Yes, our R&D team can develop custom extracts, blends, and formulations to meet your specific requirements.' },
  { q: 'What payment terms do you accept?', a: 'We accept T/T, L/C, and other payment methods. Terms are discussed during the quotation process.' },
];
---

<PageLayout title="FAQ" lang={lang} heroTitle="Frequently Asked Questions" heroSubtitle="Answers to common questions">
  <section class="section-padding">
    <div class="container-wide max-w-3xl">
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="p-6 bg-off-white rounded-xl">
            <h3 class="font-semibold text-gray-900">{faq.q}</h3>
            <p class="text-gray-600 mt-2">{faq.a}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-gray-600">
        Have more questions? <a href={getLocalizedPath('/contact', lang)} class="text-primary font-medium hover:underline">Contact us</a>
      </p>
    </div>
  </section>
</PageLayout>
