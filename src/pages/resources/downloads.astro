---
import PageLayout from '../../layouts/PageLayout.astro';

const lang = 'en';

const downloads = [
  { name: 'Product Catalog 2025', desc: 'Complete list of our botanical extracts and powders', size: 'PDF, 2.5 MB' },
  { name: 'Company Profile', desc: 'Overview of ZL Botanicals capabilities and certifications', size: 'PDF, 1.2 MB' },
];
---

<PageLayout title="Downloads" lang={lang} heroTitle="Downloads" heroSubtitle="Technical documents and catalogs">
  <section class="section-padding">
    <div class="container-wide max-w-3xl">
      <div class="space-y-4">
        {downloads.map((doc) => (
          <div class="p-6 bg-off-white rounded-xl flex items-center justify-between">
            <div>
              <h3 class="font-semibold text-gray-900">{doc.name}</h3>
              <p class="text-sm text-gray-600 mt-1">{doc.desc}</p>
              <span class="text-xs text-gray-500">{doc.size}</span>
            </div>
            <button class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
              Download
            </button>
          </div>
        ))}
      </div>
      <p class="mt-8 text-gray-500 text-sm text-center">
        Need additional documents? <a href="/contact" class="text-primary hover:underline">Contact us</a> for COAs, specifications, or custom documentation.
      </p>
    </div>
  </section>
</PageLayout>
