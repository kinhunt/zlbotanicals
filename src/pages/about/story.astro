---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
const lang = 'en';
const cards = [
  {
    "title": "Botanical ingredients for business buyers",
    "description": "Our catalog brings together botanical extracts and natural ingredients for buyers to compare. Availability, origin and manufacturing arrangements should be confirmed per quotation.",
    "href": "/products"
  },
  {
    "title": "A practical basis for cooperation",
    "description": "Tell us your application, target specification and destination market. These details guide the discussion of samples, supporting documents and supply terms.",
    "href": "/request-quote"
  },
  {
    "title": "Qualify the product, not just the company",
    "description": "Review the proposed material and manufacturing site, evaluate a sample and agree acceptance criteria before a bulk order.",
    "href": "/quality"
  }
];
---
<PageLayout title="Our Story" description="Roots in Guangzhou, since 1986. Our company history begins in 1986 in Guangzhou. That history provides context; each purchasing decision still depends on the identity, specification and documentation of the ingredient being offered." lang={lang} heroTitle="Our Story" heroSubtitle="Roots in Guangzhou, since 1986">
  <section class="section-padding">
    <div class="container-wide">
      <p class="text-lg md:text-xl leading-relaxed text-gray-600 max-w-4xl">Our company history begins in 1986 in Guangzhou. That history provides context; each purchasing decision still depends on the identity, specification and documentation of the ingredient being offered.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {cards.map((card) => (
          <article class="p-7 rounded-xl bg-off-white border border-primary/10 hover:border-primary/30 transition-colors">
            <h2 class="text-xl font-display font-bold text-gray-900">{card.title}</h2>
            <p class="mt-4 text-gray-600 leading-relaxed">{card.description}</p>
            {card.href && <a href={getLocalizedPath(card.href, lang)} class="inline-flex mt-5 text-primary font-semibold hover:underline">Explore further →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-primary py-16">
    <div class="container-wide text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white">Start your product & document review</h2>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">Share the ingredient, specification, application, destination and expected quantity. Include your sample and document requirements; availability is confirmed per product.</p>
      <a href={getLocalizedPath('/request-quote', lang)} class="inline-flex mt-7 px-7 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent-dark transition-colors">Request Samples & COA</a>
      <a href={getLocalizedPath('/products', lang)} class="inline-flex mt-7 ml-4 px-7 py-3 border border-white/50 text-white rounded-lg font-semibold hover:bg-white/10">Explore Ingredients</a>
    </div>
  </section>
</PageLayout>
