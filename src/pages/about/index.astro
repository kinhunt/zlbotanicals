---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
const lang = 'en';
const cards = [
  {
    "title": "Company background",
    "description": "Start with our stated history and the information needed to qualify a business partner.",
    "href": "/about/story"
  },
  {
    "title": "Supply & process review",
    "description": "Confirm the manufacturing site and supply route for the product you intend to purchase.",
    "href": "/about/facility"
  },
  {
    "title": "Certification review",
    "description": "Check which documents apply to the legal entity, site, product and destination.",
    "href": "/about/certifications"
  }
];
---
<PageLayout title="About ZL Botanicals" description="Botanical ingredients. Product-specific conversations.. ZL Botanicals traces its company history to 1986 in Guangzhou, China. We work with business buyers exploring botanical extracts and natural ingredients for food, beverage, supplement and personal-care applications. The catalog is a starting point for sourcing, not a statement that every listed ingredient is made at one facility." lang={lang} heroTitle="About ZL Botanicals" heroSubtitle="Botanical ingredients. Product-specific conversations.">
  <section class="section-padding">
    <div class="container-wide">
      <p class="text-lg md:text-xl leading-relaxed text-gray-600 max-w-4xl">ZL Botanicals traces its company history to 1986 in Guangzhou, China. We work with business buyers exploring botanical extracts and natural ingredients for food, beverage, supplement and personal-care applications. The catalog is a starting point for sourcing, not a statement that every listed ingredient is made at one facility.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {cards.map((card) => (
          <article class="p-7 rounded-xl bg-off-white border border-primary/10 hover:border-primary/30 transition-colors">
            <h2 class="text-xl font-display font-bold text-gray-900">{card.title}</h2>
            <p class="mt-4 text-gray-600 leading-relaxed">{card.description}</p>
            {card.href && <a href={getLocalizedPath(card.href, lang)} class="inline-flex mt-5 text-primary font-semibold hover:underline">Explore further →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-primary py-16">
    <div class="container-wide text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white">Start your product & document review</h2>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">Share the ingredient, specification, application, destination and expected quantity. Include your sample and document requirements; availability is confirmed per product.</p>
      <a href={getLocalizedPath('/request-quote', lang)} class="inline-flex mt-7 px-7 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent-dark transition-colors">Request Samples & COA</a>
      <a href={getLocalizedPath('/products', lang)} class="inline-flex mt-7 ml-4 px-7 py-3 border border-white/50 text-white rounded-lg font-semibold hover:bg-white/10">Explore Ingredients</a>
    </div>
  </section>
</PageLayout>
