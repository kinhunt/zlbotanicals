---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
const lang = 'en';
const cards = [
  {
    "title": "Legal entity & site",
    "description": "Match the certificate holder and site address to the manufacturer identified in your quotation. Request the certificate number and issuing body.",
    "href": ""
  },
  {
    "title": "Scope & validity",
    "description": "Read the scope, covered activities, issue date and expiry date. Check current status with the issuer where possible; a logo alone is not sufficient.",
    "href": ""
  },
  {
    "title": "Quality & food-safety systems",
    "description": "If your supplier policy requires ISO 9001, ISO 22000, HACCP or GMP-related documentation, specify the scheme and applicable regulatory context. Ask what is available for the proposed site; these schemes are not interchangeable.",
    "href": ""
  },
  {
    "title": "Product-specific requirements",
    "description": "If Halal, Kosher or other product certification is required, request a current product schedule and check the exact ingredient, carrier and manufacturing site. Confirm destination-market acceptance.",
    "href": ""
  },
  {
    "title": "COA is a different document",
    "description": "A Certificate of Analysis reports results for a stated sample or batch. It is not a management-system certificate or proof that an ingredient is authorized for every use.",
    "href": "/quality"
  },
  {
    "title": "Build your request",
    "description": "Include the product, specification, intended use, destination and mandatory certification requirements. Availability and scope need confirmation before purchase.",
    "href": "/request-quote"
  }
];
---
<PageLayout title="Certification Review" description="Check the document, the scope and the validity. Certification requirements depend on the ingredient, manufacturing site and destination market. Use this checklist to request applicable documents. A certificate covering one site or product does not establish coverage for the whole catalog." lang={lang} heroTitle="Certification Review" heroSubtitle="Check the document, the scope and the validity">
  <section class="section-padding">
    <div class="container-wide">
      <p class="text-lg md:text-xl leading-relaxed text-gray-600 max-w-4xl">Certification requirements depend on the ingredient, manufacturing site and destination market. Use this checklist to request applicable documents. A certificate covering one site or product does not establish coverage for the whole catalog.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {cards.map((card) => (
          <article class="p-7 rounded-xl bg-off-white border border-primary/10 hover:border-primary/30 transition-colors">
            <h2 class="text-xl font-display font-bold text-gray-900">{card.title}</h2>
            <p class="mt-4 text-gray-600 leading-relaxed">{card.description}</p>
            {card.href && <a href={getLocalizedPath(card.href, lang)} class="inline-flex mt-5 text-primary font-semibold hover:underline">Explore further →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-primary py-16">
    <div class="container-wide text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white">Start your product & document review</h2>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">Share the ingredient, specification, application, destination and expected quantity. Include your sample and document requirements; availability is confirmed per product.</p>
      <a href={getLocalizedPath('/request-quote', lang)} class="inline-flex mt-7 px-7 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent-dark transition-colors">Request Samples & COA</a>
      <a href={getLocalizedPath('/products', lang)} class="inline-flex mt-7 ml-4 px-7 py-3 border border-white/50 text-white rounded-lg font-semibold hover:bg-white/10">Explore Ingredients</a>
    </div>
  </section>
</PageLayout>
