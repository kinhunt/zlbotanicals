---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
import { Leaf, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  const solutions = await getCollection('solutions', ({ data }) => {
    return data.lang === 'en' && !data.draft;
  });

  return solutions.map((solution) => ({
    params: { slug: solution.slug.replace('en/', '') },
    props: { solution },
  }));
}

const { solution } = Astro.props;
const { Content } = await solution.render();
const lang = 'en';

// Get related products (reverse lookup: products that reference this solution)
const allProducts = await getCollection('products', ({ data }) => {
  return data.lang === 'en' && !data.draft;
});

const solutionSlug = solution.slug.replace('en/', '');
const relatedProducts = allProducts.filter((product) =>
  product.data.solutions?.includes(solutionSlug)
);

const industryLabels: Record<string, string> = {
  beverages: 'Beverages',
  nutraceuticals: 'Nutraceuticals',
  cosmetics: 'Cosmetics',
  food: 'Food',
};
---

<PageLayout
  title={solution.data.name}
  description={solution.data.description}
  lang={lang}
  heroTitle={solution.data.name}
  heroSubtitle={industryLabels[solution.data.industry] || solution.data.industry}
>
  <article class="section-padding">
    <div class="container-wide max-w-4xl">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm">
        <ol class="flex items-center gap-2 text-gray-500">
          <li><a href={getLocalizedPath('/', lang)} class="hover:text-primary">Home</a></li>
          <li>/</li>
          <li><a href={getLocalizedPath('/solutions', lang)} class="hover:text-primary">Solutions</a></li>
          <li>/</li>
          <li class="text-gray-900">{solution.data.name}</li>
        </ol>
      </nav>

      <!-- Industry Tag -->
      <div class="mb-8">
        <span class="px-3 py-1 bg-accent/10 text-accent rounded-full text-sm font-medium">
          {industryLabels[solution.data.industry]}
        </span>
      </div>

      <!-- Feature Image -->
      {solution.data.image && (
        <div class="mb-10 rounded-2xl overflow-hidden shadow-lg">
          <img
            src={solution.data.image}
            alt={solution.data.name}
            class="w-full h-64 md:h-96 object-cover"
          />
        </div>
      )}

      <!-- Main Content -->
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-gray-900 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-table:text-sm">
        <Content />
      </div>

      <!-- Related Products -->
      {relatedProducts.length > 0 && (
        <div class="mt-16 pt-8 border-t border-gray-200">
          <h3 class="text-xl font-display font-bold text-gray-900 mb-6 flex items-center gap-2">
            <Leaf class="w-6 h-6 text-primary" />
            Recommended Products
          </h3>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedProducts.map((product) => (
              <a
                href={getLocalizedPath(`/products/${product.slug.replace('en/', '')}`, lang)}
                class="group p-5 bg-off-white rounded-xl hover:shadow-md transition-shadow"
              >
                <h4 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
                  {product.data.name}
                </h4>
                {product.data.latinName && (
                  <p class="text-xs text-gray-500 italic mt-1">{product.data.latinName}</p>
                )}
                {product.data.description && (
                  <p class="text-sm text-gray-600 mt-2 line-clamp-2">{product.data.description}</p>
                )}
                <span class="inline-flex items-center gap-1 mt-3 text-primary text-sm font-medium">
                  View product <ArrowRight class="w-4 h-4" />
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-12 p-8 bg-primary/5 rounded-2xl text-center">
        <h3 class="text-xl font-display font-bold text-gray-900">Ready to get started?</h3>
        <p class="text-gray-600 mt-2">Let's discuss your project requirements and find the right solution.</p>
        <a
          href={getLocalizedPath('/contact', lang)}
          class="inline-block mt-4 px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors"
        >
          Discuss Your Project
        </a>
      </div>
    </div>
  </article>
</PageLayout>
