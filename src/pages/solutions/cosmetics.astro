---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';

const lang = 'en';

const products = [
  'Green Tea Extract', 'Licorice Extract', 'Bilberry Extract',
  'Centella Asiatica Extract', 'Chamomile Extract', 'Aloe Vera Extract'
];
---

<PageLayout title="Cosmetics" lang={lang} heroTitle="Cosmetics & Beauty" heroSubtitle="Natural botanical actives for personal care">
  <section class="section-padding">
    <div class="container-wide">
      <div class="max-w-3xl mb-12">
        <p class="text-xl text-gray-600 leading-relaxed">
          Our botanical extracts provide natural, effective actives for skincare, haircare, and personal care formulations.
        </p>
      </div>
      <h3 class="text-xl font-semibold text-gray-900 mb-4">Popular Products for Cosmetics</h3>
      <div class="flex flex-wrap gap-3">
        {products.map((p) => <span class="px-4 py-2 bg-off-white rounded-lg text-gray-700">{p}</span>)}
      </div>
      <a href={getLocalizedPath('/contact', lang)} class="inline-block mt-8 px-6 py-3 bg-primary text-white rounded-lg font-medium hover:bg-primary-dark transition-colors">
        Discuss Your Project
      </a>
    </div>
  </section>
</PageLayout>
