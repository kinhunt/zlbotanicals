---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLocalizedPath } from '../../i18n/config';
import { GlassWater, Pill, Sparkles, UtensilsCrossed } from '@lucide/astro';

const lang = 'en';

const applications = [
  { title: 'Beverages', desc: 'Functional ingredients for teas, energy drinks, and wellness beverages.', href: getLocalizedPath('/applications/beverages', lang), icon: 'beverages' },
  { title: 'Nutraceuticals', desc: 'High-quality extracts for dietary supplements and functional foods.', href: getLocalizedPath('/applications/nutraceuticals', lang), icon: 'nutraceuticals' },
  { title: 'Cosmetics', desc: 'Natural botanical actives for skincare and personal care products.', href: getLocalizedPath('/applications/cosmetics', lang), icon: 'cosmetics' },
  { title: 'Food', desc: 'Natural flavors, colors, and functional ingredients for food products.', href: getLocalizedPath('/applications/food', lang), icon: 'food' },
];
---

<PageLayout
  title="Applications"
  description="Botanical extract solutions for beverages, nutraceuticals, cosmetics, and food industries. Functional ingredients for teas, supplements, skincare, and natural food products."
  lang={lang}
  heroTitle="Application Areas"
  heroSubtitle="Botanical solutions for diverse industries"
>
  <section class="section-padding">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-8">
        {applications.map((app) => (
          <a href={app.href} class="group block p-8 bg-off-white rounded-xl hover:shadow-lg transition-all">
            <div class="w-12 h-12 text-primary">
              {app.icon === 'beverages' && <GlassWater class="w-full h-full" strokeWidth={1.5} />}
              {app.icon === 'nutraceuticals' && <Pill class="w-full h-full" strokeWidth={1.5} />}
              {app.icon === 'cosmetics' && <Sparkles class="w-full h-full" strokeWidth={1.5} />}
              {app.icon === 'food' && <UtensilsCrossed class="w-full h-full" strokeWidth={1.5} />}
            </div>
            <h3 class="text-2xl font-semibold text-gray-900 mt-4">{app.title}</h3>
            <p class="mt-2 text-gray-600">{app.desc}</p>
            <span class="inline-block mt-4 text-primary font-medium group-hover:translate-x-2 transition-transform">Learn More →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
