		<!-- Language Dropdown -->
		<div id="languageDropdown"></div>
		<script>
          (function getLanguages() {
            var lang;
            var list = jQuery('<ul/>');
            var arr = [
                              {
                id: "en",
                link: "https://hopsteiner.us/",
                src: "https://hopsteiner.us/wp-content/uploads/2018/05/us.png",
                title: "English",
              },
                              {
                id: "es",
                link: "http://www.hopsteiner.es/",
                src: "https://hopsteiner.us/wp-content/uploads/2018/05/es.png",
                title: "Spanish",
              },
                            ];

            arr.forEach(function (item) {
              var el = jQuery('<li id="' + item.id + '"><a href="' + item.link + '"><img class="flag" src="' + item.src + '" alt="' + item.id + '" title="' + item.title + '" /></a></li>');
              el.appendTo(list);
            });

            if (jQuery('body').hasClass('en')) {
              lang = 'en';
            } else if (jQuery('body').hasClass('es')) {
              lang = 'es';
            }

            list.find('#' + lang).addClass('active').find('a').removeAttr('href');
            list.find('#' + lang).addClass('active').prependTo(list);
            list.appendTo('#languageDropdown');
          })();
          jQuery('#languageDropdown li.active').click(function () {
            jQuery(this).toggleClass('bgColor');
            jQuery(this).siblings().slideToggle(200);
          });
		</script>
		<!-- End Language Dropdown -->

