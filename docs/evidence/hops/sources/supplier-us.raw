<script>
  jQuery(window).resize(function () {
    var w = window.innerWidth;
    if (w > 999 && (jQuery('body').attr('style'))) {
      jQuery('body, header, nav.nav-wrapper, nav.nav-wrapper .has-dropdown ul').removeAttr('style');
      jQuery('header .mobile-menu span').removeClass('transformX');
    }
  });
  jQuery(document).ready(function () {
    jQuery('header .mobile-menu').click(function (e) {
      var menuWidth = 260;
      var slideSpeed = 300;
      e.preventDefault();
      if (jQuery('header').hasClass('fixedNav') && !(jQuery('header').attr('style'))) {
        jQuery('header').animate({
          left: '-' + menuWidth + 'px',
        }, slideSpeed);
      } else {
        jQuery('header').animate({
          left: 0,
        }, slideSpeed, function () {
          jQuery('header').removeAttr('style');
        });
      }
      if (!(jQuery('body').attr('style'))) {
        jQuery('body').animate({
          position: 'relative',
        }, 0, function () {
          jQuery('body').animate({
            right: menuWidth + 'px',
          }, slideSpeed);
        });
        jQuery('nav.nav-wrapper').animate({
          right: 0,
        }, slideSpeed);
        jQuery('header .mobile-menu span').addClass('transformX');
      } else {
        jQuery('body').animate({
          right: 0,
        }, slideSpeed, function () {
          jQuery('body').removeAttr('style');
        });
        jQuery('nav.nav-wrapper').animate({
          right: '-' + menuWidth + 'px',
        }, slideSpeed, function () {
          jQuery('nav.nav-wrapper').removeAttr('style');
        });
        jQuery('header .mobile-menu span').removeClass('transformX');
        jQuery('nav.nav-wrapper ul li.has-dropdown ul').slideUp(slideSpeed, function () {
          jQuery('nav.nav-wrapper ul li.has-dropdown ul').removeAttr('style');
        });
      }
    });
  });
  jQuery(document).ready(function () {
    jQuery('header nav.nav-wrapper .mobile-search').append('<span><i class="fa fa-search" aria-hidden="true"></i></span>');
    jQuery('header nav.nav-wrapper .has-dropdown').append('<span><i class="fa fa-angle-down" aria-hidden="true"></i></span>');
    jQuery('nav.nav-wrapper ul li.has-dropdown span').click(function (e) {
      var w = window.innerWidth;
      e.preventDefault();
      if (w < 999) {
        jQuery(this).parent().siblings('li.has-dropdown').children('ul').slideUp(300);
        jQuery(this).siblings('ul').slideToggle(300);
      }
    });
  });
</script>

