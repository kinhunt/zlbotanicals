<script type="text/javascript">
  jQuery(document).ready(function () {
    jQuery('.bar_logo').wrap("<a href=\"/\"></a>");
    jQuery(window).scroll(function () {
      if (jQuery(this).scrollTop() != 0) {
        jQuery('#icon-backtotop').fadeIn();
      } else {
        jQuery('#icon-backtotop').fadeOut();
      }
    });

    jQuery('#icon-backtotop').click(function () {
      jQuery('body,html').animate({ scrollTop: 0 }, 800);
    });
    jQuery('#tridentScroll-1').click(function () {
      jQuery('body,html').animate({ scrollTop: jQuery('#content').offset().top }, 800);
    });
    jQuery('#tridentScroll-2').click(function () {
      jQuery('body,html').animate({ scrollTop: jQuery('#trident-ordering').offset().top }, 800);
    });
    // #tridentScroll-1, #tridentScroll-2
  });
</script>

