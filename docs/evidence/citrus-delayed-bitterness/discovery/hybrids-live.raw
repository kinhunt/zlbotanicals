202,5205],{"#text":1835},{"sup":5203},[5204],{"#text":2119},{"#text":1742},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5209,":@":5211},[5210],{"#text":2260},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5214,":@":5220},[5215,5216,5219],{"#text":1835},{"sup":5217},[5218],{"#text":2119},{"#text":1742},{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5224},[5225,5226,5231,5232,5235,5236,5241,5242,5245,5246,5250,5251,5254,5255,5259,5260,5263,5264,5268,5269,5272,5273,5277,5278,5281,5282,5286,5287,5290,5291,5295,5296,5299,5300,5304,5305,5308],{"#text":1742},{"td":5227,":@":5230},[5228],{"#text":5229},"LSD",{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5233,":@":5234},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5237,":@":5240},[5238],{"#text":5239},"1.6",{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5243,":@":5244},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5247,":@":5249},[5248],{"#text":3266},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5252,":@":5253},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5256,":@":5258},[5257],{"#text":2415},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5261,":@":5262},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5265,":@":5267},[5266],{"#text":2337},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5270,":@":5271},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5274,":@":5276},[5275],{"#text":3121},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5279,":@":5280},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5283,":@":5285},[5284],{"#text":4184},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5288,":@":5289},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5292,":@":5294},[5293],{"#text":3136},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5297,":@":5298},[],{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5301,":@":5303},[5302],{"#text":2337},{"@_valign":1762,"@_align":1749},{"#text":1742},{"td":5306,":@":5307},[],{"@_valign":1762,"@_align":1749},{"#text":1738},{"#text":1725},{"#text":918},{"@_frame":5312},"hsides",{"#text":918},{"table-wrap-foot":5315},[5316,5317,5325],{"#text":1725},{"fn":5318},[5319,5320,5324],{"#text":1738},{"p":5321},[5322],{"#text":5323},"For each sensory attribute, intensity ratings were on the scale from 0 (none) to 15 (high). Least Significant Difference (LSD) is calculated at the 95% confidence level with the ‘panelist x sample’ as the error term. For “orange flavor”, “mandarin flavor”, “sweet” and “sour”, means followed with a different letter within a column are statistically different by the Fisher’s LSD test for multiple comparisons. For “grapefruit flavor”, “bitter”, “off-flavors” and “aftertaste”, means separation followed the Dunn’s procedure for multiple pairwise comparison of non-parametric data, following a Kruskal-Wallis test.",{"#text":1725},{"#text":918},{"#text":924},{"@_id":1711,"@_position":5328},"float",{"#text":1073},{"@_id":5331},"s2_7",{"#text":1076},{"@_id":5334,"@_sec-type":5335},"s2","materials|methods",{"#text":1076},{"sec":5338,":@":6636,"anchorId":6637},[5339,5340,5344,5345,5887,5888,6156,6157,6438,6439,6635],{"#text":1080},{"title":5341},[5342],{"#text":5343},"3 Results and discussion",{"#text":1073},{"sec":5346,":@":5885},[5347,5348,5352,5353,5463,5464,5713,5714,5747,5748,5790,5791,5884],{"#text":1390},{"title":5349},[5350],{"#text":5351},"3.1 Sensory evaluation",{"#text":924},{"p":5354},[5355,5357,5363,5365,5373,5375,5384,5386,5393,5394,5401,5403,5410,5412,5416,5418,5424,5426,5432,5434,5438,5440,5446,5448,5454,5456,5462],{"#text":5356},"A trained descriptive panel evaluated the selected named varieties and hybrids harvested during the 2020-2021 and 2021-2022 seasons. Average intensity ratings from the trained panelists are reported in ",{"xref":5358,":@":5362},[5359],{"bold":5360},[5361],{"#text":1708},{"@_ref-type":1710,"@_rid":1711},{"#text":5364}," with a scale from 0 (none) to 15 (high) for each sensory attribute. Panelists were encouraged to leave open comments for each sample, describing the flavor, off-flavors, or aftertastes. These comments were compiled and combined from both harvest seasons for each variety in ",{"xref":5366,":@":5371},[5367],{"bold":5368},[5369],{"#text":5370},"Table 2",{"@_ref-type":1710,"@_rid":5372},"T2",{"#text":5374},". In ",{"xref":5376,":@":5381},[5377],{"bold":5378},[5379],{"#text":5380},"Figure 1",{"@_ref-type":5382,"@_rid":5383},"fig","f1",{"#text":5385},", the PCA biplot shows the relationships between sensory attributes and the known chemical contributors (SSC, TA, limonin, and nomilin) to citrus flavor for the genotypes in this study. Principal components (PC) 1 and 2 accounted for 40.4% and 25.7% of the variation, respectively. Orange and mandarin flavors and sweetness described PC1 on the negative side while sourness, bitterness, off-flavor, aftertaste, “poncirus” flavor, and grapefruit flavor described PC1 on the positive side. Sourness correlated with titratable acidity (TA) (r = 0.91), and bitterness, off-flavor and aftertaste correlated with limonin (r = 0.86) and nomilin (r = 0.75), known bitter compounds absolutely quantified in juice supernatant (",{"xref":5387,":@":5392},[5388],{"bold":5389},[5390],{"#text":5391},"Supplementary Tables S2",{"@_ref-type":1649,"@_rid":1650},{"#text":1346},{"xref":5395,":@":5400},[5396],{"bold":5397},[5398],{"#text":5399},"S3",{"@_ref-type":1649,"@_rid":1650},{"#text":5402},"). Mandarin flavor, sweetness, and SSC/TA correlated with each other (r = 0.54, 0.40 and 0.41, respectively; ",{"xref":5404,":@":5409},[5405],{"bold":5406},[5407],{"#text":5408},"Supplementary Table S3",{"@_ref-type":1649,"@_rid":1650},{"#text":5411},"), as previously reported (",{"xref":5413,":@":5415},[5414],{"#text":1143},{"@_ref-type":1095,"@_rid":1145},{"#text":5417},"). The juice from named sweet orange varieties commercially grown in Florida, ‘Valencia’ and ‘Hamlin’, had high orange flavor, moderate mandarin flavor, high sweetness, and minimal off-flavor and aftertaste (",{"xref":5419,":@":5423},[5420],{"bold":5421},[5422],{"#text":1708},{"@_ref-type":1710,"@_rid":1711},{"#text":5425},"). Overall, the sensory descriptive profiles and basic chemical characteristics (soluble solids content, titratable acidity, and limonoids) (",{"xref":5427,":@":5431},[5428],{"bold":5429},[5430],{"#text":5380},{"@_ref-type":5382,"@_rid":5383},{"#text":5433},") for each genotype varied but were similar between the two harvest seasons for most genotypes. ‘Valencia’, however, was less sweet and more sour and bitter when harvested in 2022 and was accompanied with a significantly higher ",{"italic":5435},[5436],{"#text":5437},"Candidatus",{"#text":5439}," Liberibacter asiaticus titer (data not shown), indicating a higher level of HLB-disease infection (",{"xref":5441,":@":5444},[5442],{"#text":5443},"Dala Paula et al., 2018",{"@_ref-type":1095,"@_rid":5445},"B7",{"#text":5447},"). Some panelists who have participated in orange juice trained panels for many years perceived off flavor described as “typical HLB off-flavor” in the juice from the 2022 harvest (",{"xref":5449,":@":5453},[5450],{"bold":5451},[5452],{"#text":5370},{"@_ref-type":1710,"@_rid":5372},{"#text":5455},") (",{"xref":5457,":@":5460},[5458],{"#text":5459},"Plotto et al., 2017",{"@_ref-type":1095,"@_rid":5461},"B28",{"#text":1205},{"#text":924},{"table-wrap":5465,":@":5712},[5466,5467,5470,5471,5479,5480,5711],{"#text":918},{"label":5468},[5469],{"#text":5370},{"#text":918},{"caption":5472},[5473,5474,5478],{"#text":1725},{"p":5475},[5476],{"#text":5477},"Panelists’ descriptive comments of genotypes from combined 2020-2021 and 2021-2022 harvests.",{"#text":918},{"#text":918},{"table":5481,":@":5710},[5482,5483,5501,5502,5709],{"#text":1725},{"thead":5484},[5485,5486,5500],{"#text":1738},{"tr":5487},[5488,5489,5493,5494,5499],{"#text":1742},{"th":5490,":@":5492},[5491],{"#text":1746},{"@_valign":1842,"@_align":1749},{"#text":1742},{"th":5495,":@":5498},[5496],{"#text":5497},"Panelists’ Comments",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1725},{"#text":1725},{"tbody":5503},[5504,5505,5519,5520,5534,5535,5549,5550,5570,5571,5585,5586,5600,5601,5615,5616,5630,5631,5645,5646,5660,5661,5675,5676,5693,5694,5708],{"#text":1738},{"tr":5506},[5507,5508,5512,5513,5518],{"#text":1742},{"td":5509,":@":5511},[5510],{"#text":4589},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5514,":@":5517},[5515],{"#text":5516},"Bitter, pith, “poncirus”, “green”, pumpkin, acrid, chemical",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5521},[5522,5523,5527,5528,5533],{"#text":1742},{"td":5524,":@":5526},[5525],{"#text":3558},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5529,":@":5532},[5530],{"#text":5531},"Sweet, pumpkin, melon, grassy, green, typical mandarin",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5536},[5537,5538,5542,5543,5548],{"#text":1742},{"td":5539,":@":5541},[5540],{"#text":3035},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5544,":@":5547},[5545],{"#text":5546},"Pumpkin, peach, vegetable, no citrus-flavor, floral",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5551},[5552,5553,5557,5558,5569],{"#text":1742},{"td":5554,":@":5556},[5555],{"#text":3817},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5559,":@":5568},[5560,5562,5566],{"#text":5561},"Sweet, bitter, pumpkin, stale, cardboard, ",{"italic":5563},[5564],{"#text":5565},"“",{"#text":5567},"poncirus”",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5572},[5573,5574,5578,5579,5584],{"#text":1742},{"td":5575,":@":5577},[5576],{"#text":4203},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5580,":@":5583},[5581],{"#text":5582},"Extremely bitter, pith, fruity-non-citrus, melon, earthy, pumpkin, typical mandarin",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5587},[5588,5589,5593,5594,5599],{"#text":1742},{"td":5590,":@":5592},[5591],{"#text":2371},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5595,":@":5598},[5596],{"#text":5597},"Good tasting orange juice, a hint of “poncirus”, sweet, floral",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5602},[5603,5604,5608,5609,5614],{"#text":1742},{"td":5605,":@":5607},[5606],{"#text":1817},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5610,":@":5613},[5611],{"#text":5612},"Sweet, slight bitter, peel oil, piney, overall bland",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5617},[5618,5619,5623,5624,5629],{"#text":1742},{"td":5620,":@":5622},[5621],{"#text":4847},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5625,":@":5628},[5626],{"#text":5627},"Bitter, “poncirus”, pumpkin, sulfury, earthy, peel oil, bland, metallic",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5632},[5633,5634,5638,5639,5644],{"#text":1742},{"td":5635,":@":5637},[5636],{"#text":2637},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5640,":@":5643},[5641],{"#text":5642},"“Poncirus”, soapy, leafy, green, sour, astringent, earthy, bitter, metallic",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5647},[5648,5649,5653,5654,5659],{"#text":1742},{"td":5650,":@":5652},[5651],{"#text":5100},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5655,":@":5658},[5656],{"#text":5657},"Strong “poncirus” flavor, bitter, peel oil, cardboard, acrid, sour, gasoline, metallic",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5662},[5663,5664,5668,5669,5674],{"#text":1742},{"td":5665,":@":5667},[5666],{"#text":2098},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5670,":@":5673},[5671],{"#text":5672},"Fruity, floral, has typical HLB flavor and sour (only in 2022 harvest)",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5677},[5678,5679,5686,5687,5692],{"#text":1742},{"td":5680,":@":5685},[5681,5682],{"#text":2900},{"sup":5683},[5684],{"#text":1058},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5688,":@":5691},[5689],{"#text":5690},"Rich flavor, slight pumpkin",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1738},{"tr":5695},[5696,5697,5701,5702,5707],{"#text":1742},{"td":5698,":@":5700},[5699],{"#text":3429},{"@_valign":1842,"@_align":1749},{"#text":1742},{"td":5703,":@":5706},[5704],{"#text":5705},"Sour, metallic, pumpkin",{"@_valign":1842,"@_align":1749},{"#text":1738},{"#text":1725},{"#text":918},{"@_frame":5312},{"#text":924},{"@_id":5372,"@_position":5328},{"#text":924},{"fig":5715,":@":5746},[5716,5717,5720,5721,5739,5740,5745],{"#text":918},{"label":5718},[5719],{"#text":5380},{"#text":918},{"caption":5722},[5723,5724,5738],{"#text":1725},{"p":5725},[5726,5728,5731,5733,5736],{"#text":5727},"Biplot of the first two principal components (PC) from the principal component analysis (PCA) of sensory attributes (green) and basic chemical components (blue) in genotypes harvested in the 2020-21 and 2021-22 seasons. Mandarin hybrids without ",{"italic":5729},[5730],{"#text":1052},{"#text":5732}," introgression are red, orange varieties are orange, and ",{"italic":5734},[5735],{"#text":1052},{"#text":5737}," hybrids are purple. Harvest month and year follow the genotype. SSC, soluble solids content; % TA, titratable acidity.",{"#text":918},{"#text":918},{"graphic":5741,":@":5742},[],{"@_mimetype":367,"@_mime-subtype":5743,"@_xlink:href":5744},"tiff","fhort-03-1425366-g001.tif",{"#text":924},{"@_id":5383,"@_position":5328},{"#text":924},{"p":5749},[5750,5752,5755,5757,5763,5765,5768,5770,5776,5778,5781,5783,5789],{"#text":5751},"‘US SunDragon’, a ",{"italic":5753},[5754],{"#text":1052},{"#text":5756}," hybrid with proven tolerance to HLB (",{"xref":5758,":@":5761},[5759],{"#text":5760},"Stover et al., 2020",{"@_ref-type":1095,"@_rid":5762},"B36",{"#text":5764},"), had consistent high orange flavor and high sweetness with some sourness, similar to ‘Hamlin’ harvested at the same time. Panelists commented that ‘US SunDragon’ juice was a good-tasting orange juice with a hint of “poncirus” off-flavor. When harvested in February 2021, orange flavor ratings of FF-1-5-213, another ",{"italic":5766},[5767],{"#text":1052},{"#text":5769}," hybrid, followed that of ‘Hamlin’, with average mandarin flavor, but was rated with higher sourness than ‘Valencia’ or ‘Hamlin’. Panelists described its juice to have “poncirus” and soapy off-flavors (",{"xref":5771,":@":5775},[5772],{"bold":5773},[5774],{"#text":5370},{"@_ref-type":1710,"@_rid":5372},{"#text":5777},"). Another ",{"italic":5779},[5780],{"#text":1052},{"#text":5782}," hybrid, FF-1-85-124, had higher grapefruit flavor than most hybrids and was rated with high intensity for sourness and bitterness. Some panelists commented that this juice had strong “poncirus”, peel oil, cardboard, gasoline, and metallic flavors (",{"xref":5784,":@":5788},[5785],{"bold":5786},[5787],{"#text":5370},{"@_ref-type":1710,"@_rid":5372},{"#text":1205},{"#text":924},{"p":5792},[5793,5795,5798,5800,5804,5806,5812,5814,5820,5822,5825,5827,5830,5832,5836,5838,5841,5843,5850,5851,5857,5859,5865,5867,5873,5875,5882],{"#text":5794},"The hybrids without ",{"italic":5796},[5797],{"#text":1052},{"#text":5799}," in their pedigree (hereafter described as “mandarin hybrids”, though it should be noted that true mandarin ",{"italic":5801},[5802],{"#text":5803},"C. reticulata",{"#text":5805}," predominates in the pedigree of all material studied even sweet oranges) included in this study have diverse sensory descriptive profiles. While some of them were rated with high mandarin flavor and high sweetness, others were rated high for bitterness, aftertaste, and grapefruit flavor (",{"xref":5807,":@":5811},[5808],{"bold":5809},[5810],{"#text":1708},{"@_ref-type":1710,"@_rid":1711},{"#text":5813},"). It is to be noted that no true grapefruit was rated in this study. However, since sweet orange and grapefruit have similar complex ancestry (",{"xref":5815,":@":5818},[5816],{"#text":5817},"Wu et al., 2018",{"@_ref-type":1095,"@_rid":5819},"B44",{"#text":5821},"), grapefruit flavor was rated together with orange and mandarin flavors. ‘LB8-9’ Sugar Belle",{"sup":5823},[5824],{"#text":1058},{"#text":5826}," (hereafter Sugar Belle",{"sup":5828},[5829],{"#text":1058},{"#text":5831},"), a University of Florida released mandarin-type tolerant to HLB, had a high mandarin flavor (rating 7.0), as demonstrated in the literature (",{"xref":5833,":@":5835},[5834],{"#text":1656},{"@_ref-type":1095,"@_rid":1658},{"#text":5837},"). Some panelists commented that Sugar Belle",{"sup":5839},[5840],{"#text":1058},{"#text":5842}," had a rich flavor and minimal off-flavor (",{"xref":5844,":@":5849},[5845],{"bold":5846},[5847],{"#text":5848},"Tables 1",{"@_ref-type":1710,"@_rid":1711},{"#text":1346},{"xref":5852,":@":5856},[5853],{"bold":5854},[5855],{"#text":1604},{"@_ref-type":1710,"@_rid":5372},{"#text":5858},"). ‘US Superna’, another recent USDA release, was consistently rated high in sweetness and mandarin flavor. Some panelists’ comments indicated that this juice had pumpkin off-flavor, which has been associated with mandarin flavor (",{"xref":5860,":@":5863},[5861],{"#text":5862},"Miyazaki et al., 2012",{"@_ref-type":1095,"@_rid":5864},"B24",{"#text":5866},"), especially with late harvests (",{"xref":5868,":@":5871},[5869],{"#text":5870},"Plotto et al., 2011",{"@_ref-type":1095,"@_rid":5872},"B29",{"#text":5874},"). ‘Bower’ is a mandarin hybrid tolerant to HLB, but it was rated high in sourness, with slight metallic off-flavor. FF-5-51-2 is another mandarin hybrid with high mandarin flavor, high sweetness and no off-flavor. FF-1-84-2 and FTP-6-32-67 were rated with moderate mandarin flavor and sweetness but were bitter. Bitterness in these juices is an indication of delayed bitterness occurring following storage of juice, as freshly harvested fruit did not exhibit bitterness at all (observations made at the time of juicing). Juice from the FTP-6-32-67 fruit from the January 2021 harvest was extremely bitter (7.7), but the bitterness dropped to 1.9 when harvested a month later in February of 2021, suggesting that the fruit were not mature at their first harvest in 2021. Indeed, significantly lower levels of limonin and nomilin were measured in February than in January of 2021 (",{"xref":5876,":@":5881},[5877],{"bold":5878},[5879],{"#text":5880},"Supplementary Table S2",{"@_ref-type":1649,"@_rid":1650},{"#text":5883},"). Two mandarins, FF-1-5-35 and FF-5-6-36, were rated higher with grapefruit flavor, bitterness, and off-flavors. Some panelists commented that these juices were bitter and had negative remarks, such as chemical and acrid for FF-5-6-36 and sulfury for FF-1-5-35.",{"#text":1073},{"@_id":5886},"s3_1",{"#text":1073},{"sec":5889,":@":6154},[5890,5891,5895,5896,5973,5974,6005,6006,6023,6024,6091,6092,6153],{"#text":1390},{"title":5892},[5893],{"#text":5894},"3.2 Volatile profiling",{"#text":924},{"p":5897},[5898,5900,5908,5910,5916,5918,5922,5924,5927,5929,5935,5937,5943,5945,5949,5951,5955,5957,5963,5964,5971],{"#text":5899},"Volatile profiles of genotypes in this study were obtained by headspace GC/MS analysis, and included thirteen sesquiterpenes, fourteen monoterpenes, twelve esters, two ketones, eight aldehydes, five alcohols, four terpene alcohols, one terpene ester, and one terpene ketone. A PCA biplot summarizes the relationships between sensory attributes and volatiles (",{"xref":5901,":@":5906},[5902],{"bold":5903},[5904],{"#text":5905},"Figure 2",{"@_ref-type":5382,"@_rid":5907},"f2",{"#text":5909},"). Component 1 and 2 on ",{"xref":5911,":@":5915},[5912],{"bold":5913},[5914],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":5917}," accounted for 28.9% and 18.8% of the variation in the PCA biplot, respectively. Orange flavor correlated with most esters, as well as 3-hexen-1-ol (r = 0.71), (",{"italic":5919},[5920],{"#text":5921},"E",{"#text":5923},")-2-hexenal (r = 0.69), 1-hexanol (r = 0.69), (",{"italic":5925},[5926],{"#text":5921},{"#text":5928},")-2-pentenal (r = 0.67) and some sesquiterpenes (valencene, α-selinene and β-elemene). Mandarin flavor was correlated with SSC and SSC/TA (",{"xref":5930,":@":5934},[5931],{"bold":5932},[5933],{"#text":5380},{"@_ref-type":5382,"@_rid":5383},{"#text":5936},") but only one volatile, β-ionone, was associated with mandarin flavor (",{"xref":5938,":@":5942},[5939],{"bold":5940},[5941],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":5944},"). This confirms the complexity of mandarin flavor and that it is mostly different from orange flavor due to the lack of or the lower abundances of esters (",{"xref":5946,":@":5948},[5947],{"#text":1357},{"@_ref-type":1095,"@_rid":1359},{"#text":5950},"). Negative descriptors (off-flavor, aftertaste and grapefruit) correlated with bitterness. Bitterness in mandarins was previously reported to be correlated with the volatiles α-copaene, cis-β-farnesene, myrcene, and perilla acetate (",{"xref":5952,":@":5954},[5953],{"#text":1195},{"@_ref-type":1095,"@_rid":1197},{"#text":5956},"). From the genotypes in this study, bitterness correlated with the monoterpenes camphene (r = 0.52), α-thujene (0.45), and terpinen-4-ol (0.42) (",{"xref":5958,":@":5962},[5959],{"bold":5960},[5961],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":1176},{"xref":5965,":@":5970},[5966],{"bold":5967},[5968],{"#text":5969},"Supplementary Table S4",{"@_ref-type":1649,"@_rid":1650},{"#text":5972},"). While volatiles may contribute to increased bitterness, the main bitter compounds in mandarin remain to be limonin and nomilin.",{"#text":924},{"fig":5975,":@":6004},[5976,5977,5980,5981,5998,5999,6003],{"#text":918},{"label":5978},[5979],{"#text":5905},{"#text":918},{"caption":5982},[5983,5984,5997],{"#text":1725},{"p":5985},[5986,5988,5991,5992,5995],{"#text":5987},"Biplot of the first two principal components from the principal component analysis (PCA) of sensory attributes (green) and volatile compounds (black) in genotypes harvested in the 2020-21 and 2021-22 seasons. Mandarin hybrids without ",{"italic":5989},[5990],{"#text":1052},{"#text":5732},{"italic":5993},[5994],{"#text":1052},{"#text":5996}," hybrids are purple. Harvest month and year follow the listed genotype.",{"#text":918},{"#text":918},{"graphic":6000,":@":6001},[],{"@_mimetype":367,"@_mime-subtype":5743,"@_xlink:href":6002},"fhort-03-1425366-g002.tif",{"#text":924},{"@_id":5907,"@_position":5328},{"#text":924},{"p":6007},[6008,6010,6014,6016,6022],{"#text":6009},"Commercial orange varieties clustered together on the positive side of PC2 and clearly separated from the mandarin hybrids. Recently, it was reported that seven esters, including methyl hexanoate; ethyl hexanoate; ethyl 3-hydroxyhexanoate; ethyl octanoate; methyl butanoate; ethyl butanoate, and ethyl 2-methylbutanoate, were key compounds distinguishing orange from mandarin flavors (",{"xref":6011,":@":6013},[6012],{"#text":1357},{"@_ref-type":1095,"@_rid":1359},{"#text":6015},"). Consistent with those results, mostly esters (fruity) and some sesquiterpenes were highly abundant in ‘Hamlin’ and ‘Valencia’ (",{"xref":6017,":@":6021},[6018],{"bold":6019},[6020],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":1205},{"#text":924},{"p":6025},[6026,6028,6031,6033,6039,6041,6047,6049,6055,6057,6063,6064,6070,6072,6075,6077,6081,6083,6089],{"#text":6027},"A clearly separated cluster of mandarin hybrids on the negative side of PC2 was correlated with mandarin flavor and sweetness. This cluster included hybrids with positive sensory attributes, such as ‘Bower’, FF-5-51-2, ‘US Superna’, FTP-6-32-67, and Sugar Belle",{"sup":6029},[6030],{"#text":1058},{"#text":6032},", as well as some hybrids with pronounced off-flavors such as FF-1-5-35 and FF-1-84-2. β-ionone, a product of β-carotene degradation and a potent floral terpene ketone (",{"xref":6034,":@":6037},[6035],{"#text":6036},"Winterhalter and Rouseff, 2001",{"@_ref-type":1095,"@_rid":6038},"B43",{"#text":6040},") was highly abundant in the juice of the mandarin hybrids clustered together. As shown in ",{"xref":6042,":@":6046},[6043],{"bold":6044},[6045],{"#text":5370},{"@_ref-type":1710,"@_rid":5372},{"#text":6048},", some panelists commented that some of the mandarins had a pumpkin off-flavor. The only two volatiles that were positively correlated with mandarin flavor and negatively correlated with orange flavor were β-ionone and eucalyptol (",{"xref":6050,":@":6054},[6051],{"bold":6052},[6053],{"#text":5969},{"@_ref-type":1649,"@_rid":1650},{"#text":6056},"). Interestingly, eucalyptol, with a camphor-like or mint-like odor (",{"xref":6058,":@":6061},[6059],{"#text":6060},"Klocke et al., 1987",{"@_ref-type":1095,"@_rid":6062},"B17",{"#text":1176},{"xref":6065,":@":6068},[6066],{"#text":6067},"Rychlik et al., 1998",{"@_ref-type":1095,"@_rid":6069},"B33",{"#text":6071},"), was positively correlated with the previously mentioned negative attributes. It was suggested that eucalyptol could have feeding and ovipositional repellency against the vector of ",{"italic":6073},[6074],{"#text":5437},{"#text":6076}," Liberibacter asiaticus, ",{"italic":6078},[6079],{"#text":6080},"Diaphorina citri",{"#text":6082}," (",{"xref":6084,":@":6087},[6085],{"#text":6086},"Killiny et al., 2018",{"@_ref-type":1095,"@_rid":6088},"B16",{"#text":6090},"). However, this has yet to be researched.",{"#text":924},{"p":6093},[6094,6096,6099,6101,6104,6106,6109,6111,6117,6118,6124,6126,6130,6132,6135,6137,6143,6145,6151],{"#text":6095},"The ",{"italic":6097},[6098],{"#text":1052},{"#text":6100}," hybrids displayed volatile profiles very different from each other, spanning PC1. ‘US SunDragon’ clustered in between the mandarin hybrids and oranges, with FF-1-5-213 closer to mandarin hybrids according to their volatile profiles, and with higher C-5 and C-6 alcohols and aldehydes. While it was rated with moderate to high orange flavor, the ",{"italic":6102},[6103],{"#text":1052},{"#text":6105}," hybrid FF-1-5-213 had some “poncirus” off-flavors as well. FF-1-85-124, with strong “poncirus” off-flavors, separated from the rest of the ",{"italic":6107},[6108],{"#text":1052},{"#text":6110}," hybrids. Grapefruit flavor, aftertaste, off-flavor, bitterness, and “poncirus” flavor were positively correlated with each other (",{"xref":6112,":@":6116},[6113],{"bold":6114},[6115],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":1176},{"xref":6119,":@":6123},[6120],{"bold":6121},[6122],{"#text":5969},{"@_ref-type":1649,"@_rid":1650},{"#text":6125},"). “Poncirus” flavor has been shown to be due to a lack of aldehydes with typical citrus odor as well as higher than typical amounts of sesquiterpene hydrocarbons (woody/green), monoterpenes (citrus/pine), and terpene esters (floral) (",{"xref":6127,":@":6129},[6128],{"#text":1143},{"@_ref-type":1095,"@_rid":1145},{"#text":6131},"). Consistent with these findings, FF-5-6-36, a mandarin hybrid, and FF-1-85-124, a ",{"italic":6133},[6134],{"#text":1052},{"#text":6136}," hybrid, were clustered together on the positive side of PC1 with a higher abundance of monoterpenes (",{"xref":6138,":@":6142},[6139],{"bold":6140},[6141],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":6144},"). Specifically, high off-flavor and aftertaste ratings positively correlated with the monoterpene hydrocarbon, camphene, which has a pungent camphor odor and was determined to be a major contributor in the aroma of carrot (",{"xref":6146,":@":6149},[6147],{"#text":6148},"Rajkumar et al., 2017",{"@_ref-type":1095,"@_rid":6150},"B32",{"#text":6152},"). Out of the genotypes in this study, FF-1-5-35, FF-1-85-124, and FF-5-6-36 had the highest abundances of camphene.",{"#text":1073},{"@_id":6155},"s3_2",{"#text":1073},{"sec":6158,":@":6436},[6159,6160,6164,6165,6244,6245,6275,6276,6398,6399,6435],{"#text":1390},{"title":6161},[6162],{"#text":6163},"3.3 Flavonoid and limonoid profiling",{"#text":924},{"p":6166},[6167,6169,6177,6179,6185,6187,6193,6195,6201,6203,6210,6212,6215,6217,6221,6223,6227,6229,6235,6237,6243],{"#text":6168},"Flavonoid and limonoid profiles of the genotypes in this study were obtained by widely targeted LC-MS/MS analysis. Across the genotypes, there was some variation in the non-volatile profiles (",{"xref":6170,":@":6175},[6171],{"bold":6172},[6173],{"#text":6174},"Figure 3",{"@_ref-type":5382,"@_rid":6176},"f3",{"#text":6178},") for the identified compounds, which included forty-seven flavonoids, seven limonoids, four coumarins, one phenolic ester, one phenylamine, and one fat-soluble vitamin (Vitamin E) (",{"xref":6180,":@":6184},[6181],{"bold":6182},[6183],{"#text":1647},{"@_ref-type":1649,"@_rid":1650},{"#text":6186},"). Desirable sensory descriptors, orange flavor, mandarin flavor, and sweetness characterized the negative axis of PC1 while less desirable descriptors characterized the positive axis. Many different flavonoid and limonoid compounds correlated with orange and mandarin flavors (",{"xref":6188,":@":6192},[6189],{"bold":6190},[6191],{"#text":6174},{"@_ref-type":5382,"@_rid":6176},{"#text":6194},"). Of note, eriocitrin and a rarely reported compound, quercetin 3-(3R-glucosylrutinoside) (",{"xref":6196,":@":6199},[6197],{"#text":6198},"Sun et al., 2023",{"@_ref-type":1095,"@_rid":6200},"B37",{"#text":6202},"), were the most positively correlated flavonoids with orange flavor (",{"xref":6204,":@":6209},[6205],{"bold":6206},[6207],{"#text":6208},"Supplementary Table S5",{"@_ref-type":1649,"@_rid":1650},{"#text":6211},"). For mandarin flavor, there were significant negative correlations with the abundances of quercetin 3-(3R-glucosylrutinoside), tricin, tricin-5-",{"italic":6213},[6214],{"#text":1230},{"#text":6216},"-glucoside, and apigenin. Mandarin flavor positively correlated with synephrine, a phenylethylamine, and tetramethoxyisoscutellarein, a polymethoxylated flavone. While not targeted in this study, scutellarein, was correlated with bitterness and was previously reported in mandarins (",{"xref":6218,":@":6220},[6219],{"#text":1195},{"@_ref-type":1095,"@_rid":1197},{"#text":6222},"). Bitterness, off-flavor, aftertaste, and grapefruit flavor strongly correlated with each other and with limonin, nomilin, and limonoate A-ring lactone. Limonoate A-ring lactone is difficult to analyze due to its inherent chemical instability and the lack of a commercially available standard. To the authors’ knowledge, this is the first report of LC-MS/MS MRM transitions to identify and quantitate limonoate A-ring lactone. The limonoid glucosides targeted in this study, obacunone glucoside, limonin glucoside, nomilin glucoside, and nomilinic acid glucoside did not correlate with bitterness. Known bitter compounds, naringin, poncirin, obacunone, and neohesperidin were targeted with LC-MS/MS but were not identified in any of the genotypes in this study. Neoponcirin, shown to be correlated with bitterness in mandarins (",{"xref":6224,":@":6226},[6225],{"#text":1195},{"@_ref-type":1095,"@_rid":1197},{"#text":6228},"), correlated with bitterness among the genotypes in this study. FF-1-5-35 and FF-1-85-124 were the most bitter individuals and were localized on the positive side of PC1 (",{"xref":6230,":@":6234},[6231],{"bold":6232},[6233],{"#text":6174},{"@_ref-type":5382,"@_rid":6176},{"#text":6236},"). Along with these two bitter hybrids, FTP-6-32-67 harvested in January 2021 was also on the positive side of PC1. As previously mentioned herein, the juice prematurely harvested in January had a high level of limonin (28.9 mg/L), which dropped to 6.67 mg/L when harvested in the following month (",{"xref":6238,":@":6242},[6239],{"bold":6240},[6241],{"#text":5880},{"@_ref-type":1649,"@_rid":1650},{"#text":1205},{"#text":924},{"fig":6246,":@":6274},[6247,6248,6251,6252,6268,6269,6273],{"#text":918},{"label":6249},[6250],{"#text":6174},{"#text":918},{"caption":6253},[6254,6255,6267],{"#text":1725},{"p":6256},[6257,6259,6262,6263,6266],{"#text":6258},"Biplot of the first two principal components from the principal component analysis (PCA) of sensory attributes (green) and flavonoids/limonoids (black) in genotypes harvested in the 2020-21 and 2021-22 seasons. Mandarin hybrids without ",{"italic":6260},[6261],{"#text":1052},{"#text":5732},{"italic":6264},[6265],{"#text":1052},{"#text":5996},{"#text":918},{"#text":918},{"graphic":6270,":@":6271},[],{"@_mimetype":367,"@_mime-subtype":5743,"@_xlink:href":6272},"fhort-03-1425366-g003.tif",{"#text":924},{"@_id":6176,"@_position":5328},{"#text":924},{"p":6277},[6278,6280,6283,6285,6288,6290,6296,6298,6301,6303,6309,6311,6317,6319,6322,6324,6330,6332,6338,6340,6343,6345,6348,6350,6353,6355,6359,6361,6364,6366,6370,6372,6375,6377,6380,6382,6385,6387,6390,6391,6397],{"#text":6279},"Commercial orange juices and the mandarin hybrids with desirable attributes (Sugar Belle",{"sup":6281},[6282],{"#text":1058},{"#text":6284},", ‘US Superna’, and FF-5-51-2) clustered on the negative side or close to 0 of PC1 characterized by orange flavor, mandarin flavor and sweetness. The remaining mandarins and ",{"italic":6286},[6287],{"#text":1052},{"#text":6289}," hybrids were distributed in the flavonoids/limonoid space. Of note, ‘US SunDragon’ was positioned near the center of the PCA biplot (",{"xref":6291,":@":6295},[6292],{"bold":6293},[6294],{"#text":6174},{"@_ref-type":5382,"@_rid":6176},{"#text":6297},") and lacked high abundances of a number of polymethoxylated flavonoids. The ",{"italic":6299},[6300],{"#text":1052},{"#text":6302}," hybrid FF-1-85-124 was an outlier according to its volatile profile (",{"xref":6304,":@":6308},[6305],{"bold":6306},[6307],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":6310},") as well as according to its flavonoid and limonoid profiles (",{"xref":6312,":@":6316},[6313],{"bold":6314},[6315],{"#text":6174},{"@_ref-type":5382,"@_rid":6176},{"#text":6318},"). This hybrid had the highest abundances of nomilin, quercetin, hesperetin-7-galactoside and the coumarins, osthole, meranzin, and isomeranzin. FF-1-85-124 also had significantly lower abundances of the polymethoxylated flavonoids, tetramethoxyisoscutellarein, tetramethoxyscutellarein, sinensetin, isosinensetin, tangeretin, and nobiletin, than the other genotypes in this study. According to its volatile profile, another ",{"italic":6320},[6321],{"#text":1052},{"#text":6323}," hybrid, FF-1-5-213, clustered closer to the mandarins (",{"xref":6325,":@":6329},[6326],{"bold":6327},[6328],{"#text":5905},{"@_ref-type":5382,"@_rid":5907},{"#text":6331},"), but was an outlier according to its flavonoid and limonoid profile (",{"xref":6333,":@":6337},[6334],{"bold":6335},[6336],{"#text":6174},{"@_ref-type":5382,"@_rid":6176},{"#text":6339},"), underscoring the importance of analyzing complete chemical profiles in relation to sensory data for citrus. FF-1-5-213 had the highest abundances of diosmin, nobiletin, a monohydroxy-pentamethoxyflavone, a dihydroxy-pentamethoxyflavone, and limocitrol-3- ",{"italic":6341},[6342],{"#text":1230},{"#text":6344},"-glucoside than the other genotypes in this study. In a previous study, it was suggested that another ",{"italic":6346},[6347],{"#text":1052},{"#text":6349}," hybrid with strong “poncirus” flavor, ‘US 119’ had an aglycone profile similar to that of ",{"italic":6351},[6352],{"#text":981},{"#text":6354},", consisting of mainly isosakuranetin and naringenin and lacking hesperetin (",{"xref":6356,":@":6358},[6357],{"#text":1151},{"@_ref-type":1095,"@_rid":1153},{"#text":6360},"). Among the ",{"italic":6362},[6363],{"#text":1052},{"#text":6365}," hybrids in this study, FF-1-5-213 and ‘US SunDragon’ had lower abundances of isosakuranetin while FF-1-85-124 had a higher abundance. Similar to ‘US 119’ (",{"xref":6367,":@":6369},[6368],{"#text":1151},{"@_ref-type":1095,"@_rid":1153},{"#text":6371},"), naringenin was relatively higher in hybrids with “poncirus” off-flavors, FF-1-85-124 and FF-1-5-213. Interestingly, ‘US SunDragon’ had a lower abundance of the aglycone naringenin, but a higher abundance of its glycoside, narirutin (naringenin-7-",{"italic":6373},[6374],{"#text":1230},{"#text":6376},"-rutinoside), in relation to the other genotypes. Although the acacetin aglycone was not targeted in this study, FF-1-85-124 and FF-1-5-213 had the highest abundances of linarin (acacetin-7-",{"italic":6378},[6379],{"#text":1230},{"#text":6381},"-rutinoside) and this compound was negatively correlated with sweetness and positively correlated with sourness. The high abundances of linarin could be due to the ",{"italic":6383},[6384],{"#text":1052},{"#text":6386}," in their backgrounds, as it was reported to be highly abundant in ",{"italic":6388},[6389],{"#text":981},{"#text":6082},{"xref":6392,":@":6395},[6393],{"#text":6394},"Mou et al., 2021",{"@_ref-type":1095,"@_rid":6396},"B26",{"#text":1205},{"#text":924},{"p":6400},[6401,6403,6410,6412,6415,6417,6423,6425,6428,6430,6433],{"#text":6402},"The aglycone quercetin and its glycosides (quercitrin, rutin, and quercetin-3-(3R-glucosylrutinoside)) (chemically defined in ",{"xref":6404,":@":6409},[6405],{"bold":6406},[6407],{"#text":6408},"Supplementary Table S6",{"@_ref-type":1649,"@_rid":1650},{"#text":6411},") differentiated the ",{"italic":6413},[6414],{"#text":1052},{"#text":6416}," hybrids in this study. FF-1-85-124 had an extremely high abundance of quercetin compared to FF-1-5-213 and ‘US SunDragon’. Quercetin positively correlated with grapefruit and off-flavor ratings and negatively correlated with sweetness (",{"xref":6418,":@":6422},[6419],{"bold":6420},[6421],{"#text":6208},{"@_ref-type":1649,"@_rid":1650},{"#text":6424},"). Quercetin glycosides, quercitrin and rutin, were less abundant in F-1-85-124, and more abundant in the ",{"italic":6426},[6427],{"#text":1052},{"#text":6429}," hybrids with higher citrus (orange and mandarin) flavors, FF-1-5-213 and ‘US SunDragon’. In a future study, it would be interesting to determine if FF-1-85-124 lacks the glycosyl transferase responsible for the biosynthesis of quercitrin and rutin, leading to the accumulation of quercetin. As previously stated herein, quercetin-3-(3R-glucosylrutinoside) was positively correlated with orange flavor and ‘US SunDragon’ has the highest abundance of this quercetin glycoside of the ",{"italic":6431},[6432],{"#text":1052},{"#text":6434}," hybrids.",{"#text":1073},{"@_id":6437},"s3_3",{"#text":1073},{"sec":6440,":@":6633},[6441,6442,6446,6447,6483,6484,6516,6517,6597,6598,6632],{"#text":1390},{"title":6443},[6444],{"#text":6445},"3.4 Delayed bitterness",{"#text":924},{"p":6448},[6449,6451,6459,6461,6468,6470,6473,6475,6482],{"#text":6450},"It was observed that some genotypes in this study had a noticeable increase in bitterness from when the fruit were harvested to when the juice was served in the sensory panels. During this time, the juice was stored at -20°C. It was hypothesized that some enzymatic activity was still ongoing at -20°C but not at -80°C. Therefore, a widely targeted LC-MS/MS analysis was performed on juice samples stored at -20°C and -80°C to understand how flavonoid and limonoid levels change and contribute to this delayed bitterness, assuming enzymatic activity is highly reduced at -80°C. In 2-way hierarchical clustering analysis, the genotypes from the 2021-2022 season are on the y-axis while flavonoids and limonoids are on the x-axis (",{"xref":6452,":@":6457},[6453],{"bold":6454},[6455],{"#text":6456},"Figure 4",{"@_ref-type":5382,"@_rid":6458},"f4",{"#text":6460},"). Each genotype clustered with itself, regardless of storage temperature. Overall, flavonoids increased and decreased with some trends, but there was high variability. The well-studied bitter limonoids, limonin and nomilin, increased 15- 220% and 8- 203%, respectively, across all hybrids during storage at -20°C (",{"xref":6462,":@":6467},[6463],{"bold":6464},[6465],{"#text":6466},"Supplementary Table S7",{"@_ref-type":1649,"@_rid":1650},{"#text":6469},"). Interestingly, these bitter limonoids did not increase in Sugar Belle",{"sup":6471},[6472],{"#text":1058},{"#text":6474}," juice, which did not develop bitterness in storage. To a lesser extent, nomilin glucoside decreased and nomilinic acid glucoside increased in all the genotypes in this study (",{"xref":6476,":@":6481},[6477],{"bold":6478},[6479],{"#text":6480},"Supplementary Table S8",{"@_ref-type":1649,"@_rid":1650},{"#text":1205},{"#text":924},{"fig":6485,":@":6515},[6486,6487,6490,6491,6509,6510,6514],{"#text":918},{"label":6488},[6489],{"#text":6456},{"#text":918},{"caption":6492},[6493,6494,6508],{"#text":1725},{"p":6495},[6496,6498,6501,6503,6506],{"#text":6497},"Hierarchical clustering (2-way) of the flavonoids and limonoids in juice stored at -80°C and -20°C. Mandarin hybrids without ",{"italic":6499},[6500],{"#text":1052},{"#text":6502}," introgression (red), orange varieties (orange), and ",{"italic":6504},[6505],{"#text":1052},{"#text":6507}," hybrids (purple) are on the y-axis and relative flavonoids and limonoids are on the x-axis. Darker red color indicates higher abundance of each compound and darker blue color indicates lower abundance.",{"#text":918},{"#text":918},{"graphic":6511,":@":6512},[],{"@_mimetype":367,"@_mime-subtype":5743,"@_xlink:href":6513},"fhort-03-1425366-g004.tif",{"#text":924},{"@_id":6458,"@_position":5328},{"#text":924},{"p":6518},[6519,6521,6527,6529,6532,6534,6538,6540,6546,6548,6552,6554,6560,6561,6567,6569,6575,6577,6581,6583,6589,6591,6595],{"#text":6520},"The mandarin hybrids, FF-5-6-36 and FTP-6-32-67 were identified as having the most noticeable increases in bitterness from harvest to taste panel analysis. These two had significant increases in naringenin, an aglycone known to be the tasteless precursor of the bitter glycoside, naringin (",{"xref":6522,":@":6525},[6523],{"#text":6524},"Sinclair, 1972",{"@_ref-type":1095,"@_rid":6526},"B34",{"#text":6528},"). Naringin (Naringenin 7-",{"italic":6530},[6531],{"#text":1230},{"#text":6533},"-neohesperidoside) is present in grapefruit and has been shown to be responsible for primary bitterness (",{"xref":6535,":@":6537},[6536],{"#text":6524},{"@_ref-type":1095,"@_rid":6526},{"#text":6539},"). It would be interesting to study if the activated precursors (p-coumaroyl-CoA and malonyl-CoA) (",{"xref":6541,":@":6544},[6542],{"#text":6543},"Martin and Liras, 2022",{"@_ref-type":1095,"@_rid":6545},"B23",{"#text":6547},") were enzymatically being converted to naringenin upon -20°C storage, or if when the fruit tissue was disrupted during juicing, non-enzymatic de-glycosylation of naringenin glycosides occurred. There was a measured increase in another naringenin glycoside, prunin (Naringenin-7-glucoside) (",{"xref":6549,":@":6551},[6550],{"#text":1241},{"@_ref-type":1095,"@_rid":1243},{"#text":6553},"), in these two hybrids (",{"xref":6555,":@":6559},[6556],{"bold":6557},[6558],{"#text":6466},{"@_ref-type":1649,"@_rid":1650},{"#text":1176},{"xref":6562,":@":6566},[6563],{"bold":6564},[6565],{"#text":6456},{"@_ref-type":5382,"@_rid":6458},{"#text":6568},"); however, it is likely that another naringenin glycoside not identified in this study could be present in the samples and contributing to bitterness since prunin was reported to be 33% as bitter as naringin (",{"xref":6570,":@":6573},[6571],{"#text":6572},"Puri et al., 1996",{"@_ref-type":1095,"@_rid":6574},"B30",{"#text":6576},"). Untargeted LC/MS analysis of flavonoids could help identify other not previously known compounds. Tricin-",{"italic":6578},[6579],{"#text":6580},"C",{"#text":6582},"-hexoside, had the most drastic increases from -20°C storage with increases being 48-1,088% across the genotypes, except for FF-1-85-124, in which the compound was not present. Of note, tricin, a polymethoxylated flavone, increased 275% in FTP-6-32-67. Tricin and tricin glycosides are rarely reported in citrus and could play a major role in delayed bitterness, but further research should be performed to validate these findings as there is no data on the taste of these compounds (",{"xref":6584,":@":6587},[6585],{"#text":6586},"Li et al., 2016",{"@_ref-type":1095,"@_rid":6588},"B20",{"#text":6590},"). In a study of healthy versus HLB-affected orange juice, nonvolatile fractions of HLB-affected orange juice were described as bitter. Except for one fraction containing limonoids and polymethoxylated flavones, most compounds were derivatives of hydroxycinnamates (",{"xref":6592,":@":6594},[6593],{"#text":5443},{"@_ref-type":1095,"@_rid":5445},{"#text":6596},"). Further research with more bitter juice should be done to identify specific compounds or groups of compounds, other than limonin and nomilin, contributing to bitterness in citrus juices.",{"#text":924},{"p":6599},[6600,6602,6605,6607,6610,6612,6616,6618,6621,6623,6626,6627,6630],{"#text":6601},"In summary, a selection of oranges, mandarin hybrids, and ",{"italic":6603},[6604],{"#text":1052},{"#text":6606}," hybrids were comprehensively analyzed for volatiles, flavonoids, limonoids, SSC, TA, and compared with sensory analysis from a trained panel. The flavors of the genotypes in this study ranged from juice that was highly rated in citrus flavors to juice with “poncirus”-like and bitter off-flavors. An important part of understanding acceptable flavors for citrus juice is also to determine which chemical components are contributing to off-flavors and bitterness. From this two-year study, PCA biplots revealed that the juices of the same genotype had similar sensory and chemical profiles between the two harvest years. Of note, along with the commercial cultivars, HLB-tolerant ‘US SunDragon,’ Sugar Belle",{"sup":6608},[6609],{"#text":1058},{"#text":6611},", FF-5-51-2, and ‘US Superna’ had acceptable citrus flavor quality, similar to commercial oranges or mandarins. FF-1-5-213, FF-1-84-2, FF-1-85-124, FF-1-5-35 had “poncirus” off-flavors. Volatiles (esters and some sesquiterpenes) along with flavonoids (eriocitrin and quercetin-3-(3R-glucosylrutinoside) were positively correlated with orange flavor while β-ionone and eucalyptol were highly abundant in the mandarins. Previously, “poncirus” flavor was reported to be due to sesquiterpene hydrocarbons, monoterpenes, and terpene esters (",{"xref":6613,":@":6615},[6614],{"#text":1143},{"@_ref-type":1095,"@_rid":1145},{"#text":6617},"). From this study, some flavonoids were shown to positively correlate with “poncirus’ off-flavors as well. FF-1-85-124, a ",{"italic":6619},[6620],{"#text":1052},{"#text":6622}," hybrid with strong off-flavors and bitterness, had significantly higher abundances of hesperetin-7-galactoside and the coumarins, osthole, meranzin, and isomeranzin. The flavonoid linarin, was more abundant in ",{"italic":6624},[6625],{"#text":1052},{"#text":1065},{"italic":6628},[6629],{"#text":1052},{"#text":6631}," hybrid ‘US SunDragon’, having high orange flavor. Two mandarin hybrids, FF-5-6-36 and FTP-6-32-67, had decent citrus flavor at harvest, but exhibited delayed bitterness with storage at -20°C, suggesting they should not be used for commercial juice processing, but only as fresh fruit. Some flavonoids and limonoids increased significantly in the stored juice, but further research with more bitter juice would be useful to identify other compounds contributing to bitterness in citrus.",{"#text":1073},{"@_id":6634},"s3_4",{"#text":1076},{"@_id":6637,"@_sec-type":6638},"s3","results",{"#text":6640},"\n  ",[],[6643,6657,6670,6683,6696,6709,6723,6737,6751,6776],{"title":6644,"order":371,"content":6645,"anchorId":6656},"Author’s note",[6646,6647,6650,6651,6655],{"#text":1073},{"title":6648},[6649],{"#text":6644},{"#text":1073},{"p":6652},[6653],{"#text":6654},"Mention of trade names or commercial products in this publication is solely for the purpose of providing specific information and does not imply recommendation or endorsement by the U.S. Department of Agriculture. The U.S. Department of Agriculture prohibits discrimination in all its programs and activities on the basis of race, color, national origin, age, disability, and where applicable, sex, marital status, familial status, parental status, religion, sexual orientation, genetic information, political beliefs, reprisal, or because all or part of an individual’s income is derived from any public assistance program. (Not all prohibited bases apply to all programs.) Persons with disabilities who require alternative means for communication of program information (Braille, large print, audiotape, etc.) should contact USDA’s TARGET Center at (202) 720-2600 (voice and TDD). To file a complaint of discrimination, write to USDA, Director, Office of Civil Rights, 1400 Independence Avenue, S.W., Washington, D.C. 20250-9410, or call (800) 795-3272 (voice) or (202) 720-6382 (TDD). USDA is an equal opportunity provider and employer.",{"#text":1076},"s4",{"title":6658,"order":374,"content":6659},"Data availability statement",[6660,6661,6664,6665,6669],{"#text":1073},{"title":6662},[6663],{"#text":6658},{"#text":1073},{"p":6666},[6667],{"#text":6668},"The raw data supporting the conclusions of this article will be made available by the authors, without undue reservation.",{"#text":1076},{"title":6671,"order":673,"content":6672},"Ethics statement",[6673,6674,6677,6678,6682],{"#text":1073},{"title":6675},[6676],{"#text":6671},{"#text":1073},{"p":6679},[6680],{"#text":6681},"Ethical approval was not required for the studies involving humans because This study was conducted within the guidelines of the human subject exemption as stated in 45 CFR 46.104 (d)(6). The studies were conducted in accordance with the local legislation and institutional requirements. Written informed consent for participation was not required from the participants or the participants’ legal guardians/next of kin in accordance with the national legislation and institutional requirements because Participation in tasting orange juice was voluntary.",{"#text":1076},{"title":6684,"order":415,"content":6685},"Author contributions",[6686,6687,6690,6691,6695],{"#text":1073},{"title":6688},[6689],{"#text":6684},{"#text":1073},{"p":6692},[6693],{"#text":6694},"KJ: Conceptualization, Data curation, Formal analysis, Investigation, Methodology, Validation, Visualization, Writing – original draft, Writing – review & editing. ZF: Conceptualization, Data curation, Formal analysis, Investigation, Methodology, Validation, Visualization, Writing – review & editing. XS: Data curation, Investigation, Writing – review & editing. GO: Investigation, Writing – review & editing. WZ: Investigation, Writing – review & editing. MM: Investigation, Resources, Writing – review & editing. ES: Conceptualization, Funding acquisition, Project administration, Resources, Writing – review & editing. EB: Conceptualization, Funding acquisition, Methodology, Project administration, Resources, Supervision, Writing – review & editing. JM: Investigation, Resources, Writing – review & editing. AB: Resources, Writing – review & editing. JB: Conceptualization, Data curation, Formal analysis, Funding acquisition, Investigation, Methodology, Project administration, Resources, Supervision, Validation, Visualization, Writing – review & editing. AP: Conceptualization, Data curation, Formal analysis, Investigation, Methodology, Resources, Validation, Visualization, Writing – review & editing, Supervision.",{"#text":1076},{"title":6697,"order":522,"content":6698},"Funding",[6699,6700,6703,6704,6708],{"#text":1073},{"title":6701},[6702],{"#text":6697},{"#text":1073},{"p":6705},[6706],{"#text":6707},"The author(s) declare that financial support was received for theresearch, authorship, and/or publication of this article. This work is supported by the USDA National Institute of Food and Agriculture grant number 2018–70016-27453.",{"#text":1076},{"title":6710,"order":6711,"content":6712},"Acknowledgments",6,[6713,6714,6717,6718,6722],{"#text":1073},{"title":6715},[6716],{"#text":6710},{"#text":1073},{"p":6719},[6720],{"#text":6721},"The authors would like to thank sensory panelists for their participation, the Florida Department of Citrus for providing analyte standards for LC-MS/MS analysis, Nancy Owens for GC/MS analysis, and Holly Sisson and David Wood for their help with sugar and acid analyses.",{"#text":1076},{"title":6724,"order":6725,"content":6726},"Conflict of interest",8,[6727,6728,6731,6732,6736],{"#text":1073},{"title":6729},[6730],{"#text":6724},{"#text":1073},{"p":6733},[6734],{"#text":6735},"The authors declare that the research was conducted in the absence of any commercial or financial relationships that could be construed as a potential conflict of interest.",{"#text":1076},{"title":6738,"order":6739,"content":6740},"Publisher’s note",11,[6741,6742,6745,6746,6750],{"#text":1073},{"title":6743},[6744],{"#text":6738},{"#text":1073},{"p":6747},[6748],{"#text":6749},"All claims expressed in this article are solely those of the authors and do not necessarily represent those of their affiliated organizations, or those of the publisher, the editors and the reviewers. Any product that may be evaluated in this article, or claim that may be made by its manufacturer, is not guaranteed or endorsed by the publisher.",{"#text":1076},{"title":6752,"order":6753,"content":6754},"Supplementary material",14,[6755,6756,6759,6760,6769,6770,6775],{"#text":1073},{"title":6757},[6758],{"#text":6752},{"#text":1073},{"p":6761},[6762,6764],{"#text":6763},"The Supplementary Material for this article can be found online at: ",{"ext-link":6765,":@":6768},[6766],{"#text":6767},"https://www.frontiersin.org/articles/10.3389/fhort.2024.1425366/full#supplementary-material",{"@_ext-link-type":965,"@_xmlns:xlink":1498,"@_xlink:href":6767},{"#text":1073},{"supplementary-material":6771,":@":6772},[],{"@_xlink:href":6773,"@_id":1650,"@_mimetype":6774},"DataS