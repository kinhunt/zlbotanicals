><sup class="u-js-hide"> <a href="#nAff2">nAff2</a></sup>, </li><li class="c-article-author-list__item c-article-author-list__item--hide-small-screen"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="5_6" data-track-context="researcher popup with no profile" href="#auth-Paola-Pittia-Aff2" data-author-popup="auth-Paola-Pittia-Aff2" data-track-label="Paola Pittia" data-author-search="Pittia, Paola">Paola Pittia</a><sup class="u-js-hide"></sup><sup class="u-js-hide"> <a href="#nAff2">nAff2</a></sup> &amp; </li><li class="c-article-author-list__show-more" aria-label="Show all 6 authors for this article" title="Show all 6 authors for this article">…</li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="6_6" data-track-context="researcher popup with no profile" href="#auth-Nata_a-Poklar_Ulrih-Aff1-Aff3" data-author-popup="auth-Nata_a-Poklar_Ulrih-Aff1-Aff3" data-track-label="Nataša Poklar Ulrih" data-author-search="Poklar Ulrih, Nataša" data-corresp-id="c1">Nataša Poklar Ulrih<svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-mail-medium"></use></svg></a><sup class="u-js-hide"><a href="#Aff1">1</a>,<a href="#Aff3">3</a></sup> </li></ul><button aria-expanded="false" class="c-article-author-list__button"><svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-chevron-down-medium"></use></svg><span>Show authors</span></button>
                        
    


