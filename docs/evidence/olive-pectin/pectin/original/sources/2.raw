streith-fox.de/wp-content/uploads/2025/09/Terms_and_Conditions_Herbstreith_Fox_E.pdf" title="https://www.herbstreith-fox.de//wp-content/uploads/2022/03/220234_AGB_Maerz_2022_Nbg.pdf">General Terms &#038; Conditions</a></li><li id="menu-item-25382" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-25382"><a href="https://www.herbstreith-fox.de/en/contact/#newsletter">Newsletter</a></li></ul></div></nav></div><div class="col col-12 col-lg-4 nopaddingsides copyright-wrap"> <span class="copyright">&copy; 2026 Herbstreith & Fox GmbH & Co. KG</span></div></div></div></footer></div><div id="top-link" aria-hidden="true"></div><div id="um_upload_single" style="display:none;"></div><div id="um_view_photo" style="display:none;"> <a href="javascript:void(0);" data-action="um_remove_modal" class="um-modal-close" aria-label="Close view photo modal"> <i class="um-faicon-times"></i> </a><div class="um-modal-body photo"><div class="um-modal-photo"></div></div></div> <script type="speculationrules">{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/en/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/bgtoolbox/*","/en/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"conservative"}]}</script> <script>function addEvent(event, selector, callback, context) {
