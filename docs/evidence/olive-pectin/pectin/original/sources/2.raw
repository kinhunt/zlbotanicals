/news/">News</a></li><li id="menu-item-302" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-302"><a href="https://www.herbstreith-fox.de/en/contact/">Contact</a><ul class="sub-menu"><li id="menu-item-17385" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-17385"><a href="/en/contact#production-sites">Production sites</a></li><li id="menu-item-18703" class="menu-item menu-item-type-custom menu-item-object-custom menu-item-18703"><a href="/en/contact#newsletter">Newsletter</a></li></ul></li><li id="menu-item-17354" class="menu-item-login menu-item-has-children mobile-off menu-item menu-item-type-custom menu-item-object-custom menu-item-17354"><a href="#"><i class="fas fa-user"></i>Log In</a><ul class="sub-menu sub-menu-login"><li class="menu-item"><h3 class="regular">Log In</h3><div class="lwa lwa-default"><form class="lwa-form" action="https://www.herbstreith-fox.de/en/herbslogin/?template=default" method="post"><div> <span class="lwa-status"></span> <input type="text" name="log" placeholder="Username" /> <input type="password" name="pwd" placeholder="Password" /> <input type="hidden" name="lang" id="lang" value="en" /> <input type="submit" name="wp-submit" id="lwa_wp-submit" value="Log In" tabindex="100" /> <input type="hidden" name="lwa_profile_link" value="1" /> <input type="hidden" name="login-with-ajax" value="login" /><div class="forgot"><p>Forgotten your password?</p> <a class="lwa-links-remember" href="https://www.herbstreith-fox.de/en/herbslogin/?action=lostpassword&#038;template=default" title="Password Lost and Found">Reset password</a></div></div></form><form class="lwa-remember" action="https://www.herbstreith-fox.de/en/herbslogin/?action=lostpassword&#038;template=default" method="post" style="display:none;"><div> <span class="lwa-status"></span><table><tr><td> <strong>Forgotten Password</strong></td></tr><tr><td class="lwa-remember-email"> <input type="text" name="user_login" class="lwa-user-remember" value="Enter username or email" onfocus="if(this.value == 'Enter username or email'){this.value = '';}" onblur="if(this.value == ''){this.value = 'Enter username or email'}" /> <input type="hidden" name="lang" id="lang" value="en" /></td></tr><tr><td class="lwa-remember-buttons"> <input type="submit" value="Get New Password" class="lwa-button-remember" /> <a href="#" class="lwa-links-remember-cancel">Cancel</a> <input type="hidden" name="login-with-ajax" value="remember" /></td></tr></table></div></form></div></li></ul></li><li id="menu-item-18578" class="mobile-only menu-item menu-item-type-post_type menu-item-object-page menu-item-18578"><a href="https://www.herbstreith-fox.de/en/log-in/">Log In</a></li></ul></div><div class="menu-secondary-menu-en-container"><ul id="secondary-menu" class="menu"><li id="menu-item-236" class="search-toggle icon-link icon-link-search mobile-off menu-item menu-item-type-custom menu-item-object-custom menu-item-236"><a href="#search">Search</a></li><li id="menu-item-wpml-ls-10-de" class="menu-item wpml-ls-slot-10 wpml-ls-item wpml-ls-item-de wpml-ls-menu-item wpml-ls-first-item menu-item-type-wpml_ls_menu_item menu-item-object-wpml_ls_menu_item menu-item-wpml-ls-10-de"><a href="https://www.herbstreith-fox.de/pektine/amid-pektin/" title="Switch to De" aria-label="Switch to De"><span class="wpml-ls-display">De</span></a></li><li id="menu-item-wpml-ls-10-pl" class="menu-item wpml-ls-slot-10 wpml-ls-item wpml-ls-item-pl wpml-ls-menu-item wpml-ls-last-item menu-item-type-wpml_ls_menu_item menu-item-object-wpml_ls_menu_item menu-item-wpml-ls-10-pl"><a href="https://www.herbstreith-fox.de/pl/pektyna/hf-amid-pektyna/" title="Switch to Pl" aria-label="Switch to Pl"><span class="wpml-ls-display">Pl</span></a></li></ul></div><div class="search-wrap mobile-only" id="search-wrap"><form role="search" method="get" id="searchform" class="searchform textalignright" action="https://www.herbstreith-fox.de/en/"><div> <input type="search" id="s" name="s" value="" placeholder="Search term" /> <button class="button" type="submit" id="searchsubmit" >Search</button></div></form></div></nav></div></header><div class="site"><main id="primary" class="site-main"><article id="post-158" class="post-158 page type-page status-publish has-post-thumbnail hentry"><header class="entry-header section-inner"><h1 class="entry-title">H&F Amid Pectin</h1></header><div class="entry-content section-inner"><p class="slim">Technological supplement and alternative</p><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-9d6595d7 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><figure class="wp-block-image size-full"><img fetchpriority="high" decoding="async" width="1000" height="664" src="https://www.herbstreith-fox.de//wp-content/uploads/2022/02/Amid-Pektin.jpg" alt="" class="wp-image-19224" srcset="https://www.herbstreith-fox.de/wp-content/uploads/2022/02/Amid-Pektin.jpg 1000w, https://www.herbstreith-fox.de/wp-content/uploads/2022/02/Amid-Pektin-540x359.jpg 540w, https://www.herbstreith-fox.de/wp-content/uploads/2022/02/Amid-Pektin-320x212.jpg 320w, https://www.herbstreith-fox.de/wp-content/uploads/2022/02/Amid-Pektin-768x510.jpg 768w, https://www.herbstreith-fox.de/wp-content/uploads/2022/02/Amid-Pektin-480x320.jpg 480w" sizes="(max-width: 1000px) 100vw, 1000px" /></figure></div><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><p>The group of H&amp;F Amid pectins complement the range of Classic pectins technologically and expand the application area of pectins.</p><p>H&amp;F Amid pectins are produced by suspending the dried pectin in alcohol and treating it with ammonia. This process modifies a defined number of methyl ester groups into amide groups (amidation).</p><p>The special properties of the H&amp;F Amid pectins result in different gel textures, offer technological benefits in certain areas and make additional functionalities utilisable.</p><p class="bold-color"><strong>Functionalities</strong></p><ul class="wp-block-list"><li>Continuous gels</li><li>Pseudoplastic textures with yield point</li><li>Thermoreversible gels</li><li>Industrial fruit preparations (e.g. for dairy products and bakery products)</li><li>Texture and syneresis reduction in dairy products</li></ul></div></div><p class="bold-color"><strong>Applications</strong></p><ul class="wp-block-list"><li><a href="https://www.herbstreith-fox.de//en/applications/jams-fruit-spreads/">Fruit spreads, jams, marmalades and jellies</a></li><li><a href="https://www.herbstreith-fox.de//en/applications/gelling-sugar-gelling-powder-liquid-gelling-agents/">Household gelling agents</a></li><li><a href="https://www.herbstreith-fox.de//en/applications/confectionery/">Confectionery gum and jelly products</a></li><li><a href="https://www.herbstreith-fox.de//en/applications/dairy-products/">Acidified milk products (e.g. yoghurt) and vegan alternatives</a></li><li><a href="https://www.herbstreith-fox.de//en/applications/fruit-preparations/">Fruit sauces and toppings</a></li><li><a href="https://www.herbstreith-fox.de//en/applications/delicatessen-products-sauces-and-ketchup/">Delicatessen products</a></li></ul><div style="height:45px" aria-hidden="true" class="wp-block-spacer"></div><div class="wp-block-group bg-beige"><div class="wp-block-group__inner-container is-layout-flow wp-block-group-is-layout-flow"><h2 class="h1 wp-block-heading">Other pectins</h2><section class='section'><h2></h2><div class='teaser-grid grid-4-cols'><div class='grid-item' data-index='1'> <a href='https://www.herbstreith-fox.de/en/pectins/classic-pectin/'><h3 class='entry-title h1'>H&#038;F Classic Pectin</h3><p>Universal diversity and standardization</p> </a></div><div class='grid-item' data-index='2'> <a href='https://www.herbstreith-fox.de/en/pectins/instant-pectin/'><h3 class='entry-title h1'>H&#038;F Instant Pectin</h3><p>Technologically optimized pectins</p> </a></div><div class='grid-item' data-index='3'> <a href='https://www.herbstreith-fox.de/en/pectins/combi-pectin/'><h3 class='entry-title h1'>H&#038;F Combi Pectin</h3><p>Pectins for very specific applications</p> </a></div></div></section></div></div><div class="wp-block-group bg-yellow"><div class="wp-block-group__inner-container is-layout-flow wp-block-group-is-layout-flow"><h2 class="has-text-align-center h1 icon-hand wp-block-heading">Advice on pectins and their applications</h2><p class="has-text-align-center">Do you have any questions or would you like to make use of our personal consulting service?<br>We would be happy to give you advice and inform you in detail – just send us a message!</p><div class="wp-block-buttons vspace aligncenter is-horizontal is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-499968f5 wp-block-buttons-is-layout-flex"><div class="wp-block-button"><a class="wp-block-button__link" href="https://www.herbstreith-fox.de//en/contact/">Contact</a></div><div class="wp-block-button clicktocallback"><a class="wp-block-button__link" href="/en/contact/#callback">Click To Callback</a></div></div></div></div></div></article></main></div><footer id="colophon" class="site-footer"><div class="section-inner"><div class="bottom-bar menu-bar"><div class="col col-12 col-md-6 nopaddingsides"><nav id="footer-navigation" class="menu-bar-navigation"><div class="menu-footer-social-en-container"><ul id="footer-social" class="menu"><li id="menu-item-20428" class="margin-right menu-item menu-item-type-custom menu-item-object-custom menu-item-20428"><a target="_blank" href="https://www.h-f.group/karriere/">Career portal H&#038;F Group</a></li><li id="menu-item-20429" class="sm-link sm-link-linkedin menu-item menu-item-type-custom menu-item-object-custom menu-item-20429"><a target="_blank" href="https://de.linkedin.com/company/herbstreith-fox">LinkedIn</a></li><li id="menu-item-20430" class="sm-link sm-link-xing me