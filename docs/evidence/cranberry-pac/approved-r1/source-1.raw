    <div class="usa-width-three-fourths usa-layout-docs-main_content">
                    <b>Research Project: </b>
                    <a href="/research/project/?accnNo=445356">
                        Farm to Table Factors: Impact of Production, Processing, and Preparation on Food Composition

   <!--Research Project Name-->
                    </a>
                    <p>
                        <b>
                            Location:
                                <a href="/northeast-area/beltsville-md-bhnrc/beltsville-human-nutrition-research-center/methods-and-application-of-food-composition-laboratory/">Methods and Application of Food Composition Laboratory</a>
                        </b>
                    </p>
                <b>Title:</b> Analytical determination of proanthocyanidin (PAC) content and its association with label-declared PAC amounts and cranberry material in dietary supplements: A multi-lab study using the 4-dimenthylamino-cinnamaldehyde method                <br /><br />
                   <b>Author</b><br>
                    <div align="left">
                        <table cellspacing="0" cellpadding="3">
                            <tbody>
                                        <tr>
                                            <td valign="top" width="20px"><img src="/ARSUserFiles/incme/images/bullet.gif" border="0" alt="item"></td>
                                            <td valign="top" align="left" background="/ARSUserFiles/incme/images/spacer.gif">

PANDEY, DEEPESH - University Of Maryland
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="top" width="20px"><img src="/ARSUserFiles/incme/images/bullet.gif" border="0" alt="item"></td>
                                            <td valign="top" align="left" background="/ARSUserFiles/incme/images/spacer.gif">

VAVILALA, SUMA - University Of Maryland
                                            </td>
                                        </tr>
                                        <tr>
