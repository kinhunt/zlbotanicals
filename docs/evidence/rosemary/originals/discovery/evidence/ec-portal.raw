@media screen {
  :root {
    --duet-color-button:var(--c-g-50,var(--c-p-5));
    --duet-font:Inter,arial,sans-serif;
    --duet-font-bold:600;
    --duet-color-surface:var(--cm-surface-inverted,#fff);
    --duet-color-border:var(--cm-border-grey-medium);
    --duet-color-text:var(--cm-on-surface-brand);
    --duet-color-primary:var(--cm-border-primary);
    --duet-font-normal:400;
    --duet-radius:4px;
    --duet-color-placeholder:var(--cm-on-surface-grey-medium);
    --duet-z-index:15;
  }
}
