@media print {
  html {
    font-family:
      Inter,
      verdana,
      sans-serif;
  }
}
html {
  -webkit-text-size-adjust: 100%;
}
@font-face {
  font-display: block;
  font-family: Inter;
  font-style: normal;
  font-weight: 100 900;
  src: url("./media/InterVariable-AM3KRH5U.woff2") format("woff2");
}
@font-face {
  font-display: block;
  font-family: Inter;
  font-style: italic;
  font-weight: 100 900;
  src: url("./media/InterVariable-Italic-ZENN32PX.woff2") format("woff2");
}
