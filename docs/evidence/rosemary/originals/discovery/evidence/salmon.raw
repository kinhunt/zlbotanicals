</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">42</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">13.80</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
