</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">13.70</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">1.593</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
