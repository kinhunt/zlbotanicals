</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">42</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">6.05</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
